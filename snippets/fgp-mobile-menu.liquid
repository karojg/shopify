{% assign fgp_nav = linklists['main-menu'] %}

<!-- FGP Mobile Slide Menu -->
<div id="fgp-mob" class="fgp-mob" aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ 'fgp.aria.site_navigation' | t }}">
  <div class="fgp-mob__backdrop" id="fgp-mob-backdrop"></div>
  <div class="fgp-mob__panel">
    <div class="fgp-mob__head">
      {%- if settings.logo != blank -%}
        <img class="fgp-mob__logo" src="{{ settings.logo | img_url: '300x' }}" alt="{{ shop.name }}" width="120" height="auto">
      {%- else -%}
        <span class="fgp-mob__shop-name">{{ shop.name }}</span>
      {%- endif -%}
      <button class="fgp-mob__close" id="fgp-mob-close" aria-label="{{ 'fgp.aria.close_menu' | t }}">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
          <path d="M1.5 1.5L16.5 16.5M16.5 1.5L1.5 16.5" stroke="white" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <nav class="fgp-mob__nav">
      {% if fgp_nav.links.size > 0 %}
        {% for link in fgp_nav.links %}
          <a href="{{ link.url }}" class="fgp-mob__link{% if link.active %} fgp-mob__link--active{% endif %}">{{ link.title }}</a>
        {% endfor %}
      {% else %}
        <a href="{{ routes.root_url }}" class="fgp-mob__link">{{ 'fgp.menu.home' | t }}</a>
        <a href="/collections" class="fgp-mob__link">{{ 'fgp.menu.formulations' | t }}</a>
        <a href="/pages/science-behind-it" class="fgp-mob__link">{{ 'fgp.menu.science' | t }}</a>
        <a href="/pages/about-us" class="fgp-mob__link">{{ 'fgp.menu.about' | t }}</a>
      {% endif %}
    </nav>

    <div class="fgp-mob__footer">
      <form action="{{ routes.search_url }}" method="get" class="fgp-mob__search">
        <input type="search" name="q" placeholder="{{ 'fgp.menu.search_placeholder' | t }}" class="fgp-mob__search-input" autocomplete="off">
        <button type="submit" class="fgp-mob__search-btn" aria-label="{{ 'fgp.aria.search' | t }}">
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none"><circle cx="8.5" cy="8.5" r="6.5" stroke="white" stroke-width="1.75"/><path d="M13.5 13.5L18 18" stroke="white" stroke-width="1.75" stroke-linecap="round"/></svg>
        </button>
      </form>

      <div class="fgp-mob__icons">
        {%- if shop.customer_accounts_enabled -%}
          <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
             class="fgp-mob__icon-link" rel="nofollow">
            <span class="svg-wrapper">{{ 'icon-account.svg' | inline_asset_content }}</span>
            <span>{%- if customer -%}{{ 'fgp.menu.account' | t }}{%- else -%}{{ 'fgp.menu.log_in' | t }}{%- endif -%}</span>
          </a>
        {%- endif -%}
        <a href="{{ routes.cart_url }}" class="fgp-mob__icon-link">
          {%- if cart == empty -%}
            <span class="svg-wrapper">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>
          {%- else -%}
            <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
          {%- endif -%}
          <span>{{ 'fgp.menu.cart' | t }}{%- if cart.item_count > 0 -%} ({{ cart.item_count }}){%- endif -%}</span>
        </a>
      </div>
    </div>
  </div>
</div>

<style>
/* Trigger — uses Dawn's left-icons grid area on mobile */
.fgp-mob__trigger {
  grid-area: left-icons;
  justify-self: start;
  background: none;
  border: none;
  cursor: pointer;
  display: none;
}

@media (max-width: 749px) {
  .fgp-mob__trigger {
    display: flex;
    color: #ffffff !important;
  }

  .fgp-mob__trigger svg path {
    stroke: #ffffff !important;
  }
}

/* Backdrop */
.fgp-mob__backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 9001;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

/* Panel */
.fgp-mob__panel {
  position: fixed;
  top: 0;
  left: 0;
  width: 75vw;
  max-width: 300px;
  height: 100vh;
  height: 100dvh;
  background: var(--fgp-navy, #234092);
  z-index: 9002;
  transform: translateX(-100%);
  transition: transform 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  padding: 24px 28px 40px;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
}

/* Open state */
.fgp-mob--open .fgp-mob__backdrop {
  opacity: 1;
  pointer-events: auto;
}

.fgp-mob--open .fgp-mob__panel {
  transform: translateX(0);
}

/* Panel header row */
.fgp-mob__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32px;
  min-height: 40px;
}

.fgp-mob__logo {
  width: 110px;
  height: auto;
  display: block;
  filter: brightness(0) invert(1);
}

.fgp-mob__shop-name {
  color: #ffffff;
  font-family: var(--fgp-font, 'Poppins', sans-serif);
  font-size: 16px;
  font-weight: 700;
}

/* Close button */
.fgp-mob__close {
  background: none;
  border: none;
  cursor: pointer;
  padding: 6px;
  line-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  transition: background 0.2s;
}
.fgp-mob__close:hover {
  background: rgba(255,255,255,0.12);
}

/* Nav links */
.fgp-mob__nav {
  display: flex;
  flex-direction: column;
}

.fgp-mob__link {
  color: #ffffff;
  text-decoration: none;
  font-family: var(--fgp-font, 'Poppins', sans-serif);
  font-size: 15px;
  font-weight: 500;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  padding: 18px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.18);
  display: block;
  transition: opacity 0.2s;
}

.fgp-mob__link:first-child {
  border-top: 1px solid rgba(255, 255, 255, 0.18);
}

.fgp-mob__link:hover { opacity: 0.65; }
.fgp-mob__link--active { font-weight: 700; }

/* Footer: search + icons at bottom of panel */
.fgp-mob__footer {
  margin-top: auto;
  padding-top: 24px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.fgp-mob__icons {
  display: flex;
  gap: 20px;
}

.fgp-mob__icon-link {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #fff;
  text-decoration: none;
  font-family: var(--fgp-font, 'Poppins', sans-serif);
  font-size: 14px;
  font-weight: 500;
  opacity: 0.85;
  transition: opacity 0.2s;
}
.fgp-mob__icon-link:hover { opacity: 1; }
.fgp-mob__icon-link .svg-wrapper svg { stroke: #fff; fill: none; width: 20px; height: 20px; }

/* Search form */
.fgp-mob__search {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.12);
  border: 1px solid rgba(255,255,255,0.25);
  border-radius: 200px;
  padding: 10px 14px;
  gap: 10px;
}
.fgp-mob__search-input {
  flex: 1;
  background: none;
  border: none;
  outline: none;
  color: #fff;
  font-family: var(--fgp-font, 'Poppins', sans-serif);
  font-size: 12px;
  padding: 0;
  min-width: 0;
}
.fgp-mob__search-input::placeholder { color: rgba(255,255,255,0.55); }
.fgp-mob__search-btn {
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
</style>

<script>
(function () {
  var mob = document.getElementById('fgp-mob');
  var trigger = document.getElementById('fgp-mob-trigger');
  var closeBtn = document.getElementById('fgp-mob-close');
  var backdrop = document.getElementById('fgp-mob-backdrop');

  if (!mob || !trigger) return;

  function open() {
    mob.classList.add('fgp-mob--open');
    mob.setAttribute('aria-hidden', 'false');
    trigger.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    closeBtn && closeBtn.focus();
  }

  function close() {
    mob.classList.remove('fgp-mob--open');
    mob.setAttribute('aria-hidden', 'true');
    trigger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    trigger.focus();
  }

  trigger.addEventListener('click', open);
  closeBtn && closeBtn.addEventListener('click', close);
  backdrop && backdrop.addEventListener('click', close);

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && mob.classList.contains('fgp-mob--open')) close();
  });
})();
</script>
