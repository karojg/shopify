{% comment %}
  BreadcrumbList structured data.

  Google renders breadcrumbs in place of the bare URL in search results, which
  reads better and gives the page's position in the site hierarchy. The theme
  emits Organization, Product and Article schema already but had no breadcrumbs
  on any template.

  This is schema only — no visible markup — so it can be dropped into any
  template without touching layout. Depth is derived from the routed object,
  since Shopify has no generic breadcrumb API.

  Usage: {% render 'fgp-breadcrumb-schema' %}
{% endcomment %}

{%- liquid
  assign crumbs = ''

  case request.page_type
    when 'product'
      if collection.title != blank
        assign crumbs = collection.title | append: '|' | append: collection.url | append: '||'
      endif
      assign crumbs = crumbs | append: product.title | append: '|' | append: product.url
    when 'collection'
      assign crumbs = collection.title | append: '|' | append: collection.url
    when 'article'
      assign crumbs = blog.title | append: '|' | append: blog.url | append: '||'
      assign crumbs = crumbs | append: article.title | append: '|' | append: article.url
    when 'blog'
      assign crumbs = blog.title | append: '|' | append: blog.url
    when 'page'
      assign crumbs = page.title | append: '|' | append: page.url
    when 'list-collections'
      assign crumbs = 'Collections|' | append: routes.collections_url
    when 'search'
      assign crumbs = 'Search|' | append: routes.search_url
  endcase
-%}

{%- if crumbs != blank -%}
  {%- assign crumb_list = crumbs | split: '||' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ shop.name | json }},
          "item": {{ request.origin | append: routes.root_url | json }}
        }{% for crumb in crumb_list %}{% assign parts = crumb | split: '|' %},
        {
          "@type": "ListItem",
          "position": {{ forloop.index | plus: 1 }},
          "name": {{ parts[0] | json }},
          "item": {{ request.origin | append: parts[1] | json }}
        }{% endfor %}
      ]
    }
  </script>
{%- endif -%}
