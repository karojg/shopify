{% comment %}
  Feel Good Pharma — Store Locator / Puntos de Venta Section

  Page header only. The locations themselves are rendered by the Progus
  Store Locator app block placed directly below this section — this used
  to hold a hand-maintained grid of location cards, dropped once the store
  count outgrew the 12-block schema limit.

  The Progus widget is a cross-origin iframe, so its interior can only be
  styled from the app's own Custom CSS panel, not from here. What this
  section does control is the surrounding page: the shared #f8f8f8 section
  background runs behind both the header and the widget so the map reads as
  a white card floating on it, instead of the two-tone split you get when
  only the header is grey.

  Shopify OS 2.0 Section
{% endcomment %}

{% render 'fgp-global' %}

<section class="fgp-stores" aria-label="Store locations">

  <div class="fgp-stores__header">
    {% if section.settings.eyebrow != blank %}
      <p class="fgp-stores__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h1 class="fgp-stores__heading">{{ section.settings.heading | default: 'Find a store near you' }}</h1>
    {% if section.settings.subtext != blank %}
      <p class="fgp-stores__subtext">{{ section.settings.subtext }}</p>
    {% endif %}
  </div>

</section>

<style>
.fgp-stores {
  --fgp-navy:     #234092;
  --fgp-blue:     #45bfef;
  --fgp-gold:     #fdb921;
  --fgp-offwhite: #f8f8f8;
  --fgp-white:    #ffffff;
  --fgp-font:     'Poppins', sans-serif;

  font-family: var(--fgp-font);
  background: var(--fgp-offwhite);
  padding: 56px 24px 32px;
}

/* Header */
.fgp-stores__header {
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.fgp-stores__eyebrow {
  font-size: 12px;
  font-weight: 700;
  color: var(--fgp-blue);
  letter-spacing: 2px;
  text-transform: uppercase;
  margin: 0;
}

.fgp-stores__heading {
  font-size: 36px;
  font-weight: 800;
  color: var(--fgp-navy);
  margin: 0;
  line-height: 1.2;
}

.fgp-stores__subtext {
  font-size: 15px;
  color: var(--fgp-navy);
  opacity: 0.7;
  margin: 0 auto;
  max-width: 560px;
  line-height: 1.6;
}

/* ── Progus app block wrapper ──
   The app block sits in its own Shopify section immediately after this one
   and ships no padding/background controls in the theme editor, so both are
   set from here. The sibling selector targets that section specifically
   rather than every app section on the site. */
.fgp-store-locator + .shopify-section {
  background: #f8f8f8;
  padding-bottom: 64px;
}

.fgp-store-locator + .shopify-section .shopify-app-block {
  max-width: 1160px;
  margin: 0 auto;
}

/* Mobile */
@media (max-width: 767px) {
  .fgp-stores { padding: 40px 20px 24px; }
  .fgp-stores__heading { font-size: 26px; }

  .fgp-store-locator + .shopify-section { padding-bottom: 40px; }
}
</style>

{% schema %}
{
  "name": "FGP Store Locator",
  "tag": "section",
  "class": "fgp-store-locator",
  "settings": [
    {
      "type": "paragraph",
      "content": "Page header for the Puntos de Venta page. The store list and map come from the Progus Store Locator app block — add it directly below this section."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FIND US"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find a store near you"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext"
    }
  ],
  "presets": [
    {
      "name": "FGP Store Locator"
    }
  ]
}
{% endschema %}
