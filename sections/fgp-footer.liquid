{% render 'fgp-global' %}

<footer class="fgp-ft" aria-label="Site footer">

  <div class="fgp-ft__inner">

    <!-- Logo -->
    <a href="{{ routes.root_url }}" class="fgp-ft__logo-link" aria-label="{{ shop.name }}">
      {% if section.settings.logo != blank %}
        <img
          class="fgp-ft__logo"
          src="{{ section.settings.logo | img_url: '240x' }}"
          alt="{{ shop.name }}"
          loading="lazy"
        >
      {% else %}
        <span class="fgp-ft__logo-text">{{ shop.name }}</span>
      {% endif %}
    </a>

    <!-- 2-column links grid -->
    <nav class="fgp-ft__links" aria-label="Footer navigation">
      {% if section.settings.menu_1 != blank %}
        {% assign menu1 = linklists[section.settings.menu_1] %}
        {% for link in menu1.links %}
          <a href="{{ link.url }}" class="fgp-ft__link">{{ link.title }}</a>
        {% endfor %}
      {% endif %}
      {% if section.settings.menu_2 != blank %}
        {% assign menu2 = linklists[section.settings.menu_2] %}
        {% for link in menu2.links %}
          <a href="{{ link.url }}" class="fgp-ft__link">{{ link.title }}</a>
        {% endfor %}
      {% endif %}
    </nav>

    <!-- Simple newsletter -->
    <div class="fgp-ft__nl">
      <p class="fgp-ft__nl-label">{{ section.settings.nl_heading | default: 'Subscribe to our newsletter' }}</p>
      {% form 'customer', id: 'fgp-ft-nl-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="fgp-ft__nl-row">
          <label for="fgp-ft-email" class="visually-hidden">Email</label>
          <input
            id="fgp-ft-email"
            type="email"
            name="contact[email]"
            class="fgp-ft__nl-input"
            placeholder="{{ section.settings.nl_placeholder | default: 'your@email.com' }}"
            required
            autocomplete="email"
          >
          <button type="submit" class="fgp-ft__nl-btn">
            {{ section.settings.nl_btn | default: 'Join' }}
          </button>
        </div>
        {%- if form.posted_successfully? -%}
          <p class="fgp-ft__nl-success">{{ section.settings.nl_success | default: 'Thanks for subscribing!' }}</p>
        {%- endif -%}
      {% endform %}
    </div>

  </div>

  <!-- Bottom bar -->
  <div class="fgp-ft__bottom">
    <p class="fgp-ft__copyright">{{ section.settings.copyright | default: '© 2026 Feel Good Pharma. All rights reserved.' }}</p>
  </div>

</footer>

<style>
.fgp-ft {
  font-family: var(--fgp-font);
  background: var(--fgp-navy);
  color: var(--fgp-white);
}

.fgp-ft__inner {
  max-width: 900px;
  margin: 0 auto;
  padding: 48px 40px 40px;
  display: flex;
  flex-direction: column;
  gap: 32px;
}

/* Logo */
.fgp-ft__logo-link { display: inline-block; }
.fgp-ft__logo { max-width: 160px; height: auto; display: block; }
.fgp-ft__logo-text { font-size: 22px; font-weight: 800; color: var(--fgp-white); }

/* 2-col links */
.fgp-ft__links {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px 24px;
}

.fgp-ft__link {
  font-size: 14px;
  font-weight: 400;
  color: var(--fgp-white);
  text-decoration: none;
  opacity: 0.85;
  transition: opacity 0.2s;
  line-height: 1.5;
}
.fgp-ft__link:hover { opacity: 1; }

/* Newsletter */
.fgp-ft__nl {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.fgp-ft__nl-label {
  font-size: 14px;
  font-weight: 400;
  color: var(--fgp-white);
  opacity: 0.85;
  margin: 0;
}

.fgp-ft__nl-row {
  display: flex;
  gap: 10px;
  align-items: center;
}

.fgp-ft__nl-input {
  flex: 1;
  background: transparent;
  border: 1.5px solid rgba(255,255,255,0.35);
  border-radius: 8px;
  padding: 12px 16px;
  font-size: 14px;
  font-family: var(--fgp-font);
  color: var(--fgp-white);
  outline: none;
  transition: border-color 0.2s;
}
.fgp-ft__nl-input::placeholder { color: rgba(255,255,255,0.45); }
.fgp-ft__nl-input:focus { border-color: rgba(255,255,255,0.7); }

.fgp-ft__nl-btn {
  background: var(--fgp-blue);
  color: var(--fgp-white);
  border: none;
  border-radius: var(--radius-pill);
  padding: 12px 24px;
  font-size: 14px;
  font-weight: 600;
  font-family: var(--fgp-font);
  cursor: pointer;
  white-space: nowrap;
  transition: opacity 0.2s;
}
.fgp-ft__nl-btn:hover { opacity: 0.88; }

.fgp-ft__nl-success {
  font-size: 13px;
  color: var(--fgp-blue);
  margin: 0;
}

/* Bottom bar */
.fgp-ft__bottom {
  border-top: 1px solid rgba(255,255,255,0.12);
  padding: 20px 40px;
  text-align: center;
}

.fgp-ft__copyright {
  font-size: 12px;
  color: rgba(255,255,255,0.5);
  margin: 0;
}

/* Mobile */
@media (max-width: 767px) {
  .fgp-ft__inner { padding: 36px 20px 32px; gap: 28px; }
  .fgp-ft__bottom { padding: 16px 20px; }
}
</style>

{% schema %}
{
  "name": "FGP Footer",
  "tag": "section",
  "class": "fgp-footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Links — left column",
      "default": "footer"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Links — right column"
    },
    {
      "type": "text",
      "id": "nl_heading",
      "label": "Newsletter label",
      "default": "Subscribe to our newsletter"
    },
    {
      "type": "text",
      "id": "nl_placeholder",
      "label": "Email placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "nl_btn",
      "label": "Button label",
      "default": "Join"
    },
    {
      "type": "text",
      "id": "nl_success",
      "label": "Success message",
      "default": "Thanks for subscribing!"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright text",
      "default": "© 2026 Feel Good Pharma. All rights reserved."
    }
  ],
  "presets": [
    { "name": "FGP Footer" }
  ]
}
{% endschema %}
