{% render 'fgp-global' %}

<footer class="fgp-ft" aria-label="Site footer">

  <div class="fgp-ft__inner">

    <div class="fgp-ft__top">

      <!-- Brand column: logo, address, hours -->
      <div class="fgp-ft__brand">
        <a href="{{ routes.root_url }}" class="fgp-ft__logo-link" aria-label="{{ shop.name }}">
          {% if section.settings.logo != blank %}
            <img
              class="fgp-ft__logo"
              src="{{ section.settings.logo | img_url: '240x' }}"
              alt="{{ shop.name }}"
              loading="lazy"
            >
          {% else %}
            <span class="fgp-ft__logo-text">{{ shop.name }}</span>
          {% endif %}
        </a>

        {% if section.settings.address != blank %}
          <p class="fgp-ft__address">{{ section.settings.address }}</p>
        {% endif %}

        {% if section.settings.hours != blank %}
          <p class="fgp-ft__hours">{{ section.settings.hours }}</p>
        {% endif %}
      </div>

      <!-- Link columns -->
      <div class="fgp-ft__links-col">
        {% if section.settings.menu_1_heading != blank %}
          <h2 class="fgp-ft__col-heading">{{ section.settings.menu_1_heading }}</h2>
        {% endif %}
        {% if section.settings.menu_1 != blank %}
          <ul class="fgp-ft__links">
            {% assign menu1 = linklists[section.settings.menu_1] %}
            {% for link in menu1.links %}
              <li><a href="{{ link.url }}" class="fgp-ft__link">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>

      <div class="fgp-ft__links-col">
        {% if section.settings.menu_2_heading != blank %}
          <h2 class="fgp-ft__col-heading">{{ section.settings.menu_2_heading }}</h2>
        {% endif %}
        {% if section.settings.menu_2 != blank %}
          <ul class="fgp-ft__links">
            {% assign menu2 = linklists[section.settings.menu_2] %}
            {% for link in menu2.links %}
              <li><a href="{{ link.url }}" class="fgp-ft__link">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>

      <!-- Newsletter -->
      <div class="fgp-ft__nl">
        <p class="fgp-ft__nl-label">{% if section.settings.nl_heading != blank %}{{ section.settings.nl_heading }}{% else %}{{ 'fgp.footer.newsletter_heading' | t }}{% endif %}</p>
        {% if section.settings.nl_subtext != blank %}
          <p class="fgp-ft__nl-subtext">{{ section.settings.nl_subtext }}</p>
        {% endif %}
        {% form 'customer', id: 'fgp-ft-nl-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="fgp-ft__nl-row">
            <label for="fgp-ft-email" class="visually-hidden">Email</label>
            <input
              id="fgp-ft-email"
              type="email"
              name="contact[email]"
              class="fgp-ft__nl-input"
              placeholder="{% if section.settings.nl_placeholder != blank %}{{ section.settings.nl_placeholder }}{% else %}{{ 'fgp.footer.newsletter_placeholder' | t }}{% endif %}"
              required
              autocomplete="email"
            >
            <button type="submit" class="fgp-ft__nl-btn" aria-label="{% if section.settings.nl_btn != blank %}{{ section.settings.nl_btn }}{% else %}{{ 'fgp.footer.newsletter_button' | t }}{% endif %}">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
          {% if section.settings.nl_consent != blank %}
            <label class="fgp-ft__nl-consent">
              <input type="checkbox" name="contact[accepts_marketing]" value="1">
              <span>{{ section.settings.nl_consent }}</span>
            </label>
          {% endif %}
          {%- if form.posted_successfully? -%}
            <p class="fgp-ft__nl-success">{% if section.settings.nl_success != blank %}{{ section.settings.nl_success }}{% else %}{{ 'fgp.footer.newsletter_success' | t }}{% endif %}</p>
          {%- endif -%}
        {% endform %}
      </div>

      <!-- Decorative gut illustration -->
      {% if section.settings.decoration_image != blank %}
        <img
          class="fgp-ft__deco"
          src="{{ section.settings.decoration_image | img_url: '200x' }}"
          alt=""
          aria-hidden="true"
          loading="lazy"
        >
      {% endif %}
    </div>

  </div>

  <!-- Bottom bar -->
  <div class="fgp-ft__bottom">
    <div class="fgp-ft__bottom-inner">
      <div class="fgp-ft__localization">
        {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
          <localization-form>
            {%- form 'localization', id: 'FgpFooterLanguageForm', class: 'localization-form' -%}
              {%- render 'language-localization', localPosition: 'FgpFooterLanguage' -%}
            {%- endform -%}
          </localization-form>
        {%- endif -%}

        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
          <localization-form>
            {%- form 'localization', id: 'FgpFooterCountryForm', class: 'localization-form' -%}
              {%- render 'country-localization', localPosition: 'FgpFooterCountry' -%}
            {%- endform -%}
          </localization-form>
        {%- endif -%}
      </div>

      {% if section.settings.show_social %}
        {%- render 'social-icons', class: 'fgp-ft__social' -%}
      {% endif %}

      {% if section.settings.payment_enable %}
        <ul class="fgp-ft__payment" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li class="fgp-ft__payment-item">
              {{ type | payment_type_svg_tag: class: 'fgp-ft__payment-icon' }}
            </li>
          {%- endfor -%}
        </ul>
      {% endif %}
    </div>

    <p class="fgp-ft__copyright">
      {% if section.settings.copyright != blank %}{{ section.settings.copyright }}{% else %}{{ 'fgp.footer.copyright' | t }}{% endif %}
      &middot; {{ powered_by_link }}
    </p>
  </div>

</footer>

<style>
.fgp-ft {
  font-family: var(--fgp-font);
  background: var(--fgp-navy);
  color: var(--fgp-white);
}

.fgp-ft__inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 56px 40px 40px;
}

.fgp-ft__top {
  position: relative;
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr 1.4fr;
  gap: 32px;
  overflow: hidden;
}

/* Brand */
.fgp-ft__logo-link { display: inline-block; margin-bottom: 16px; }
.fgp-ft__logo { max-width: 160px; height: auto; display: block; }
.fgp-ft__logo-text { font-size: 22px; font-weight: 800; color: var(--fgp-white); }

.fgp-ft__address,
.fgp-ft__hours {
  font-size: 13px;
  line-height: 1.6;
  color: rgba(255,255,255,0.75);
  margin: 0 0 8px;
  white-space: pre-line;
}

/* Link columns */
.fgp-ft__col-heading {
  font-size: 14px;
  font-weight: 700;
  color: var(--fgp-white);
  margin: 0 0 14px;
}

.fgp-ft__links {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.fgp-ft__link {
  font-size: 14px;
  font-weight: 400;
  color: var(--fgp-white);
  text-decoration: none;
  opacity: 0.85;
  transition: opacity 0.2s;
}
.fgp-ft__link:hover { opacity: 1; }

/* Newsletter */
.fgp-ft__nl {
  display: flex;
  flex-direction: column;
  gap: 10px;
  position: relative;
  z-index: 1;
}

.fgp-ft__nl-label {
  font-size: 16px;
  font-weight: 700;
  color: var(--fgp-white);
  margin: 0;
}

.fgp-ft__nl-subtext {
  font-size: 13px;
  color: rgba(255,255,255,0.75);
  margin: 0 0 4px;
}

.fgp-ft__nl-row {
  display: flex;
  gap: 8px;
  align-items: center;
}

.fgp-ft__nl-input {
  flex: 1;
  min-width: 0;
  background: var(--fgp-white);
  border: none;
  border-radius: 8px;
  padding: 12px 14px;
  font-size: 13px;
  font-family: var(--fgp-font);
  color: var(--fgp-navy);
  outline: none;
}
.fgp-ft__nl-input::placeholder { color: rgba(35,64,146,0.5); }

.fgp-ft__nl-btn {
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--fgp-blue);
  color: var(--fgp-navy);
  border: none;
  border-radius: 8px;
  cursor: pointer;
  transition: opacity 0.2s;
}
.fgp-ft__nl-btn:hover { opacity: 0.88; }

.fgp-ft__nl-consent {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  font-size: 12px;
  line-height: 1.4;
  color: rgba(255,255,255,0.7);
  cursor: pointer;
  padding-left: 10px;
  padding-top: 8px;
}
.fgp-ft__nl-consent input {
  flex-shrink: 0;
  width: 14px;
  height: 14px;
  margin: 2px 0 0;
}

.fgp-ft__nl-success {
  font-size: 13px;
  color: var(--fgp-blue);
  margin: 0;
}

/* Decorative illustration */
.fgp-ft__deco {
  position: absolute;
  top: -8px;
  right: -20px;
  height: calc(100% + 16px);
  width: auto;
  max-width: none;
  object-fit: contain;
  opacity: 0.9;
  pointer-events: none;
}

/* Bottom bar */
.fgp-ft__bottom {
  border-top: 1px solid rgba(255,255,255,0.15);
  padding: 20px 40px;
  max-width: 1200px;
  margin: 0 auto;
}

.fgp-ft__bottom-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
  margin-bottom: 12px;
}

.fgp-ft__localization {
  display: flex;
  align-items: center;
  gap: 12px;
}

.fgp-ft__localization .localization-form { display: inline-flex; }
.fgp-ft__localization .disclosure__button {
  color: var(--fgp-white);
  font-size: 12px;
}

.fgp-ft__social {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  gap: 8px;
}

.fgp-ft__social .list-social__link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  color: var(--fgp-white);
  transition: background 0.2s;
}
.fgp-ft__social .list-social__link:hover { background: rgba(255,255,255,0.3); }
.fgp-ft__social .list-social__link svg { width: 13px; height: 13px; fill: currentColor; }

.fgp-ft__payment {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.fgp-ft__payment-item { display: flex; }
.fgp-ft__payment-icon { width: 32px; height: auto; }

.fgp-ft__copyright {
  font-size: 12px;
  color: rgba(255,255,255,0.5);
  margin: 0;
}

/* Mobile */
@media (max-width: 767px) {
  .fgp-ft__inner { padding: 40px 24px 36px; }

  .fgp-ft__top {
    grid-template-columns: 1fr;
    gap: 36px;
  }

  .fgp-ft__nl { padding-top: 4px; }

  .fgp-ft__deco {
    position: static;
    height: auto;
    width: 100%;
    max-height: 140px;
    margin-top: 8px;
    opacity: 0.7;
  }

  .fgp-ft__bottom { padding: 20px 24px; }

  .fgp-ft__bottom-inner {
    flex-direction: column;
    align-items: flex-start;
  }
}
</style>

{% schema %}
{
  "name": "FGP Footer",
  "tag": "section",
  "class": "fgp-footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address"
    },
    {
      "type": "textarea",
      "id": "hours",
      "label": "Store hours"
    },
    {
      "type": "header",
      "content": "Link column 1"
    },
    {
      "type": "text",
      "id": "menu_1_heading",
      "label": "Heading",
      "default": "Company"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Menu",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Link column 2"
    },
    {
      "type": "text",
      "id": "menu_2_heading",
      "label": "Heading",
      "default": "Resources"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Menu"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "nl_heading",
      "label": "Heading",
      "info": "Leave blank to use the translated default text"
    },
    {
      "type": "text",
      "id": "nl_subtext",
      "label": "Subtext"
    },
    {
      "type": "text",
      "id": "nl_placeholder",
      "label": "Email placeholder",
      "info": "Leave blank to use the translated default text"
    },
    {
      "type": "text",
      "id": "nl_btn",
      "label": "Button label (used as aria-label)",
      "info": "Leave blank to use the translated default text"
    },
    {
      "type": "text",
      "id": "nl_consent",
      "label": "Consent checkbox text",
      "info": "Leave blank to hide the consent checkbox"
    },
    {
      "type": "text",
      "id": "nl_success",
      "label": "Success message",
      "info": "Leave blank to use the translated default text"
    },
    {
      "type": "header",
      "content": "Decoration"
    },
    {
      "type": "image_picker",
      "id": "decoration_image",
      "label": "Decorative image (right side, desktop)"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "label": "Show language selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "Show country/region selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright text",
      "info": "Leave blank to use the translated default text"
    }
  ],
  "presets": [
    { "name": "FGP Footer" }
  ]
}
{% endschema %}
