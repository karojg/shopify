{% comment %}
  Feel Good Pharma — Product Benefits / Feature Badges Section
  Desktop: heading + row of icon+label benefit cards
  Mobile:  2-col grid of cards
  Used on product pages to show key benefits (e.g. "4 IN 1", dosage info, etc.)
  Shopify OS 2.0 Section
{% endcomment %}

{% render 'fgp-global' %}

<section class="fgp-benefits" aria-label="Product benefits">

  {% if section.settings.eyebrow != blank %}
    <p class="fgp-benefits__eyebrow">{{ section.settings.eyebrow }}</p>
  {% endif %}

  {% if section.settings.heading != blank %}
    <h2 class="fgp-benefits__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  {% if section.settings.subtext != blank %}
    <p class="fgp-benefits__subtext">{{ section.settings.subtext }}</p>
  {% endif %}

  <div class="fgp-benefits__grid">
    {% for block in section.blocks %}
      <div class="fgp-benefits__card" {{ block.shopify_attributes }}>
        {% if block.settings.icon != blank %}
          <img
            class="fgp-benefits__icon"
            src="{{ block.settings.icon | img_url: '120x' }}"
            alt="{{ block.settings.label }}"
            loading="lazy"
          >
        {% elsif block.settings.icon_emoji != blank %}
          <span class="fgp-benefits__emoji">{{ block.settings.icon_emoji }}</span>
        {% else %}
          <div class="fgp-benefits__icon fgp-benefits__icon--placeholder"></div>
        {% endif %}

        {% if block.settings.label != blank %}
          <p class="fgp-benefits__label">{{ block.settings.label }}</p>
        {% endif %}

        {% if block.settings.sublabel != blank %}
          <p class="fgp-benefits__sublabel">{{ block.settings.sublabel }}</p>
        {% endif %}
      </div>
    {% endfor %}
  </div>

</section>

<style>
.fgp-benefits {
  --fgp-navy:     #234092;
  --fgp-blue:     #45bfef;
  --fgp-gold:     #fdb921;
  --fgp-offwhite: #f8f8f8;
  --fgp-white:    #ffffff;
  --fgp-font:     'Poppins', sans-serif;

  font-family: var(--fgp-font);
  background: var(--fgp-offwhite);
  padding: 56px 24px 64px;
  text-align: center;
}

.fgp-benefits__eyebrow {
  font-size: 12px;
  font-weight: 700;
  color: var(--fgp-blue);
  letter-spacing: 2px;
  text-transform: uppercase;
  margin: 0 0 10px;
}

.fgp-benefits__heading {
  font-size: 28px;
  font-weight: 700;
  color: var(--fgp-navy);
  margin: 0 auto 12px;
  max-width: 700px;
  line-height: 1.3;
}

.fgp-benefits__subtext {
  font-size: 15px;
  color: var(--fgp-navy);
  opacity: 0.7;
  margin: 0 auto 40px;
  max-width: 600px;
  line-height: 1.6;
}

/* Grid */
.fgp-benefits__grid {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: flex-start;
  gap: 32px;
  flex-wrap: wrap;
  max-width: 1100px;
  margin: 0 auto;
}

/* Card */
.fgp-benefits__card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  flex: 0 1 160px;
  background: var(--fgp-white);
  border-radius: 16px;
  padding: 24px 16px;
  box-shadow: 0 4px 16px rgba(0,0,0,0.06);
}

.fgp-benefits__icon {
  width: 72px;
  height: 72px;
  object-fit: contain;
  display: block;
}

.fgp-benefits__icon--placeholder {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  background: #dce8f5;
}

.fgp-benefits__emoji {
  font-size: 40px;
  line-height: 1;
}

.fgp-benefits__label {
  font-size: 14px;
  font-weight: 700;
  color: var(--fgp-navy);
  margin: 0;
  line-height: 1.3;
  text-align: center;
}

.fgp-benefits__sublabel {
  font-size: 12px;
  font-weight: 400;
  color: var(--fgp-navy);
  opacity: 0.65;
  margin: 0;
  line-height: 1.4;
  text-align: center;
}

/* Mobile */
@media (max-width: 767px) {
  .fgp-benefits {
    padding: 40px 20px 48px;
  }

  .fgp-benefits__heading { font-size: 22px; }

  .fgp-benefits__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    justify-items: center;
  }

  .fgp-benefits__card {
    flex: none;
    width: 100%;
    padding: 20px 12px;
  }

  .fgp-benefits__icon {
    width: 56px;
    height: 56px;
  }
}

/* Tablet */
@media (min-width: 768px) and (max-width: 1100px) {
  .fgp-benefits__grid { gap: 20px; }
  .fgp-benefits__card { flex: 0 1 140px; padding: 20px 14px; }
}
</style>

{% schema %}
{
  "name": "FGP Product Benefits",
  "tag": "section",
  "class": "fgp-product-benefits",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WHY CHOOSE US"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SYNBIOTIC+ 4 IN 1"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext (optional)"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image"
        },
        {
          "type": "text",
          "id": "icon_emoji",
          "label": "Emoji (if no image)",
          "info": "Used as fallback if no icon image is uploaded"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Benefit name"
        },
        {
          "type": "text",
          "id": "sublabel",
          "label": "Sub-label (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FGP Product Benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "label": "Prebiotics",
            "sublabel": "Feed good bacteria"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "label": "Probiotics",
            "sublabel": "Replenish good bacteria"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "label": "Postbiotics",
            "sublabel": "Strengthen gut barrier"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "label": "Enzymes",
            "sublabel": "Improve digestion"
          }
        }
      ]
    }
  ]
}
{% endschema %}
