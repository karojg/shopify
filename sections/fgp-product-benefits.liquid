{% comment %}
  Feel Good Pharma — Product Benefits / Feature Badges Section
  Desktop: heading + row of icon+label benefit cards
  Mobile:  2-col grid of cards
  Used on product pages to show key benefits (e.g. "4 IN 1", dosage info, etc.)
  Shopify OS 2.0 Section
{% endcomment %}

{% render 'fgp-global' %}

<section class="fgp-benefits" aria-label="{{ 'fgp.aria.product_benefits' | t }}">

  {% if section.settings.eyebrow != blank %}
    <p class="fgp-benefits__eyebrow">{{ section.settings.eyebrow }}</p>
  {% endif %}

  {% if section.settings.heading != blank %}
    <h2 class="fgp-benefits__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  {% if section.settings.subtext != blank %}
    <p class="fgp-benefits__subtext">{{ section.settings.subtext }}</p>
  {% endif %}

  <div class="fgp-benefits__grid">
    {% for block in section.blocks %}
      <div class="fgp-benefits__card" {{ block.shopify_attributes }}>
        {% if block.settings.icon != blank %}
          <img
            class="fgp-benefits__icon"
            src="{{ block.settings.icon | img_url: '120x' }}"
            alt="{{ block.settings.label }}"
            loading="lazy"
          >
        {% elsif block.settings.icon_emoji != blank %}
          <span class="fgp-benefits__emoji">{{ block.settings.icon_emoji }}</span>
        {% endif %}

        {% if block.settings.label != blank %}
          <p class="fgp-benefits__label">{{ block.settings.label }}</p>
        {% endif %}

        {% if block.settings.sublabel != blank %}
          <p class="fgp-benefits__sublabel">{{ block.settings.sublabel }}</p>
        {% endif %}
      </div>
    {% endfor %}
  </div>

</section>

<style>
.fgp-benefits {
  font-family: var(--fgp-font);
  background: var(--fgp-offwhite);
  padding: 56px 24px 64px;
  text-align: center;
}

.fgp-benefits__eyebrow {
  font-size: 12px;
  font-weight: 700;
  color: var(--fgp-blue);
  letter-spacing: 2px;
  text-transform: uppercase;
  margin: 0 0 10px;
}

.fgp-benefits__heading {
  font-size: 36px;
  font-weight: 600;
  color: var(--fgp-purple);
  margin: 0 auto 40px;
  max-width: 700px;
  line-height: 1.3;
}

.fgp-benefits__subtext {
  font-size: 15px;
  color: var(--fgp-navy);
  opacity: 0.7;
  margin: 0 auto 40px;
  max-width: 600px;
  line-height: 1.6;
}

/* Grid — horizontal row */
.fgp-benefits__grid {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: flex-start;
  gap: 40px;
  flex-wrap: wrap;
  max-width: 1100px;
  margin: 0 auto;
}

/* Card — no background, no border */
.fgp-benefits__card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 10px;
  flex: 0 1 180px;
}

.fgp-benefits__icon {
  width: 80px;
  height: 80px;
  object-fit: contain;
  display: block;
  border: 2px solid var(--fgp-purple);
  border-radius: 50%;
  padding: 16px;
  box-sizing: border-box;
}

.fgp-benefits__icon--placeholder { display: none; }

.fgp-benefits__emoji {
  font-size: 40px;
  line-height: 1;
}

.fgp-benefits__label {
  font-size: 14px;
  font-weight: 700;
  color: var(--fgp-purple);
  margin: 0;
  line-height: 1.3;
}

.fgp-benefits__sublabel {
  font-size: 13px;
  font-weight: 400;
  color: #2E2A39;
  margin: 0;
  line-height: 1.5;
}

/* Mobile */
@media (max-width: 767px) {
  .fgp-benefits { padding-top: 40px; padding-bottom: 48px; }
  .fgp-benefits__heading { font-size: 28px; }
  .fgp-benefits__label { font-size: 18px; }
  .fgp-benefits__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    justify-items: center;
  }
  .fgp-benefits__card { flex: none; width: 100%; }
}

/* Tablet */
@media (min-width: 768px) and (max-width: 1100px) {
  .fgp-benefits__grid { gap: 28px; }
}
</style>

{% schema %}
{
  "name": "FGP Product Benefits",
  "tag": "section",
  "class": "fgp-product-benefits",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SYNBIOTIC+ 4 IN 1"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext (optional)"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image"
        },
        {
          "type": "text",
          "id": "icon_emoji",
          "label": "Emoji (if no image)",
          "info": "Used as fallback if no icon image is uploaded"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Benefit name"
        },
        {
          "type": "text",
          "id": "sublabel",
          "label": "Sub-label (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FGP Product Benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "label": "Prebiotics",
            "sublabel": "Feed good bacteria"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "label": "Probiotics",
            "sublabel": "Replenish good bacteria"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "label": "Postbiotics",
            "sublabel": "Strengthen gut barrier"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "label": "Enzymes",
            "sublabel": "Improve digestion"
          }
        }
      ]
    }
  ]
}
{% endschema %}
