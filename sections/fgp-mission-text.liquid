{% comment %}
  Feel Good Pharma — Mission / Body Text Section
  Simple centered rich-text block for pages like About Us
  Shopify OS 2.0 Section
{% endcomment %}

{% render 'fgp-global' %}

<section class="fgp-mission" aria-label="{{ 'fgp.aria.mission_text' | t }}">
  <div class="fgp-mission__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="fgp-mission__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="fgp-mission__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.body != blank %}
      <div class="fgp-mission__body">{{ section.settings.body }}</div>
    {% endif %}
  </div>
</section>

<style>
.fgp-mission {
  --fgp-navy:     #234092;
  --fgp-blue:     #45bfef;
  --fgp-white:    #ffffff;
  --fgp-font:     'Poppins', sans-serif;

  font-family: var(--fgp-font);
  background: var(--fgp-white);
  padding: 40px 24px 56px;
}

.fgp-mission__inner {
  max-width: 720px;
  margin: 0 auto;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.fgp-mission__eyebrow {
  font-size: 12px;
  font-weight: 700;
  color: var(--fgp-blue);
  letter-spacing: 2px;
  text-transform: uppercase;
  margin: 0;
}

.fgp-mission__heading {
  font-size: 28px;
  font-weight: 700;
  color: var(--fgp-navy);
  margin: 0 0 8px;
  line-height: 1.3;
}

.fgp-mission__body {
  font-size: 16px;
  color: var(--fgp-navy);
  opacity: 0.85;
  line-height: 1.7;
  text-align: left;
}

.fgp-mission__body p { margin: 0 0 18px; }
.fgp-mission__body p:last-child { margin-bottom: 0; }

@media (max-width: 767px) {
  .fgp-mission { padding: 40px 20px; }
  .fgp-mission__heading { font-size: 22px; }
  .fgp-mission__body { font-size: 15px; }
}
</style>

{% schema %}
{
  "name": "FGP Mission Text",
  "tag": "section",
  "class": "fgp-mission-text",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (optional)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text"
    }
  ],
  "presets": [
    {
      "name": "FGP Mission Text"
    }
  ]
}
{% endschema %}
