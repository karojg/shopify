{% comment %}
  Feel Good Pharma — How Our Formulations Work Section
  Desktop: heading + 2-col grid of step cards (icon left, text right)
  Mobile:  vertical stack
  Shopify OS 2.0 Section
{% endcomment %}

{% render 'fgp-global' %}

<section class="fgp-hiw" aria-label="How it works">

  <div class="fgp-hiw__header">
    {% if section.settings.eyebrow != blank %}
      <p class="fgp-hiw__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2 class="fgp-hiw__heading">{{ section.settings.heading | default: 'How do our formulations work?' }}</h2>
    {% if section.settings.subtext != blank %}
      <p class="fgp-hiw__subtext">{{ section.settings.subtext }}</p>
    {% endif %}
  </div>

  <div class="fgp-hiw__grid">
    {% for block in section.blocks %}
      <div class="fgp-hiw__item" {{ block.shopify_attributes }}>
        <div class="fgp-hiw__icon-wrap">
          {% if block.settings.icon != blank %}
            <img
              class="fgp-hiw__icon"
              src="{{ block.settings.icon | img_url: '120x' }}"
              alt="{{ block.settings.title }}"
              loading="lazy"
            >
          {% else %}
            <div class="fgp-hiw__icon-num">{{ forloop.index }}</div>
          {% endif %}
        </div>
        <div class="fgp-hiw__text">
          {% if block.settings.title != blank %}
            <h3 class="fgp-hiw__title">{{ block.settings.title }}</h3>
          {% endif %}
          {% if block.settings.description != blank %}
            <p class="fgp-hiw__desc">{{ block.settings.description }}</p>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>

  {% if section.settings.cta_label != blank %}
    <div class="fgp-hiw__cta-wrap">
      <a href="{{ section.settings.cta_url | default: '#' }}" class="fgp-hiw__cta">
        {{ section.settings.cta_label }}
      </a>
    </div>
  {% endif %}

</section>

<style>
.fgp-hiw {
  font-family: var(--fgp-font);
  background: var(--fgp-white);
  padding: 56px 24px 64px;
}

/* Header */
.fgp-hiw__header {
  text-align: center;
  margin-bottom: 48px;
}

.fgp-hiw__eyebrow {
  font-size: 12px;
  font-weight: 700;
  color: var(--fgp-blue);
  letter-spacing: 2px;
  text-transform: uppercase;
  margin: 0 0 10px;
}

.fgp-hiw__heading {
  font-size: 28px;
  font-weight: 700;
  color: var(--fgp-purple);
  margin: 0 auto 12px;
  max-width: 600px;
  line-height: 1.3;
}

.fgp-hiw__subtext {
  font-size: 15px;
  color: var(--fgp-navy);
  opacity: 0.7;
  margin: 0 auto;
  max-width: 560px;
  line-height: 1.6;
}

/* Grid: 2 columns */
.fgp-hiw__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 28px;
  max-width: 960px;
  margin: 0 auto;
}

/* Item */
.fgp-hiw__item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16px;
  background: var(--fgp-offwhite);
  border-radius: 16px;
  padding: 24px;
}

/* Icon */
.fgp-hiw__icon-wrap {
  flex-shrink: 0;
}

.fgp-hiw__icon {
  width: 56px;
  height: 56px;
  object-fit: contain;
  display: block;
}

.fgp-hiw__icon-num {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--fgp-blue);
  color: var(--fgp-white);
  font-size: 20px;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Text */
.fgp-hiw__text {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.fgp-hiw__title {
  font-size: 16px;
  font-weight: 700;
  color: var(--fgp-navy);
  margin: 0;
  line-height: 1.3;
}

.fgp-hiw__desc {
  font-size: 14px;
  font-weight: 400;
  color: var(--fgp-navy);
  opacity: 0.75;
  margin: 0;
  line-height: 1.6;
}

/* CTA */
.fgp-hiw__cta-wrap {
  text-align: center;
  margin-top: 40px;
}

.fgp-hiw__cta {
  display: inline-block;
  background: var(--fgp-navy);
  color: var(--fgp-white);
  font-family: var(--fgp-font);
  font-size: 15px;
  font-weight: 600;
  border-radius: 100px;
  padding: 14px 36px;
  text-decoration: none;
  transition: opacity 0.2s;
}

.fgp-hiw__cta:hover { opacity: 0.85; }

/* Mobile */
@media (max-width: 767px) {
  .fgp-hiw {
    padding: 40px 20px 48px;
  }

  .fgp-hiw__heading { font-size: 22px; }

  .fgp-hiw__grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .fgp-hiw__item { padding: 20px; }
}

/* Tablet */
@media (min-width: 768px) and (max-width: 1100px) {
  .fgp-hiw__grid { gap: 20px; }
}
</style>

{% schema %}
{
  "name": "FGP How It Works",
  "tag": "section",
  "class": "fgp-how-it-works",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE SCIENCE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How do our formulations work?"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext (optional)"
    },
    {
      "type": "header",
      "content": "CTA Button (optional)"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image (optional — uses step number if blank)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Describe how this step works and what benefit it provides."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FGP How It Works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Prebiotics feed good bacteria",
            "description": "Prebiotic fibers serve as food for beneficial bacteria, helping them thrive and multiply in your gut."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Probiotics replenish the microbiome",
            "description": "Live probiotic strains colonize the gut and restore microbial balance, supporting digestion and immunity."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Postbiotics strengthen gut barrier",
            "description": "Postbiotic compounds reinforce the intestinal lining, reducing inflammation and improving nutrient absorption."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Enzymes improve digestion",
            "description": "Digestive enzymes break down proteins, fats, and carbohydrates efficiently, reducing bloating and discomfort."
          }
        }
      ]
    }
  ]
}
{% endschema %}
