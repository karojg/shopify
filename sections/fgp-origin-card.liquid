{% comment %}
  Feel Good Pharma — Origin / Certification Card
  2-column card: left (blue panel — heading, body, cert logos, CTA), right (photo)
  Shopify OS 2.0 Section — reusable across PDPs
{% endcomment %}

{% render 'fgp-global' %}

<section class="fgp-origin" aria-label="{{ section.settings.heading | default: 'Formulated in Costa Rica' }}">
  <div class="fgp-origin__card">

    <!-- LEFT: Blue panel -->
    <div class="fgp-origin__left">
      <div class="fgp-origin__left-content">
        {% if section.settings.heading != blank %}
          <h2 class="fgp-origin__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.body != blank %}
          <div class="fgp-origin__body">{{ section.settings.body }}</div>
        {% endif %}

        <!-- Certification logos -->
        {% assign has_logos = false %}
        {% for block in section.blocks %}
          {% if block.type == 'cert_logo' and block.settings.logo != blank %}
            {% assign has_logos = true %}
          {% endif %}
        {% endfor %}

        {% if has_logos %}
          <div class="fgp-origin__logos">
            {% for block in section.blocks %}
              {% if block.type == 'cert_logo' and block.settings.logo != blank %}
                <img
                  class="fgp-origin__logo"
                  src="{{ block.settings.logo | img_url: '120x' }}"
                  alt="{{ block.settings.logo_alt | default: 'Certification' }}"
                  loading="lazy"
                  {{ block.shopify_attributes }}
                >
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        {% if section.settings.cta_label != blank %}
          <a href="{{ section.settings.cta_url | default: '#' }}" class="fgp-origin__cta">
            {{ section.settings.cta_label }}
          </a>
        {% endif %}
      </div>
    </div>

    <!-- RIGHT: Photo -->
    <div class="fgp-origin__right">
      {% if section.settings.photo != blank %}
        <img
          class="fgp-origin__photo"
          src="{{ section.settings.photo | img_url: 'master' }}"
          alt="{{ section.settings.photo_alt | default: '' }}"
          loading="lazy"
        >
      {% else %}
        <div class="fgp-origin__photo-placeholder"></div>
      {% endif %}
    </div>

  </div>
</section>

<style>
.fgp-origin {
  font-family: var(--fgp-font-primary, 'Poppins', sans-serif);
  padding-top: 40px;
  padding-bottom: 56px;
}

.fgp-origin__card {
  display: flex;
  align-items: stretch;
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 10px 10px 17.5px rgba(46,42,57,0.05);
  min-height: 360px;
}

/* ── Left: blue panel ── */
.fgp-origin__left {
  flex: 0 0 50%;
  background: var(--fgp-picton-blue, #45bfef);
  display: flex;
  align-items: center;
}

.fgp-origin__left-content {
  padding: 40px 48px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.fgp-origin__heading {
  font-size: clamp(22px, 2.5vw, 30px);
  font-weight: 700;
  color: var(--fgp-white, #ffffff);
  line-height: 1.25;
  letter-spacing: 0.5px;
  margin: 0;
}

.fgp-origin__body {
  font-size: 15px;
  font-weight: 400;
  color: rgba(255,255,255,0.9);
  line-height: 1.6;
  letter-spacing: 0.3px;
}
.fgp-origin__body p { margin: 0; }

.fgp-origin__logos {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16px;
}

.fgp-origin__logo {
  height: 48px;
  width: auto;
  object-fit: contain;
}

.fgp-origin__cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
  background: var(--fgp-white, #ffffff);
  color: var(--fgp-dark-cornflower-blue, #234092);
  font-family: var(--fgp-font-primary, 'Poppins', sans-serif);
  font-size: 16px;
  font-weight: 600;
  letter-spacing: 0.5px;
  border-radius: 100px;
  padding: 14px 32px;
  text-decoration: none;
  transition: opacity 0.2s;
  white-space: nowrap;
}
.fgp-origin__cta:hover { opacity: 0.88; }

/* ── Right: photo ── */
.fgp-origin__right {
  flex: 1;
  overflow: hidden;
  border-radius: 0 24px 24px 0;
}

.fgp-origin__photo {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

.fgp-origin__photo-placeholder {
  width: 100%;
  height: 100%;
  min-height: 360px;
  background: #dce8f5;
}

/* ── Mobile ── */
@media (max-width: 767px) {
  .fgp-origin__card {
    flex-direction: column;
    border-radius: 16px;
  }

  .fgp-origin__left,
  .fgp-origin__right {
    flex: none;
    width: 100%;
  }

  .fgp-origin__left-content {
    padding: 32px 24px;
    gap: 16px;
  }

  .fgp-origin__right {
    border-radius: 0 0 16px 16px;
    min-height: 220px;
  }

  .fgp-origin__cta {
    font-size: 15px;
    padding: 12px 28px;
  }
}
</style>

{% schema %}
{
  "name": "FGP Origin Card",
  "tag": "section",
  "class": "fgp-origin-card",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Left Panel"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Formulated in Costa Rica"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>Manufactured in United States in facilities with FDA standards with source materials from GMP.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Button Label",
      "default": "Explore Ingredients"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Button URL"
    },
    {
      "type": "header",
      "content": "Right Panel"
    },
    {
      "type": "image_picker",
      "id": "photo",
      "label": "Photo"
    },
    {
      "type": "text",
      "id": "photo_alt",
      "label": "Photo Alt Text"
    }
  ],
  "blocks": [
    {
      "type": "cert_logo",
      "name": "Certification Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo Image"
        },
        {
          "type": "text",
          "id": "logo_alt",
          "label": "Logo Alt Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FGP Origin Card",
      "blocks": [
        { "type": "cert_logo", "settings": { "logo_alt": "DE111 Probiotic" } },
        { "type": "cert_logo", "settings": { "logo_alt": "FDA" } },
        { "type": "cert_logo", "settings": { "logo_alt": "GMP" } },
        { "type": "cert_logo", "settings": { "logo_alt": "Made in USA" } }
      ]
    }
  ]
}
{% endschema %}
