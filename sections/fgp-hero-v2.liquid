{% render 'fgp-global' %}

<section class="fgp-hh fgp-hh--v2" aria-label="Hero banner">
  <div class="fgp-hh__inner">

    <!-- LEFT: bottles + badge -->
    <div class="fgp-hh__media">
      {% if section.settings.badge_image != blank %}
        <img class="fgp-hh__badge" src="{{ section.settings.badge_image | img_url: '200x' }}" alt="Recommended by Health Specialists" loading="lazy">
      {% endif %}
      <div class="fgp-hh__bottles">
        {% if section.settings.bottle_1 != blank %}
          <img class="fgp-hh__b" src="{{ section.settings.bottle_1 | img_url: '400x' }}" alt="" loading="eager">
        {% endif %}
        {% if section.settings.bottle_2 != blank %}
          <img class="fgp-hh__b" src="{{ section.settings.bottle_2 | img_url: '400x' }}" alt="" loading="eager">
        {% endif %}
        {% if section.settings.bottle_3 != blank %}
          <img class="fgp-hh__b" src="{{ section.settings.bottle_3 | img_url: '400x' }}" alt="" loading="eager">
        {% endif %}
      </div>
    </div>

    <!-- RIGHT: heading + symptoms + CTA -->
    <div class="fgp-hh__content">
      <h1 class="fgp-hh__heading">
        <span class="fgp-hh__heading-line">
          {{ section.settings.heading_before | default: 'Is it a gut feeling or' }}
          <span class="fgp-hh__blank" aria-live="polite">
            {% for block in section.blocks %}
              {% if block.type == 'symptom' %}
                <span class="fgp-hh__cycle-word{% if forloop.first %} is-active{% endif %}">{{ block.settings.label }}</span>
              {% endif %}
            {% endfor %}
            <span class="fgp-hh__underline" aria-hidden="true"></span>
          </span>?
        </span>
      </h1>

      {% if section.blocks.size > 0 %}
        <ul class="fgp-hh__symptoms">
          {% for block in section.blocks %}
            {% if block.type == 'symptom' %}
              <li class="fgp-hh__symptom" {{ block.shopify_attributes }}>{{ block.settings.label }}</li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}

      {% if section.settings.cta_label != blank %}
        <a href="{{ section.settings.cta_url | default: '#' }}" class="fgp-hh__cta">{{ section.settings.cta_label }}</a>
      {% endif %}
    </div>

  </div>
</section>

<style>
.fgp-hh--v2 {
  font-family: var(--fgp-font);
  background: var(--fgp-blue);
  width: 100%;
  overflow: hidden;
}

.fgp-hh--v2 .fgp-hh__inner {
  display: flex;
  align-items: flex-end;
  min-height: 580px;
}

/* LEFT — bottles */
.fgp-hh--v2 .fgp-hh__media {
  flex: 0 0 50%;
  position: relative;
  align-self: stretch;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 32px 0 0 40px;
}

.fgp-hh--v2 .fgp-hh__badge {
  position: absolute;
  top: 32px;
  left: 40px;
  width: 100px;
  z-index: 2;
}

.fgp-hh--v2 .fgp-hh__bottles {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 0;
  width: 100%;
  height: 100%;
}

.fgp-hh--v2 .fgp-hh__b {
  flex: 0 0 auto;
  width: 33%;
  max-width: 220px;
  height: auto;
  object-fit: contain;
  object-position: bottom center;
  align-self: flex-end;
  filter: drop-shadow(0 8px 24px rgba(0,0,0,0.12));
}

/* RIGHT — content */
.fgp-hh--v2 .fgp-hh__content {
  flex: 0 0 50%;
  padding: 56px 64px 56px 40px;
  display: flex;
  flex-direction: column;
  gap: 24px;
  align-self: center;
}

/* Heading */
.fgp-hh--v2 .fgp-hh__heading {
  font-size: 40px;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.2;
  margin: 0;
}

.fgp-hh--v2 .fgp-hh__heading-line {
  display: inline;
}

/* Cycling word + underline */
.fgp-hh--v2 .fgp-hh__blank {
  display: inline-block;
  position: relative;
  min-width: 200px;
  vertical-align: bottom;
}

.fgp-hh__cycle-word {
  position: absolute;
  left: 0;
  bottom: 4px;
  white-space: nowrap;
  opacity: 0;
  transition: opacity 0.4s ease;
  color: #ffffff;
  font-style: normal;
}

.fgp-hh__cycle-word.is-active {
  opacity: 1;
  position: relative;
}

.fgp-hh--v2 .fgp-hh__underline {
  display: block;
  border-bottom: 2px solid rgba(255,255,255,0.7);
  width: 100%;
  height: 4px;
  margin-top: 2px;
}

/* Symptom list — no icons, white text */
.fgp-hh--v2 .fgp-hh__symptoms {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.fgp-hh--v2 .fgp-hh__symptom {
  font-size: 28px;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.35;
}

/* CTA */
.fgp-hh--v2 .fgp-hh__cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
  font-family: var(--fgp-font);
  font-size: 17px;
  font-weight: 700;
  background: #ffffff;
  color: var(--fgp-navy);
  border-radius: 200px;
  padding: 14px 36px;
  text-decoration: none;
  transition: opacity 0.2s;
  white-space: nowrap;
  margin-top: 8px;
}
.fgp-hh--v2 .fgp-hh__cta:hover { opacity: 0.88; }

/* ── Mobile ── */
@media (max-width: 767px) {
  .fgp-hh--v2 .fgp-hh__inner {
    flex-direction: column;
    align-items: stretch;
    min-height: unset;
  }

  .fgp-hh--v2 .fgp-hh__media {
    flex: none;
    order: 2;
    padding: 0 16px;
    min-height: 220px;
    justify-content: center;
  }

  .fgp-hh--v2 .fgp-hh__badge {
    top: 16px;
    left: 16px;
    width: 64px;
  }

  .fgp-hh--v2 .fgp-hh__b { width: 30%; }

  .fgp-hh--v2 .fgp-hh__content {
    flex: none;
    order: 1;
    padding: 32px 24px 24px;
    gap: 14px;
    align-items: center;
    text-align: center;
  }

  .fgp-hh--v2 .fgp-hh__heading { font-size: 22px; }
  .fgp-hh--v2 .fgp-hh__blank { min-width: 100px; }
  .fgp-hh--v2 .fgp-hh__symptom { font-size: 16px; }
  .fgp-hh--v2 .fgp-hh__cta { font-size: 14px; padding: 11px 28px; align-self: center; }
}

/* ── Tablet ── */
@media (min-width: 768px) and (max-width: 1100px) {
  .fgp-hh--v2 .fgp-hh__heading { font-size: 30px; }
  .fgp-hh--v2 .fgp-hh__symptom { font-size: 22px; }
  .fgp-hh--v2 .fgp-hh__content { padding: 48px 40px 48px 32px; }
  .fgp-hh--v2 .fgp-hh__blank { min-width: 140px; }
}
</style>

<script>
(function () {
  var words = document.querySelectorAll('.fgp-hh--v2 .fgp-hh__cycle-word');
  if (words.length < 2) return;
  var idx = 0;
  setInterval(function () {
    words[idx].classList.remove('is-active');
    idx = (idx + 1) % words.length;
    words[idx].classList.add('is-active');
  }, 2200);
})();
</script>

{% schema %}
{
  "name": "FGP Hero — Blue",
  "tag": "section",
  "class": "fgp-homepage-hero-v2",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading_before", "label": "Heading (before blank)", "default": "Is it a gut feeling or" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Take The 1 Minute Test!" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" },
    { "type": "image_picker", "id": "badge_image", "label": "Badge image (top-left)" },
    { "type": "image_picker", "id": "bottle_1", "label": "Bottle image 1 (left)" },
    { "type": "image_picker", "id": "bottle_2", "label": "Bottle image 2 (center)" },
    { "type": "image_picker", "id": "bottle_3", "label": "Bottle image 3 (right)" }
  ],
  "blocks": [
    {
      "type": "symptom",
      "name": "Symptom",
      "settings": [
        { "type": "text", "id": "label", "label": "Symptom label", "default": "Stress" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FGP Hero — Blue",
      "blocks": [
        { "type": "symptom", "settings": { "label": "Stress" } },
        { "type": "symptom", "settings": { "label": "Gluten intolerance" } },
        { "type": "symptom", "settings": { "label": "Lactose intolerance" } },
        { "type": "symptom", "settings": { "label": "Constipation or Diarrhea" } },
        { "type": "symptom", "settings": { "label": "Irritable Bowel Syndrome" } },
        { "type": "symptom", "settings": { "label": "Low defenses" } }
      ]
    }
  ]
}
{% endschema %}
