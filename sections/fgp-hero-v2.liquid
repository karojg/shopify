{% render 'fgp-global' %}

{% assign symptom_words = '' %}
{% for block in section.blocks %}
  {% if block.type == 'symptom' %}
    {% unless forloop.first %}{% assign symptom_words = symptom_words | append: '|' %}{% endunless %}
    {% assign symptom_words = symptom_words | append: block.settings.label %}
  {% endif %}
{% endfor %}

<section class="fgp-hh fgp-hh--v2" aria-label="Hero banner">
  <div class="fgp-hh__inner">

    <!-- TOP: full-width heading -->
    <div class="fgp-hh__top">
      <h1 class="fgp-hh__heading">
        <span class="fgp-hh__heading-text">{{ section.settings.heading_before | default: 'Is it a gut feeling or' }}</span>
        <span class="fgp-hh__blank">
          <span class="fgp-hh__cycle-target" data-words="{{ symptom_words }}">
            {%- for block in section.blocks -%}
              {%- if block.type == 'symptom' and forloop.first -%}{{ block.settings.label }}{%- endif -%}
            {%- endfor -%}
          </span>
        </span>
        <span class="fgp-hh__question">?</span>
      </h1>
    </div>

    <!-- BOTTOM: bottles (left) | symptoms + CTA (right) -->
    <div class="fgp-hh__bottom">

      <div class="fgp-hh__media">
        {% if section.settings.badge_image != blank %}
          <img class="fgp-hh__badge fgp-hh__badge--dk" src="{{ section.settings.badge_image | img_url: '200x' }}" alt="Recommended by Health Specialists" loading="lazy">
        {% endif %}
        <div class="fgp-hh__bottles">
          {% if section.settings.bottle_1 != blank %}
            <img class="fgp-hh__b" src="{{ section.settings.bottle_1 | img_url: '500x' }}" alt="" loading="eager">
          {% endif %}
          {% if section.settings.bottle_2 != blank %}
            <img class="fgp-hh__b" src="{{ section.settings.bottle_2 | img_url: '500x' }}" alt="" loading="eager">
          {% endif %}
          {% if section.settings.bottle_3 != blank %}
            <img class="fgp-hh__b" src="{{ section.settings.bottle_3 | img_url: '500x' }}" alt="" loading="eager">
          {% endif %}
        </div>
      </div>

      <div class="fgp-hh__content">
        {% if section.blocks.size > 0 %}
          <ul class="fgp-hh__symptoms">
            {% for block in section.blocks %}
              {% if block.type == 'symptom' %}
                <li class="fgp-hh__symptom" {{ block.shopify_attributes }}>{{ block.settings.label }}</li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}

        <div class="fgp-hh__foot">
          {% if section.settings.badge_image != blank %}
            <img class="fgp-hh__badge fgp-hh__badge--mb" src="{{ section.settings.badge_image | img_url: '200x' }}" alt="Recommended by Health Specialists" loading="lazy">
          {% endif %}
          {% if section.settings.cta_label != blank %}
            <a href="{{ section.settings.cta_url | default: '#' }}" class="fgp-hh__cta">{{ section.settings.cta_label }}</a>
          {% endif %}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
.fgp-hh--v2 {
  font-family: var(--fgp-font);
  background: var(--fgp-blue);
  width: 100%;
  overflow: hidden;
}

.fgp-hh--v2 .fgp-hh__inner {
  display: flex;
  flex-direction: column;
  min-height: 580px;
}

/* ── Heading row ── */
.fgp-hh--v2 .fgp-hh__top {
  padding: 48px 64px 20px;
}

.fgp-hh--v2 .fgp-hh__heading {
  font-size: 58px;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
  margin: 0;
  display: flex;
  align-items: flex-end;
  gap: 14px;
}

.fgp-hh--v2 .fgp-hh__heading-text,
.fgp-hh--v2 .fgp-hh__question {
  flex-shrink: 0;
  white-space: nowrap;
}

/* Blank: grows to fill remaining width, underline via ::after */
.fgp-hh--v2 .fgp-hh__blank {
  flex: 1;
  min-width: 0;
  position: relative;
  padding-bottom: 6px;
}
.fgp-hh--v2 .fgp-hh__blank::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  border-bottom: 2px solid rgba(255,255,255,0.6);
}

/* Cycling word — JS swaps textContent, CSS fades */
.fgp-hh--v2 .fgp-hh__cycle-target {
  display: block;
  color: #ffffff;
  font-size: inherit;
  font-weight: inherit;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: opacity 0.35s ease;
}
.fgp-hh--v2 .fgp-hh__cycle-target.is-fading { opacity: 0; }

/* ── Bottom row ── */
.fgp-hh--v2 .fgp-hh__bottom {
  display: flex;
  flex: 1;
  align-items: flex-end;
}

/* Left: bottles */
.fgp-hh--v2 .fgp-hh__media {
  flex: 0 0 50%;
  position: relative;
  align-self: stretch;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 0 0 0 40px;
}

.fgp-hh--v2 .fgp-hh__badge--dk {
  position: absolute;
  top: 0;
  left: 40px;
  width: 88px;
}
.fgp-hh--v2 .fgp-hh__badge--mb { display: none; }

.fgp-hh--v2 .fgp-hh__bottles {
  display: flex;
  align-items: flex-end;
  width: 100%;
}
.fgp-hh--v2 .fgp-hh__b {
  flex: 1 1 0;
  max-width: 210px;
  height: auto;
  object-fit: contain;
  object-position: bottom center;
  filter: drop-shadow(0 8px 24px rgba(0,0,0,0.1));
}

/* Right: symptoms + foot */
.fgp-hh--v2 .fgp-hh__content {
  flex: 0 0 50%;
  padding: 16px 64px 48px 40px;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  gap: 28px;
}

.fgp-hh--v2 .fgp-hh__symptoms {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.fgp-hh--v2 .fgp-hh__symptom {
  font-size: 34px;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.2;
}

/* Footer: badge (mobile) + CTA */
.fgp-hh--v2 .fgp-hh__foot {
  display: flex;
  align-items: center;
  gap: 16px;
}

.fgp-hh--v2 .fgp-hh__cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-family: var(--fgp-font);
  font-size: 18px;
  font-weight: 700;
  background: #ffffff;
  color: var(--fgp-navy);
  border-radius: 200px;
  padding: 15px 40px;
  text-decoration: none;
  transition: opacity 0.2s;
  white-space: nowrap;
}
.fgp-hh--v2 .fgp-hh__cta:hover { opacity: 0.88; }

/* ── Mobile ≤ 639px ── */
@media (max-width: 639px) {
  .fgp-hh--v2 .fgp-hh__inner { min-height: unset; }

  .fgp-hh--v2 .fgp-hh__top { padding: 32px 20px 12px; }

  /* Two-line heading: "Is it a gut feeling or" / "[blank] ?" */
  .fgp-hh--v2 .fgp-hh__heading {
    font-size: 22px;
    gap: 4px 8px;
    flex-wrap: wrap;
    align-items: flex-end;
  }
  .fgp-hh--v2 .fgp-hh__heading-text { flex: 0 0 100%; }
  .fgp-hh--v2 .fgp-hh__blank { padding-bottom: 4px; flex: 1; }

  .fgp-hh--v2 .fgp-hh__bottom { flex-direction: column; }

  .fgp-hh--v2 .fgp-hh__content {
    flex: none; order: 1;
    width: 100%; padding: 8px 20px 16px;
    gap: 12px; align-items: flex-end; text-align: right;
  }

  .fgp-hh--v2 .fgp-hh__symptoms { gap: 10px; }
  .fgp-hh--v2 .fgp-hh__symptom  { font-size: 20px; font-weight: 400; }

  .fgp-hh--v2 .fgp-hh__badge--dk { display: none; }
  .fgp-hh--v2 .fgp-hh__badge--mb { display: block; width: 60px; flex-shrink: 0; }
  .fgp-hh--v2 .fgp-hh__foot { width: 100%; justify-content: space-between; }
  .fgp-hh--v2 .fgp-hh__cta  { font-size: 14px; padding: 11px 24px; }

  .fgp-hh--v2 .fgp-hh__media {
    flex: none; order: 2;
    width: 100%; padding: 0 8px;
    min-height: 140px; justify-content: flex-end;
  }
  .fgp-hh--v2 .fgp-hh__b { max-width: none; max-height: 140px; }
}

/* ── Small tablet 640–1023px ── */
@media (min-width: 640px) and (max-width: 1023px) {
  .fgp-hh--v2 .fgp-hh__inner   { min-height: 460px; }
  .fgp-hh--v2 .fgp-hh__top     { padding: 36px 40px 16px; }
  .fgp-hh--v2 .fgp-hh__heading { font-size: 36px; gap: 12px; }
  .fgp-hh--v2 .fgp-hh__blank   { padding-bottom: 5px; }
  .fgp-hh--v2 .fgp-hh__symptom { font-size: 22px; }
  .fgp-hh--v2 .fgp-hh__content { padding: 12px 40px 36px 28px; gap: 18px; }
  .fgp-hh--v2 .fgp-hh__media   { padding-left: 24px; }
  .fgp-hh--v2 .fgp-hh__badge--dk { left: 24px; width: 70px; }
  .fgp-hh--v2 .fgp-hh__cta     { font-size: 15px; padding: 12px 28px; }
  .fgp-hh--v2 .fgp-hh__b       { max-width: 180px; }
}
</style>

<script>
(function () {
  var target = document.querySelector('.fgp-hh--v2 .fgp-hh__cycle-target');
  if (!target) return;
  var raw = target.getAttribute('data-words') || '';
  var words = raw.split('|').map(function(w){ return w.trim(); }).filter(Boolean);
  if (words.length < 2) return;
  var idx = 0;
  setInterval(function () {
    target.classList.add('is-fading');
    setTimeout(function () {
      idx = (idx + 1) % words.length;
      target.textContent = words[idx];
      target.classList.remove('is-fading');
    }, 350);
  }, 2400);
})();
</script>

{% schema %}
{
  "name": "FGP Hero — Blue",
  "tag": "section",
  "class": "fgp-homepage-hero-v2",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading_before", "label": "Heading (before blank)", "default": "Is it a gut feeling or" },
    { "type": "text", "id": "cta_label",      "label": "CTA label",              "default": "Take The 1 Minute Test!" },
    { "type": "url",  "id": "cta_url",        "label": "CTA URL" },
    { "type": "image_picker", "id": "badge_image", "label": "Badge image" },
    { "type": "image_picker", "id": "bottle_1",    "label": "Bottle image 1 (left)" },
    { "type": "image_picker", "id": "bottle_2",    "label": "Bottle image 2 (center)" },
    { "type": "image_picker", "id": "bottle_3",    "label": "Bottle image 3 (right)" }
  ],
  "blocks": [
    {
      "type": "symptom",
      "name": "Symptom",
      "settings": [
        { "type": "text", "id": "label", "label": "Symptom label", "default": "Stress" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FGP Hero — Blue",
      "blocks": [
        { "type": "symptom", "settings": { "label": "Stress" } },
        { "type": "symptom", "settings": { "label": "Gluten intolerance" } },
        { "type": "symptom", "settings": { "label": "Lactose intolerance" } },
        { "type": "symptom", "settings": { "label": "Constipation or Diarrhea" } },
        { "type": "symptom", "settings": { "label": "Irritable Bowel Syndrome" } },
        { "type": "symptom", "settings": { "label": "Low defenses" } }
      ]
    }
  ]
}
{% endschema %}
