{% render 'fgp-global' %}

<section class="fgp-ct" aria-label="{{ 'fgp.aria.comparison_table' | t }}">

  <div class="fgp-ct__header">
    {% if section.settings.eyebrow != blank %}
      <p class="fgp-ct__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2 class="fgp-ct__heading">{{ section.settings.heading }}</h2>
  </div>

  <div class="fgp-ct__wrap">
    <table class="fgp-ct__table" role="table">
      <thead>
        <tr>
          <th class="fgp-ct__th fgp-ct__th--feature" scope="col">{{ section.settings.col_feature | default: 'Feature' }}</th>
          <th class="fgp-ct__th fgp-ct__th--ours" scope="col">
            {% if section.settings.our_image != blank %}
              <img src="{{ section.settings.our_image | img_url: '120x' }}" alt="{{ section.settings.col_ours }}" loading="lazy" class="fgp-ct__col-img">
            {% endif %}
            <span>{{ section.settings.col_ours | default: 'Stressbiotic' }}</span>
          </th>
          <th class="fgp-ct__th fgp-ct__th--other" scope="col">
            {% if section.settings.other_image != blank %}
              <img src="{{ section.settings.other_image | img_url: '120x' }}" alt="{{ section.settings.col_other }}" loading="lazy" class="fgp-ct__col-img">
            {% endif %}
            <span>{{ section.settings.col_other | default: 'Other Products' }}</span>
          </th>
        </tr>
      </thead>
      <tbody>
        {% for block in section.blocks %}
          <tr class="fgp-ct__row" {{ block.shopify_attributes }}>
            <td class="fgp-ct__td fgp-ct__td--feature">{{ block.settings.feature }}</td>
            <td class="fgp-ct__td fgp-ct__td--ours">
              {% if block.settings.our_value != blank %}
                <span class="fgp-ct__val fgp-ct__val--highlight">{{ block.settings.our_value }}</span>
              {% else %}
                <span class="fgp-ct__check fgp-ct__check--yes" aria-label="{{ 'fgp.shared.yes' | t }}">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="9" fill="#45bfef"/><path d="M4.5 9.5L7.5 12.5L13.5 6.5" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              {% endif %}
            </td>
            <td class="fgp-ct__td fgp-ct__td--other">
              {% if block.settings.other_value != blank %}
                <span class="fgp-ct__val">{{ block.settings.other_value }}</span>
              {% else %}
                {% if block.settings.other_has == 'yes' %}
                  <span class="fgp-ct__check fgp-ct__check--yes" aria-label="{{ 'fgp.shared.yes' | t }}">
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="9" fill="#ccc"/><path d="M4.5 9.5L7.5 12.5L13.5 6.5" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                {% else %}
                  <span class="fgp-ct__check fgp-ct__check--no" aria-label="No">
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="9" fill="#eee"/><path d="M6 6L12 12M12 6L6 12" stroke="#bbb" stroke-width="1.8" stroke-linecap="round"/></svg>
                  </span>
                {% endif %}
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

</section>

<style>
.fgp-ct {
  font-family: var(--fgp-font);
  background: var(--fgp-white);
  padding: 64px 24px;
}

.fgp-ct__header {
  text-align: center;
  margin-bottom: 40px;
}

.fgp-ct__eyebrow {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--fgp-blue);
  margin: 0 0 10px;
}

.fgp-ct__heading {
  font-size: 28px;
  font-weight: 700;
  color: var(--fgp-purple);
  margin: 0 auto;
  max-width: 600px;
  line-height: 1.3;
}

.fgp-ct__wrap {
  max-width: 860px;
  margin: 0 auto;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.fgp-ct__table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  min-width: 500px;
}

/* Header row */
.fgp-ct__th {
  padding: 16px 20px;
  font-size: 14px;
  font-weight: 700;
  text-align: center;
  vertical-align: bottom;
  border-bottom: 2px solid #e8eef6;
}

.fgp-ct__th--feature {
  text-align: left;
  color: var(--fgp-navy);
  width: 40%;
}

.fgp-ct__th--ours {
  color: var(--fgp-navy);
  background: rgba(69,191,239,0.07);
  border-radius: 12px 12px 0 0;
  border: 2px solid var(--fgp-blue);
  border-bottom: none;
}

.fgp-ct__th--other {
  color: #888;
}

.fgp-ct__col-img {
  display: block;
  width: 64px;
  height: 64px;
  object-fit: contain;
  margin: 0 auto 8px;
}

/* Body rows */
.fgp-ct__row:nth-child(even) .fgp-ct__td { background: var(--fgp-offwhite); }

.fgp-ct__td {
  padding: 14px 20px;
  font-size: 14px;
  vertical-align: middle;
  text-align: center;
  border-bottom: 1px solid #e8eef6;
  color: var(--fgp-navy);
}

.fgp-ct__td--feature {
  text-align: left;
  font-weight: 600;
}

.fgp-ct__td--ours {
  background: rgba(69,191,239,0.05);
  border-left: 2px solid var(--fgp-blue);
  border-right: 2px solid var(--fgp-blue);
}

.fgp-ct__row:last-child .fgp-ct__td--ours {
  border-bottom: 2px solid var(--fgp-blue);
  border-radius: 0 0 12px 12px;
}

.fgp-ct__val {
  font-size: 13px;
  font-weight: 500;
  color: var(--fgp-navy);
}

.fgp-ct__val--highlight {
  color: var(--fgp-navy);
  font-weight: 700;
}

.fgp-ct__check {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* Mobile */
@media (max-width: 767px) {
  .fgp-ct { padding-top: 40px; padding-bottom: 40px; }
  .fgp-ct__heading { font-size: 22px; }
  .fgp-ct__td, .fgp-ct__th { padding: 12px 12px; font-size: 12px; }
  .fgp-ct__col-img { width: 48px; height: 48px; }
}
</style>

{% schema %}
{
  "name": "FGP Comparison Table",
  "tag": "section",
  "class": "fgp-comparison-table",
  "max_blocks": 20,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SEE THE DIFFERENCE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How Stressbiotic® Compares"
    },
    {
      "type": "header",
      "content": "Column Headers"
    },
    {
      "type": "text",
      "id": "col_feature",
      "label": "Feature Column Label",
      "default": "Feature"
    },
    {
      "type": "text",
      "id": "col_ours",
      "label": "Our Product Column Label",
      "default": "Stressbiotic®"
    },
    {
      "type": "image_picker",
      "id": "our_image",
      "label": "Our Product Image"
    },
    {
      "type": "text",
      "id": "col_other",
      "label": "Other Products Column Label",
      "default": "Other Products"
    },
    {
      "type": "image_picker",
      "id": "other_image",
      "label": "Other Product Image"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison Row",
      "settings": [
        {
          "type": "text",
          "id": "feature",
          "label": "Feature Name",
          "default": "Feature"
        },
        {
          "type": "text",
          "id": "our_value",
          "label": "Our Value (leave blank for checkmark)",
          "info": "e.g. '5 Strains' — overrides checkmark if filled"
        },
        {
          "type": "text",
          "id": "other_value",
          "label": "Other Value (leave blank for check/x icon)"
        },
        {
          "type": "select",
          "id": "other_has",
          "label": "Other Product Has It? (when no Other Value)",
          "options": [
            { "value": "no", "label": "No (X)" },
            { "value": "yes", "label": "Yes (checkmark)" }
          ],
          "default": "no"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FGP Comparison Table",
      "blocks": [
        { "type": "row", "settings": { "feature": "Digestive Enzymes", "our_value": "Stressbiotic®", "other_value": "Digestive Enzymes", "other_has": "yes" } },
        { "type": "row", "settings": { "feature": "Probiotic Strains", "our_value": "5 Strains", "other_has": "no" } },
        { "type": "row", "settings": { "feature": "Prebiotics", "other_has": "no" } },
        { "type": "row", "settings": { "feature": "Postbiotics", "other_has": "no" } },
        { "type": "row", "settings": { "feature": "Adaptogen", "other_has": "no" } },
        { "type": "row", "settings": { "feature": "Patented Ingredients", "our_value": "3 Included", "other_value": "Does not include patent" } },
        { "type": "row", "settings": { "feature": "Stress + sleep actions", "our_value": "Upto-proliferating", "other_value": "Only strains to sleep" } },
        { "type": "row", "settings": { "feature": "Refrigeration required", "our_value": "No refrigeration needed", "other_value": "No refrigeration needed" } },
        { "type": "row", "settings": { "feature": "Serving / Supply", "our_value": "2caps/day, 30 days / 30 servings", "other_value": "1 to 3 capsules a day" } }
      ]
    }
  ]
}
{% endschema %}
