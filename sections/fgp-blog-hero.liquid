{% comment %}
  Feel Good Pharma — Blog Page Hero / Header
  Blue banner with heading and subtext above the blog grid
  Shopify OS 2.0 Section
{% endcomment %}

{% render 'fgp-global' %}

<section class="fgp-blhero" aria-label="Blog">
  <div class="fgp-blhero__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="fgp-blhero__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h1 class="fgp-blhero__heading">{{ section.settings.heading | default: 'Blog' }}</h1>
    {% if section.settings.subtext != blank %}
      <p class="fgp-blhero__subtext">{{ section.settings.subtext }}</p>
    {% endif %}
  </div>
</section>

<style>
.fgp-blhero {
  --fgp-navy:  #234092;
  --fgp-blue:  #45bfef;
  --fgp-white: #ffffff;
  --fgp-font:  'Poppins', sans-serif;

  font-family: var(--fgp-font);
  background: var(--fgp-blue);
  padding: 64px 24px 72px;
  text-align: center;
}

.fgp-blhero__inner {
  max-width: 680px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.fgp-blhero__eyebrow {
  font-size: 12px;
  font-weight: 700;
  color: var(--fgp-navy);
  letter-spacing: 2px;
  text-transform: uppercase;
  margin: 0;
  opacity: 0.8;
}

.fgp-blhero__heading {
  font-size: 42px;
  font-weight: 800;
  color: var(--fgp-white);
  margin: 0;
  line-height: 1.15;
}

.fgp-blhero__subtext {
  font-size: 16px;
  color: var(--fgp-white);
  opacity: 0.9;
  margin: 0;
  line-height: 1.6;
}

@media (max-width: 767px) {
  .fgp-blhero { padding: 48px 24px 56px; }
  .fgp-blhero__heading { font-size: 28px; }
  .fgp-blhero__subtext { font-size: 14px; }
}
</style>

{% schema %}
{
  "name": "FGP Blog Hero",
  "tag": "section",
  "class": "fgp-blog-hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WELLNESS TIPS & UPDATES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Blog"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Science-backed tips to help you feel good from the inside out."
    }
  ],
  "presets": [
    {
      "name": "FGP Blog Hero"
    }
  ]
}
{% endschema %}
