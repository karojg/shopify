{% comment %}
  Feel Good Pharma — Kids Probiotics Feature Section
  Desktop: 2-column card (left: text/CTA + badge, right: full product image)
  Mobile:  Stacked card (top: product image, bottom: blue panel with text/CTA)
  Shopify OS 2.0 Section
{% endcomment %}

{% render 'fgp-global' %}

<section class="fgp-kids" aria-label="Kids Probiotics Feature">

  <!-- ---- DESKTOP ---- -->
  <div class="fgp-kids__desktop">
    <div class="fgp-kids__card">

      <!-- LEFT: Product image -->
      <div class="fgp-kids__col-left">
        {% if section.settings.product_image != blank %}
          <img
            class="fgp-kids__product-img"
            src="{{ section.settings.product_image | img_url: 'master' }}"
            alt="{{ section.settings.product_image_alt | default: 'Kids Probiotics product' }}"
            loading="lazy"
          >
        {% else %}
          <div class="fgp-kids__product-img-placeholder"></div>
        {% endif %}
      </div>

      <!-- RIGHT: Text + CTA -->
      <div class="fgp-kids__col-right">
        {% if section.settings.title_image != blank %}
          <img class="fgp-kids__title-img" src="{{ section.settings.title_image | img_url: 'master' }}" alt="{{ section.settings.title | default: 'Kids Probiotics' }}" loading="lazy">
        {% else %}
          <h2 class="fgp-kids__title">{{ section.settings.title | default: 'KIDS PROBIOTICS' }}</h2>
        {% endif %}
        {% if section.settings.panel_subtitle != blank %}
          <p class="fgp-kids__panel-subtitle">{{ section.settings.panel_subtitle }}</p>
        {% endif %}
        <div class="fgp-kids__description">{{ section.settings.description | default: '<p>Formulation specially designed to <strong>support digestive health, strengthen immunity, and balance the gut microbiome</strong> of your little ones.</p>' }}</div>
        <div class="fgp-kids__cta-group">
          <a href="{{ section.settings.cta_url | default: '#' }}" class="fgp-kids__cta">
            {{ section.settings.cta_label | default: 'Shop Kids Probiotics' }}
          </a>
          {% if section.settings.cta2_label != blank %}
            <a href="{{ section.settings.cta2_url | default: '#' }}" class="fgp-kids__cta">
              {{ section.settings.cta2_label }}
            </a>
          {% endif %}
        </div>
      </div>

    </div>
  </div>

  <!-- ---- MOBILE ---- -->
  <div class="fgp-kids__mobile">
    <div class="fgp-kids__mobile-card">

      <!-- TOP: Product image -->
      <div class="fgp-kids__mobile-image-wrap">
        {% if section.settings.product_image != blank %}
          <img
            class="fgp-kids__mobile-product-img"
            src="{{ section.settings.product_image | img_url: 'master' }}"
            alt="{{ section.settings.product_image_alt | default: 'Kids Probiotics product' }}"
            loading="lazy"
          >
        {% else %}
          <div class="fgp-kids__product-img-placeholder"></div>
        {% endif %}
      </div>

      <!-- BOTTOM: Gold panel with logo, description + CTAs -->
      <div class="fgp-kids__mobile-panel">
        {% if section.settings.title_image != blank %}
          <img class="fgp-kids__title-img" src="{{ section.settings.title_image | img_url: 'master' }}" alt="{{ section.settings.title | default: 'Kids Probiotics' }}" loading="lazy">
        {% else %}
          <h2 class="fgp-kids__title">{{ section.settings.title | default: 'KIDS PROBIOTICS' }}</h2>
        {% endif %}
        {% if section.settings.panel_subtitle != blank %}
          <p class="fgp-kids__panel-subtitle">{{ section.settings.panel_subtitle }}</p>
        {% endif %}
        <div class="fgp-kids__description">{{ section.settings.description | default: '<p>Formulation designed to provide <strong>digestive and immune support and balance the gut microbiome.</strong></p>' }}</div>
        <div class="fgp-kids__cta-group">
          <a href="{{ section.settings.cta_url | default: '#' }}" class="fgp-kids__cta">
            {{ section.settings.cta_label | default: 'Shop Kids Probiotics' }}
          </a>
          {% if section.settings.cta2_label != blank %}
            <a href="{{ section.settings.cta2_url | default: '#' }}" class="fgp-kids__cta">
              {{ section.settings.cta2_label }}
            </a>
          {% endif %}
        </div>
      </div>

    </div>
  </div>

</section>

<style>
/* ===============================================================
   DESIGN TOKENS
=============================================================== */
.fgp-kids {
  --fgp-blue:     #45bfef;
  --fgp-navy:     #234092;
  --fgp-gold:     #fdb921;
  --fgp-offwhite: #f8f8f8;
  --fgp-white:    #ffffff;
  --fgp-font:     'Poppins', sans-serif;

  font-family: var(--fgp-font);
  background: var(--fgp-offwhite);
  padding-top: 40px;
  padding-bottom: 40px;
}

/* ===============================================================
   DESKTOP LAYOUT
=============================================================== */
.fgp-kids__mobile { display: none; }

.fgp-kids__desktop {
  width: 100%;
}

.fgp-kids__card {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 4px 24px rgba(0,0,0,0.07);
}

/* LEFT: Product image */
.fgp-kids__col-left {
  flex: 1;
  overflow: hidden;
}

.fgp-kids__product-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

.fgp-kids__product-img-placeholder {
  width: 100%;
  height: 100%;
  background: #dce8f5;
}

/* RIGHT: Blue text panel */
.fgp-kids__col-right {
  flex: 0 0 40%;
  background: var(--fgp-gold);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 40px 32px;
  gap: 0;
  position: relative;
}

/* Badge */
.fgp-kids__badge-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2px;
  margin-bottom: 6px;
}

.fgp-kids__badge {
  background: var(--fgp-navy);
  color: var(--fgp-white);
  font-size: 22px;
  font-weight: 800;
  border-radius: 12px;
  padding: 6px 18px;
  letter-spacing: 1px;
  line-height: 1.2;
}

.fgp-kids__badge-sub {
  font-size: 11px;
  font-weight: 600;
  color: var(--fgp-white);
  letter-spacing: 1px;
  text-transform: uppercase;
  padding-left: 4px;
  opacity: 0.85;
}

.fgp-kids__eyebrow {
  font-size: 13px;
  font-weight: 700;
  color: var(--fgp-gold);
  letter-spacing: 2px;
  text-transform: uppercase;
  margin: 0;
}

.fgp-kids__title {
  font-size: 34px;
  font-weight: 800;
  color: var(--fgp-white);
  margin: 0;
  line-height: 1.1;
  letter-spacing: 1px;
}

.fgp-kids__title-img {
  width: 100%;
  max-width: 220px;
  height: auto;
  display: block;
  margin-bottom: 20px;
}

.fgp-kids__panel-subtitle {
  font-size: 13px;
  font-weight: 700;
  color: var(--fgp-navy);
  letter-spacing: 3px;
  text-transform: uppercase;
  margin: 0 0 16px;
}

.fgp-kids__description {
  font-size: 16px;
  font-weight: 400;
  color: var(--fgp-navy);
  line-height: 1.5;
  margin: 0 0 20px;
}

.fgp-kids__description p { margin: 0; }
.fgp-kids__description strong { font-weight: 700; color: var(--fgp-navy); }

.fgp-kids__cta-group {
  display: flex;
  flex-direction: column;
  gap: 10px;
  align-items: center;
  width: 100%;
}

.fgp-kids__cta {
  display: inline-block;
  background: var(--fgp-navy);
  color: var(--fgp-white);
  font-family: var(--fgp-font);
  font-size: 16px;
  font-weight: 700;
  border-radius: 100px;
  padding: 14px 32px;
  text-decoration: none;
  text-align: center;
  transition: opacity 0.2s;
  width: 100%;
  box-sizing: border-box;
}
.fgp-kids__cta:hover { opacity: 0.85; }

/* ===============================================================
   MOBILE LAYOUT
=============================================================== */
@media (max-width: 767px) {
  .fgp-kids__desktop { display: none; }
  .fgp-kids__mobile  { display: block; }

  .fgp-kids {
    padding: 20px 20px 32px;
  }

  .fgp-kids__mobile-card {
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  }

  .fgp-kids__mobile-image-wrap {
    overflow: hidden;
    line-height: 0;
  }

  .fgp-kids__mobile-product-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    object-position: center top;
  }

  .fgp-kids__mobile-panel {
    background: #fdb921;
    padding: 32px 24px 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
  }

  .fgp-kids__mobile-panel .fgp-kids__title-img {
    max-width: 220px;
    width: 80%;
  }

  .fgp-kids__mobile-panel .fgp-kids__title {
    font-size: 28px;
    color: var(--fgp-navy);
  }

  .fgp-kids__panel-subtitle {
    font-size: 13px;
    font-weight: 600;
    color: var(--fgp-navy);
    letter-spacing: 2px;
    text-transform: uppercase;
    margin: -8px 0 0;
    opacity: 0.75;
  }

  .fgp-kids__mobile-panel .fgp-kids__description {
    font-size: 16px;
    color: var(--fgp-navy);
    line-height: 1.6;
  }

  .fgp-kids__mobile-panel .fgp-kids__description strong {
    font-weight: 700;
  }

  .fgp-kids__cta-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    align-items: center;
    margin-top: 8px;
  }

  .fgp-kids__mobile-panel .fgp-kids__cta {
    background: var(--fgp-navy);
    color: var(--fgp-white);
    font-size: 15px;
    font-weight: 700;
    padding: 14px 40px;
    border-radius: 100px;
    align-self: center;
  }
}

/* ===============================================================
   TABLET
=============================================================== */
@media (min-width: 768px) and (max-width: 1100px) {
  .fgp-kids { padding-top: 40px; padding-bottom: 40px; }
  .fgp-kids__col-right {
    flex: 0 0 38%;
    padding: 36px 28px;
  }
  .fgp-kids__title { font-size: 26px; }
}

/* ===============================================================
   DESKTOP
=============================================================== */
@media (min-width: 1101px) {
  .fgp-kids { padding-top: 56px; padding-bottom: 56px; }
  .fgp-kids__desktop { width: 100%; }
  .fgp-kids__col-right {
    flex: 0 0 40%;
    padding: 48px 40px;
  }
  .fgp-kids__title { font-size: 38px; }
  .fgp-kids__description { font-size: 16px; }
}
</style>

{% schema %}
{
  "name": "FGP Kids Feature",
  "tag": "section",
  "class": "fgp-kids-feature",
  "settings": [
    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text (e.g. 4 IN 1)",
      "default": "4 IN 1"
    },
    {
      "type": "text",
      "id": "badge_subtext",
      "label": "Badge Subtext",
      "default": "2 capsules · 3 times a day"
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "KIDS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Product Title",
      "default": "KIDS PROBIOTICS"
    },
    {
      "type": "image_picker",
      "id": "title_image",
      "label": "Title Logo Image (replaces text title when set)"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Formulation specially designed to <strong>support digestive health, strengthen immunity, and balance the gut microbiome</strong> of your little ones.</p>"
    },
    {
      "type": "header",
      "content": "CTA Buttons"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button 1 Label",
      "default": "Shop Kids 60"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button 1 URL"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Button 2 Label (optional)",
      "default": "Shop Kids 30"
    },
    {
      "type": "url",
      "id": "cta2_url",
      "label": "Button 2 URL"
    },
    {
      "type": "header",
      "content": "Product Image"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image"
    },
    {
      "type": "text",
      "id": "product_image_alt",
      "label": "Image Alt Text",
      "default": "Kids Probiotics product"
    }
  ],
  "presets": [
    {
      "name": "FGP Kids Probiotics Feature"
    }
  ]
}
{% endschema %}
