{% comment %}
  Feel Good Pharma — Kids Probiotics "Never Have to Suffer From" Section
  Desktop: heading centered + up to 5 icons in a horizontal row
  Mobile:  heading + icons stacked vertically
  Shopify OS 2.0 Section
{% endcomment %}

{% render 'fgp-global' %}

<section class="fgp-ksym" aria-label="Kids Probiotics symptoms">

  <h2 class="fgp-ksym__heading">
    {% if section.settings.heading != blank %}
      {{ section.settings.heading }}
    {% else %}
      With <strong>KIDS PROBIOTICS,</strong><br>your child will never have to suffer from:
    {% endif %}
  </h2>

  <div class="fgp-ksym__grid">
    {% for i in (1..6) %}
      {% assign icon_key  = 'icon_' | append: i %}
      {% assign label_key = 'label_' | append: i %}
      {% assign icon  = section.settings[icon_key] %}
      {% assign label = section.settings[label_key] %}
      {% if icon != blank or label != blank %}
        <div class="fgp-ksym__item">
          {% if icon != blank %}
            <img
              class="fgp-ksym__icon"
              src="{{ icon | img_url: '100x' }}"
              alt="{{ label }}"
              loading="lazy"
            >
          {% else %}
            <div class="fgp-ksym__icon fgp-ksym__icon--placeholder"></div>
          {% endif %}
          {% if label != blank %}
            <span class="fgp-ksym__label">{{ label }}</span>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>

</section>

<style>
.fgp-ksym {
  --fgp-navy:     #234092;
  --fgp-purple:   #65438a;
  --fgp-offwhite: #f8f8f8;
  --fgp-white:    #ffffff;
  --fgp-font:     'Poppins', sans-serif;

  font-family: var(--fgp-font);
  background: var(--fgp-offwhite);
  padding-top: 56px;
  padding-bottom: 64px;
  text-align: center;
}

.fgp-ksym__heading {
  font-size: 28px;
  font-weight: 600;
  color: var(--fgp-purple);
  margin: 0 auto 40px;
  line-height: 1.3;
  max-width: 700px;
}

.fgp-ksym__heading strong { font-weight: 700; }

/* Desktop: horizontal row */
.fgp-ksym__grid {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: flex-start;
  gap: 40px;
  flex-wrap: wrap;
  max-width: 1100px;
  margin: 0 auto;
}

.fgp-ksym__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  flex: 0 1 160px;
}

.fgp-ksym__icon {
  width: 90px;
  height: 90px;
  object-fit: contain;
  border-radius: 50%;
  display: block;
}

.fgp-ksym__icon--placeholder {
  width: 90px;
  height: 90px;
  border-radius: 50%;
  border: 2px solid var(--fgp-purple);
  background: transparent;
}

.fgp-ksym__label {
  font-size: 15px;
  font-weight: 600;
  color: var(--fgp-purple);
  line-height: 1.3;
  text-align: center;
}

/* Mobile: 2-col rows (icon left, label right) inside white card */
@media (max-width: 767px) {
  .fgp-ksym {
    padding-top: 40px;
    padding-bottom: 48px;
  }

  .fgp-ksym__heading {
    font-size: 22px;
    margin-bottom: 28px;
  }

  .fgp-ksym__grid {
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    background: var(--fgp-white);
    border-radius: 16px;
    padding: 8px 20px;
    box-shadow: 0 2px 16px rgba(0,0,0,0.06);
    max-width: 480px;
    margin: 0 auto;
  }

  .fgp-ksym__item {
    flex-direction: row;
    align-items: center;
    gap: 16px;
    flex: none;
    width: 100%;
    max-width: 100%;
    padding: 16px 0;
    border-bottom: 1px solid rgba(101,67,138,0.1);
    text-align: left;
  }

  .fgp-ksym__item:last-child {
    border-bottom: none;
  }

  .fgp-ksym__icon {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
  }

  .fgp-ksym__label {
    font-size: 16px;
    font-weight: 600;
    text-align: left;
  }
}

/* Tablet */
@media (min-width: 768px) and (max-width: 1100px) {
  .fgp-ksym { padding-top: 48px; padding-bottom: 56px; }
  .fgp-ksym__heading { font-size: 24px; }
  .fgp-ksym__grid { gap: 28px; }
  .fgp-ksym__item { flex: 0 1 130px; }
  .fgp-ksym__icon { width: 76px; height: 76px; }
}

/* Desktop */
@media (min-width: 1101px) {
  .fgp-ksym { padding-top: 64px; padding-bottom: 72px; }
  .fgp-ksym__heading { font-size: 32px; }
  .fgp-ksym__grid { max-width: 1300px; gap: 48px; }
  .fgp-ksym__item { flex: 0 1 180px; }
  .fgp-ksym__icon { width: 100px; height: 100px; }
  .fgp-ksym__label { font-size: 16px; }
}
</style>

