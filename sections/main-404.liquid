{% render 'fgp-global' %}

<section class="fgp-404" aria-label="Page not found">
  <div class="fgp-404__inner">
    <p class="fgp-404__code">{{ 'templates.404.subtext' | t }}</p>
    <h1 class="fgp-404__title">{{ 'templates.404.title' | t }}</h1>
    <a href="{{ routes.all_products_collection_url }}" class="fgp-404__cta">
      {{ 'general.continue_shopping' | t }}
    </a>
  </div>
</section>

<style>
.fgp-404 {
  font-family: var(--fgp-font, 'Poppins', sans-serif);
  background: linear-gradient(180deg, var(--fgp-picton-blue, #45bfef) 0%, #2a9fd4 60%, #1878b8 100%);
  width: 100%;
  min-height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
  padding: 64px 24px;
  box-sizing: border-box;
}

/* Decorative blobs — same language as the homepage hero */
.fgp-404::before,
.fgp-404::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}
.fgp-404::before {
  width: 500px;
  height: 500px;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  top: -160px;
  left: -120px;
}
.fgp-404::after {
  width: 420px;
  height: 420px;
  background: radial-gradient(circle, rgba(35,64,146,0.18) 0%, transparent 70%);
  bottom: -140px;
  right: -80px;
}

.fgp-404__inner {
  position: relative;
  z-index: 1;
  max-width: 560px;
  margin: 0 auto;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.fgp-404__code {
  font-size: clamp(72px, 14vw, 140px);
  font-weight: 800;
  color: var(--fgp-gold, #fdb921);
  line-height: 1;
  margin: 0;
  letter-spacing: 2px;
}

.fgp-404__title {
  font-size: clamp(22px, 3vw, 32px);
  font-weight: 700;
  color: #ffffff;
  margin: 0 0 12px;
  line-height: 1.3;
}

.fgp-404__cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-family: inherit;
  font-size: 15px;
  font-weight: 700;
  background: #ffffff;
  color: var(--fgp-navy, #234092);
  border-radius: 200px;
  padding: 14px 36px;
  text-decoration: none;
  white-space: nowrap;
  transition: opacity 0.2s, transform 0.15s;
}
.fgp-404__cta:hover {
  opacity: 0.88;
  transform: translateY(-1px);
}

@media (max-width: 639px) {
  .fgp-404 {
    min-height: 50vh;
    padding: 48px 20px;
  }
}
</style>
