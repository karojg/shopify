{% comment %}
  Feel Good Pharma — Featured Products Grid Section
  Desktop: 3 product cards side by side
  Mobile:  vertical stack (or 2-col scroll)
  Uses Shopify product blocks — each block picks one product.
  Shopify OS 2.0 Section
{% endcomment %}

{% render 'fgp-global' %}

{% assign source_collection = collections[section.settings.collection] %}

<section class="fgp-pgrid" aria-label="{{ 'fgp.aria.products_grid' | t }}">

  {% if section.settings.heading != blank %}
    <h2 class="fgp-pgrid__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="fgp-pgrid__grid">
    {% if source_collection != blank %}
      {% assign limit = section.settings.products_to_show | default: 3 %}
      {% for prod in source_collection.products limit: limit %}
        <div class="fgp-pgrid__card">
          <a href="{{ prod.url }}" class="fgp-pgrid__img-link">
            {%- assign pg_img = prod.featured_image -%}
            {%- if prod.metafields.custom.card_image.value != blank -%}
              {%- assign pg_img = prod.metafields.custom.card_image.value -%}
            {%- endif -%}
            {% if pg_img %}
              <img
                class="fgp-pgrid__img"
                src="{{ pg_img | image_url: width: 600 }}"
                alt="{{ pg_img.alt | default: prod.title }}"
                loading="lazy"
              >
            {% else %}
              <div class="fgp-pgrid__img-placeholder"></div>
            {% endif %}
          </a>
          <div class="fgp-pgrid__info">
            {% if prod.type != blank %}
              <p class="fgp-pgrid__eyebrow">{{ prod.type | upcase }}</p>
            {% endif %}
            <h3 class="fgp-pgrid__title">
              <a href="{{ prod.url }}">{{ prod.title }}</a>
            </h3>
            <div class="fgp-pgrid__price-row">
              <div class="fgp-pgrid__meta">
                <p class="fgp-pgrid__price">{{ prod.price | money }}</p>
                  {% if prod.metafields.custom.availability != blank %}
                    <p class="fgp-pgrid__availability">{{ prod.metafields.custom.availability }}</p>
                  {% endif %}
                  {% if prod.metafields.reviews.rating.value != blank %}
                    <div class="fgp-pgrid__stars">
                      {% assign pg_rating = prod.metafields.reviews.rating.value.rating | round %}
                      {% for i in (1..5) %}
                        {% if i <= pg_rating %}
                          <span class="fgp-pgrid__star fgp-pgrid__star--filled">★</span>
                        {% else %}
                          <span class="fgp-pgrid__star">★</span>
                        {% endif %}
                      {% endfor %}
                      <span class="fgp-pgrid__rating-val">{{ prod.metafields.reviews.rating.value.rating | round: 1 }}</span>
                    </div>
                  {% endif %}
              </div>
              <a href="{{ prod.url }}" class="fgp-pgrid__cta">
                {{ section.settings.cta_label | default: 'Shop Now' }}
              </a>
            </div>
          </div>
        </div>
      {% endfor %}
    {% else %}
      {% comment %} Fallback: manual blocks if no collection set {% endcomment %}
      {% for block in section.blocks %}
        {% assign prod = all_products[block.settings.product] %}
        {% if prod != blank %}
          <div class="fgp-pgrid__card" {{ block.shopify_attributes }}>
            <a href="{{ prod.url }}" class="fgp-pgrid__img-link">
              {%- assign pg_img = prod.featured_image -%}
              {%- if prod.metafields.custom.card_image.value != blank -%}
                {%- assign pg_img = prod.metafields.custom.card_image.value -%}
              {%- endif -%}
              {% if pg_img %}
                <img
                  class="fgp-pgrid__img"
                  src="{{ pg_img | image_url: width: 600 }}"
                  alt="{{ pg_img.alt | default: prod.title }}"
                  loading="lazy"
                >
              {% else %}
                <div class="fgp-pgrid__img-placeholder"></div>
              {% endif %}
            </a>
            <div class="fgp-pgrid__info">
              {% if block.settings.eyebrow != blank %}
                <p class="fgp-pgrid__eyebrow">{{ block.settings.eyebrow }}</p>
              {% endif %}
              <h3 class="fgp-pgrid__title">
                <a href="{{ prod.url }}">{{ prod.title }}</a>
              </h3>
              <div class="fgp-pgrid__price-row">
                <div class="fgp-pgrid__meta">
                  <p class="fgp-pgrid__price">{{ prod.price | money }}</p>
                  {% if prod.metafields.custom.availability != blank %}
                    <p class="fgp-pgrid__availability">{{ prod.metafields.custom.availability }}</p>
                  {% endif %}
                  {% if prod.metafields.reviews.rating.value != blank %}
                    <div class="fgp-pgrid__stars">
                      {% assign pg_rating = prod.metafields.reviews.rating.value.rating | round %}
                      {% for i in (1..5) %}
                        {% if i <= pg_rating %}
                          <span class="fgp-pgrid__star fgp-pgrid__star--filled">★</span>
                        {% else %}
                          <span class="fgp-pgrid__star">★</span>
                        {% endif %}
                      {% endfor %}
                      <span class="fgp-pgrid__rating-val">{{ prod.metafields.reviews.rating.value.rating | round: 1 }}</span>
                    </div>
                  {% endif %}
                </div>
                <a href="{{ prod.url }}" class="fgp-pgrid__cta">
                  {{ block.settings.cta_label | default: 'Shop Now' }}
                </a>
              </div>
            </div>
          </div>
        {% else %}
          <div class="fgp-pgrid__card fgp-pgrid__card--empty" {{ block.shopify_attributes }}>
            <div class="fgp-pgrid__img-placeholder"></div>
            <div class="fgp-pgrid__info">
              <p class="fgp-pgrid__eyebrow">{{ block.settings.eyebrow }}</p>
              <h3 class="fgp-pgrid__title">{{ block.settings.placeholder_title | default: 'Product name' }}</h3>
              <div class="fgp-pgrid__price-row">
                <p class="fgp-pgrid__price">—</p>
                <span class="fgp-pgrid__cta fgp-pgrid__cta--disabled">{{ block.settings.cta_label | default: 'Shop Now' }}</span>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}
  </div>

</section>

<style>
.fgp-pgrid {
  --fgp-navy:     #234092;
  --fgp-blue:     #45bfef;
  --fgp-gold:     #fdb921;
  --fgp-offwhite: #f8f8f8;
  --fgp-white:    #ffffff;
  --fgp-font:     'Poppins', sans-serif;

  font-family: var(--fgp-font);
  background: var(--fgp-offwhite);
  padding: 56px 24px 64px;
}

.fgp-pgrid__heading {
  font-size: 28px;
  font-weight: 700;
  color: var(--fgp-navy);
  text-align: center;
  margin: 0 auto 40px;
  max-width: 700px;
}

.fgp-pgrid__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  /* 40px gap per the Figma spec */
  gap: 40px;
  max-width: 1200px;
  margin: 0 auto;
}

/* Card */
/* No card chrome in the design — only the image is rounded */
.fgp-pgrid__card {
  background: transparent;
  border-radius: 0;
  display: flex;
  flex-direction: column;
}

.fgp-pgrid__img-link { border-radius: 12px; }

/* Image — full-bleed square, as in the design. The padded white frame here
   was compensating for packshots; lifestyle photos fill the card instead. */
.fgp-pgrid__img-link {
  display: block;
  overflow: hidden;
  line-height: 0;
  aspect-ratio: 1 / 1;
}

.fgp-pgrid__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  transition: transform 0.3s;
}

.fgp-pgrid__card:hover .fgp-pgrid__img {
  /* gentler than before — with contain the image already fills less of the
     frame, so a large scale reads as a jump */
  transform: scale(1.04);
}

.fgp-pgrid__img-placeholder {
  width: 100%;
  aspect-ratio: 1 / 1;
  background: #dce8f5;
}

/* Info */
.fgp-pgrid__info {
  padding: 16px 0 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
  flex: 1;
}

/* Neutral grey like the design's vendor line, not the gold eyebrow */
.fgp-pgrid__eyebrow {
  font-size: 11px;
  font-weight: 500;
  color: #8a8a8e;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  margin: 0;
  font-family: var(--fgp-font);
}

.fgp-pgrid__title {
  font-size: 21px;
  font-weight: 700;
  color: #33303d;
  margin: 6px 0 0;
  line-height: 1.25;
  font-family: var(--fgp-font);
}

.fgp-pgrid__title a {
  color: inherit;
  text-decoration: none;
}

.fgp-pgrid__title a:hover {
  text-decoration: underline;
}

.fgp-pgrid__price {
  font-size: 17px;
  font-weight: 400;
  color: #33303d;
  margin: 0;
  line-height: 1.3;
  font-family: var(--fgp-font);
}

.fgp-pgrid__availability {
  font-size: 13px;
  color: #6f6f74;
  margin: 2px 0 0;
  line-height: 1.3;
}

.fgp-pgrid__stars {
  display: flex;
  align-items: center;
  gap: 1px;
  margin-top: 4px;
}

.fgp-pgrid__star {
  color: #d8d8dc;
  font-size: 17px;
  line-height: 1;
}

.fgp-pgrid__star--filled { color: var(--fgp-gold, #fdb921); }

.fgp-pgrid__rating-val {
  font-size: 13px;
  color: #6f6f74;
  margin-left: 10px;
}

.fgp-pgrid__meta {
  display: flex;
  flex-direction: column;
  gap: 0;
}

/* Compact cyber-grape pill sitting on the price row, per the design */
/* 349x62 block from the design: meta left, button centred right */
.fgp-pgrid__price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 8px;
  min-height: 62px;
}

.fgp-pgrid__cta {
  display: inline-block;
  background: var(--fgp-cyber-grape, #65438a);
  color: var(--fgp-white);
  font-family: var(--fgp-font);
  font-size: 14px;
  font-weight: 600;
  border-radius: 100px;
  min-width: 100px;
  /* labels here are merchant-set and can be long ("Comprar Synbiotic+"),
     so the pill shrinks rather than pushing the price out of the row */
  padding: 11px 22px;
  flex-shrink: 1;
  max-width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
  text-decoration: none;
  text-align: center;
  transition: opacity 0.2s;
  white-space: nowrap;
}

.fgp-pgrid__cta:hover { opacity: 0.85; }

.fgp-pgrid__cta--disabled {
  opacity: 0.4;
  pointer-events: none;
  cursor: default;
}

/* Tablet */
@media (min-width: 768px) and (max-width: 1100px) {
  .fgp-pgrid { padding-top: 48px; padding-bottom: 56px; }
  .fgp-pgrid__grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .fgp-pgrid__img { height: 200px; }
  .fgp-pgrid__img-placeholder { height: 200px; }
}

/* Desktop */
@media (min-width: 1101px) {
  .fgp-pgrid { padding-top: 64px; padding-bottom: 72px; }
  .fgp-pgrid__grid { gap: 28px; }
}

/* Mobile */
@media (max-width: 767px) {
  .fgp-pgrid {
    padding: 40px 20px 48px;
  }

  .fgp-pgrid__heading { font-size: 22px; margin-bottom: 28px; }

  .fgp-pgrid__grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .fgp-pgrid__img { height: 240px; }
  .fgp-pgrid__img-placeholder { height: 240px; }
  .fgp-pgrid__title { font-size: 17px; }
}
</style>

{% schema %}
{
  "name": "FGP Products Grid",
  "tag": "section",
  "class": "fgp-products-grid",
  "max_blocks": 6,
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Select a collection to display automatically. If left empty, manual product blocks below are used."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Our Products"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "Shop Now"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow Label",
          "default": "DIGESTIVE ENZYMES"
        },
        {
          "type": "text",
          "id": "placeholder_title",
          "label": "Placeholder title (if no product selected)",
          "default": "Product name"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button Label",
          "default": "Shop Now"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FGP Products Grid",
      "blocks": [
        {
          "type": "product_card",
          "settings": {
            "eyebrow": "DIGESTIVE ENZYMES",
            "cta_label": "Shop Synbiotic+"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "eyebrow": "KIDS",
            "cta_label": "Shop Kids Probiotics"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "eyebrow": "DIGESTIVE ENZYMES",
            "cta_label": "Shop Enzymes"
          }
        }
      ]
    }
  ]
}
{% endschema %}
