{% comment %}
  Feel Good Pharma — Recommended by Doctors Section
  Card: purple photo border, name, specialty, IG handle, curly-quote text, optional arrow link
  Shopify OS 2.0 Section
{% endcomment %}

{% render 'fgp-global' %}

<section class="fgp-docs" aria-label="{{ 'fgp.aria.doctor_testimonials' | t }}">

  <div class="fgp-docs__header">
    {% if section.settings.eyebrow != blank %}
      <p class="fgp-docs__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="fgp-docs__heading">{{ section.settings.heading }}</h2>
    {% endif %}
  </div>

  <div class="fgp-docs__grid">
    {% for block in section.blocks %}
      <div class="fgp-docs__card" {{ block.shopify_attributes }}>

        <div class="fgp-docs__card-top">
          {% if block.settings.photo != blank %}
            <img
              class="fgp-docs__photo"
              src="{{ block.settings.photo | img_url: '200x200', crop: 'center' }}"
              alt="{{ block.settings.name | default: 'Doctor' }}"
              loading="lazy"
            >
          {% endif %}
          <div class="fgp-docs__card-meta">
            <p class="fgp-docs__name">{{ block.settings.name | default: 'Dr. Name' }}</p>
            {% if block.settings.specialty != blank %}
              <p class="fgp-docs__specialty">{{ block.settings.specialty }}</p>
            {% endif %}
            {% if block.settings.ig_handle != blank %}
              <a
                href="https://instagram.com/{{ block.settings.ig_handle | remove: '@' }}"
                class="fgp-docs__ig"
                target="_blank"
                rel="noopener"
              >@{{ block.settings.ig_handle | remove: '@' }}</a>
            {% endif %}
          </div>
        </div>

        {% if block.settings.quote != blank %}
          <p class="fgp-docs__quote">&ldquo;{{ block.settings.quote }}</p>
          {% if block.settings.quote_url != blank %}
            <a href="{{ block.settings.quote_url }}" class="fgp-docs__quote-arrow" target="_blank" rel="noopener" aria-label="{{ 'fgp.shared.read_more' | t }}">→</a>
          {% endif %}
        {% endif %}

      </div>
    {% endfor %}
  </div>

</section>

<style>
.fgp-docs {
  font-family: var(--fgp-font);
  background: var(--fgp-offwhite);
  padding: 56px 24px 64px;
}

/* Header */
.fgp-docs__header {
  text-align: center;
  margin-bottom: 40px;
}

.fgp-docs__eyebrow {
  font-size: 12px;
  font-weight: 700;
  color: var(--fgp-blue);
  letter-spacing: 2px;
  text-transform: uppercase;
  margin: 0 0 8px;
}

.fgp-docs__heading {
  font-size: 40px;
  font-weight: 600;
  color: var(--fgp-purple);
  margin: 0;
  line-height: 1.2;
}

/* Grid */
.fgp-docs__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  max-width: 1100px;
  margin: 0 auto;
}

/* Card */
.fgp-docs__card {
  background: var(--fgp-white);
  border-radius: 20px;
  padding: 24px;
  box-shadow: 0px 4px 3px rgba(0,0,0,0.08);
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.fgp-docs__card-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12px;
}

/* Photo — purple border, only shown when photo is uploaded */
.fgp-docs__photo {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  object-fit: cover;
  object-position: center top;
  flex-shrink: 0;
  border: 2px solid var(--fgp-purple);
}

/* Meta */
.fgp-docs__card-meta {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.fgp-docs__name {
  font-size: 18px;
  font-weight: 600;
  color: #252f35;
  margin: 0;
  line-height: 26px;
  letter-spacing: -0.36px;
}

.fgp-docs__specialty {
  font-size: 14px;
  font-weight: 400;
  color: #8e8e93;
  margin: 0;
  line-height: 26px;
  letter-spacing: -0.36px;
}

.fgp-docs__ig {
  font-size: 12px;
  color: #8e8e93;
  text-decoration: none;
  margin: 0;
  line-height: 26px;
  letter-spacing: -0.36px;
  transition: opacity 0.2s;
}
.fgp-docs__ig:hover { opacity: 0.7; text-decoration: underline; }

/* Quote */
.fgp-docs__quote {
  font-size: 16px;
  font-weight: 400;
  color: #303c43;
  line-height: 1.6;
  margin: 0;
  flex: 1;
}

/* Arrow link */
.fgp-docs__quote-arrow {
  display: inline-block;
  font-size: 16px;
  font-weight: 700;
  color: var(--fgp-purple);
  text-decoration: none;
  align-self: flex-start;
  transition: transform 0.2s;
}
.fgp-docs__quote-arrow:hover { transform: translateX(4px); }

/* Tablet */
@media (min-width: 768px) and (max-width: 1100px) {
  .fgp-docs { padding-top: 48px; padding-bottom: 56px; }
  .fgp-docs__grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
}

/* Desktop */
@media (min-width: 1101px) {
  .fgp-docs { padding-top: 64px; padding-bottom: 72px; }
  .fgp-docs__grid { gap: 28px; }
}

/* Mobile */
@media (max-width: 767px) {
  .fgp-docs { padding-top: 40px; padding-bottom: 48px; }
  .fgp-docs__heading { font-size: 26px; }
  .fgp-docs__grid { grid-template-columns: 1fr; gap: 14px; }
  .fgp-docs__name { font-size: 16px; }
  .fgp-docs__quote { font-size: 14px; line-height: 1.6; }
}
</style>

{% schema %}
{
  "name": "FGP Doctor Testimonials",
  "tag": "section",
  "class": "fgp-doctor-testimonials",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "TRUSTED BY PROFESSIONALS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recommended by Doctors"
    }
  ],
  "blocks": [
    {
      "type": "doctor",
      "name": "Doctor",
      "settings": [
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Doctor Photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Dr. Name Lastname"
        },
        {
          "type": "text",
          "id": "specialty",
          "label": "Specialty",
          "default": "Gastroenterologist"
        },
        {
          "type": "text",
          "id": "ig_handle",
          "label": "Instagram handle",
          "info": "Enter with or without @, e.g. pediatranancyconejo"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "I recommend Feel Good Pharma products to my patients because of their proven formulation and high-quality ingredients."
        },
        {
          "type": "url",
          "id": "quote_url",
          "label": "Quote link (optional \u2192)",
          "info": "Shows a purple arrow link at the bottom of the quote. Use for an IG post or full article."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FGP Doctor Testimonials",
      "blocks": [
        { "type": "doctor" },
        { "type": "doctor" },
        { "type": "doctor" }
      ]
    }
  ]
}
{% endschema %}
