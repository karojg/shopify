{% render 'fgp-global' %}

<section class="fgp-fy" aria-label="{{ 'fgp.aria.for_you' | t }}">

  <div class="fgp-fy__header">
    {% if section.settings.eyebrow != blank %}
      <p class="fgp-fy__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2 class="fgp-fy__heading">{{ section.settings.heading }}</h2>
    {% if section.settings.subtext != blank %}
      <p class="fgp-fy__subtext">{{ section.settings.subtext }}</p>
    {% endif %}
  </div>

  <div class="fgp-fy__grid">
    {% for block in section.blocks %}
      <div class="fgp-fy__card" {{ block.shopify_attributes }}>

        <div class="fgp-fy__icon-wrap">
          {% if block.settings.icon != blank %}
            <img
              class="fgp-fy__icon-img"
              src="{{ block.settings.icon | img_url: '80x' }}"
              alt="{{ block.settings.title }}"
              loading="lazy"
            >
          {% endif %}
        </div>

        {% if block.settings.for_label != blank %}
          <p class="fgp-fy__for">{{ block.settings.for_label }}</p>
        {% endif %}

        <h3 class="fgp-fy__card-title">{{ block.settings.title }}</h3>

        {% if block.settings.description != blank %}
          <p class="fgp-fy__card-desc">{{ block.settings.description }}</p>
        {% endif %}

        {% if block.settings.tags != blank %}
          <div class="fgp-fy__tags">
            {% assign tag_list = block.settings.tags | split: ',' %}
            {% for tag in tag_list %}
              <span class="fgp-fy__tag">{{ tag | strip }}</span>
            {% endfor %}
          </div>
        {% endif %}

      </div>
    {% endfor %}
  </div>

</section>

<style>
.fgp-fy {
  font-family: var(--fgp-font);
  background: var(--fgp-offwhite);
  padding: 64px 24px;
}

.fgp-fy__header {
  text-align: center;
  margin-bottom: 48px;
}

.fgp-fy__eyebrow {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--fgp-blue);
  margin: 0 0 10px;
}

.fgp-fy__heading {
  font-size: 28px;
  font-weight: 700;
  color: var(--fgp-purple);
  margin: 0 auto 12px;
  max-width: 600px;
  line-height: 1.3;
}

.fgp-fy__subtext {
  font-size: 15px;
  color: var(--fgp-navy);
  opacity: 0.7;
  margin: 0 auto;
  max-width: 560px;
  line-height: 1.6;
}

/* Grid */
.fgp-fy__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  max-width: 1100px;
  margin: 0 auto;
}

/* Card */
.fgp-fy__card {
  background: var(--fgp-white);
  border-radius: 20px;
  padding: 24px 20px 20px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6px;
  box-shadow: 0 4px 18px rgba(0,0,0,0.06);
}

/* Purple circle icon */
.fgp-fy__icon-wrap {
  width: 64px;
  height: 64px;
  border: 2px solid var(--fgp-purple);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14px;
  box-sizing: border-box;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.fgp-fy__icon-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

/* "FOR" label */
.fgp-fy__for {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--fgp-blue);
  margin: 0;
  line-height: 1;
}

.fgp-fy__card-title {
  font-size: 20px;
  font-weight: 700;
  color: var(--fgp-navy);
  margin: 0 0 4px;
  line-height: 1.25;
}

.fgp-fy__card-desc {
  font-size: 14px;
  color: #555;
  margin: 0 0 12px;
  line-height: 1.6;
  flex: 1;
}

/* Tags */
.fgp-fy__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 4px;
}

.fgp-fy__tag {
  background: #d8eefb;
  color: var(--fgp-navy);
  font-size: 12px;
  font-weight: 500;
  font-family: var(--fgp-font);
  border-radius: 100px;
  padding: 5px 12px;
  white-space: nowrap;
}

/* Tablet */
@media (min-width: 768px) and (max-width: 1100px) {
  .fgp-fy__grid {
    grid-template-columns: repeat(2, 1fr);
    max-width: 720px;
  }
}

/* Mobile */
@media (max-width: 767px) {
  .fgp-fy { padding-top: 40px; padding-bottom: 40px; }
  .fgp-fy__heading { font-size: 22px; }
  .fgp-fy__grid {
    grid-template-columns: 1fr;
    gap: 14px;
    max-width: 480px;
  }
}
</style>

{% schema %}
{
  "name": "FGP Is It For You?",
  "tag": "section",
  "class": "fgp-for-you",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FIND YOUR FIT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Is Stressbiotic® For You?"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext (optional)"
    }
  ],
  "blocks": [
    {
      "type": "persona",
      "name": "Persona Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image"
        },
        {
          "type": "text",
          "id": "for_label",
          "label": "\"For\" label",
