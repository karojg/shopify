{% render 'fgp-global' %}

{% assign v = section.settings.variant %}

<section class="fgp-hh fgp-hh--{{ v }}" aria-label="{{ 'fgp.aria.hero_banner' | t }}">

  {%- if v == 'hero_1' -%}
  <!-- ── Hero 1: Navy — product bottle + pills ── -->
  <div class="fgp-hh__inner">
    <div class="fgp-hh__content">
      {% if section.settings.h1_eyebrow != blank %}
        <p class="fgp-hh__eyebrow">{{ section.settings.h1_eyebrow }}</p>
      {% endif %}
      {% if section.settings.h1_heading != blank %}
        <h1 class="fgp-hh__heading">{{ section.settings.h1_heading }}</h1>
      {% endif %}
      {% if section.settings.h1_subtitle != blank %}
        <p class="fgp-hh__subtitle">{{ section.settings.h1_subtitle }}</p>
      {% endif %}
      {% if section.settings.h1_pills != blank %}
        <div class="fgp-hh__pills">
          {% assign pill_list = section.settings.h1_pills | split: ',' %}
          {% for pill in pill_list %}
            <span class="fgp-hh__pill">{{ pill | strip }}</span>
          {% endfor %}
        </div>
      {% endif %}
      <div class="fgp-hh__ctas">
        {% if section.settings.h1_cta1_label != blank %}
          <a href="{{ section.settings.h1_cta1_url | default: '#' }}" class="fgp-hh__cta fgp-hh__cta--blue">{{ section.settings.h1_cta1_label }}</a>
        {% endif %}
        {% if section.settings.h1_cta2_label != blank %}
          <a href="{{ section.settings.h1_cta2_url | default: '#' }}" class="fgp-hh__cta fgp-hh__cta--gold">{{ section.settings.h1_cta2_label }}</a>
        {% endif %}
      </div>
    </div>

    <div class="fgp-hh__media">
      {% if section.settings.h1_decoration != blank %}
        <img class="fgp-hh__deco" src="{{ section.settings.h1_decoration | img_url: '800x' }}" alt="" aria-hidden="true" loading="eager">
      {% endif %}
      {% if section.settings.h1_product_image != blank %}
        <img class="fgp-hh__bottle" src="{{ section.settings.h1_product_image | img_url: '600x' }}" alt="{{ section.settings.h1_heading }}" loading="eager">
      {% endif %}
      {% if section.settings.h1_badge_image != blank %}
        <img class="fgp-hh__badge" src="{{ section.settings.h1_badge_image | img_url: '300x' }}" alt="{{ 'fgp.shared.recommended_by' | t }}" loading="lazy">
      {% endif %}
    </div>
  </div>

  {%- elsif v == 'hero_2' -%}
  <!-- ── Hero 2: Blue — symptom quiz ── -->
  <div class="fgp-hh__inner">
    <div class="fgp-hh__content">
      <h1 class="fgp-hh__heading fgp-hh__heading--quiz">
        {{ section.settings.h2_heading_before | default: 'Is it a gut feeling or' }}
        <span class="fgp-hh__cycler" aria-live="polite">
          {% for block in section.blocks %}
            {% if block.type == 'symptom' %}
              <span class="fgp-hh__cycle-word{% if forloop.first %} is-active{% endif %}">{{ block.settings.label }}</span>
            {% endif %}
          {% endfor %}
        </span>?
      </h1>

      {% assign symptoms = section.blocks | where: 'type', 'symptom' %}
      {% if symptoms.size > 0 %}
        <ul class="fgp-hh__symptoms">
          {% for block in symptoms %}
            <li class="fgp-hh__symptom" {{ block.shopify_attributes }}>
              <svg class="fgp-hh__check" width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
                <circle cx="11" cy="11" r="10" stroke="#234092" stroke-width="1.5"/>
                <path d="M6.5 11.5L9.5 14.5L15.5 8" stroke="#234092" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              {{ block.settings.label }}
            </li>
          {% endfor %}
        </ul>
      {% endif %}

      {% if section.settings.h2_cta_label != blank %}
        <a href="{{ section.settings.h2_cta_url | default: '#quiz' }}" class="fgp-hh__cta fgp-hh__cta--navy">{{ section.settings.h2_cta_label }}</a>
      {% endif %}
    </div>

    <div class="fgp-hh__media fgp-hh__media--bottles">
      {% comment %}
        Product shots, not decoration — alt comes from the image's own alt text
        in the Shopify media library, so it stays editable without a code change.
      {% endcomment %}
      {% if section.settings.h2_bottle_1 != blank %}
        <img class="fgp-hh__b1" src="{{ section.settings.h2_bottle_1 | img_url: '400x' }}" alt="{{ section.settings.h2_bottle_1.alt | default: shop.name | escape }}" loading="eager">
      {% endif %}
      {% if section.settings.h2_bottle_2 != blank %}
        <img class="fgp-hh__b2" src="{{ section.settings.h2_bottle_2 | img_url: '400x' }}" alt="{{ section.settings.h2_bottle_2.alt | default: shop.name | escape }}" loading="eager">
      {% endif %}
      {% if section.settings.h2_bottle_3 != blank %}
        <img class="fgp-hh__b3" src="{{ section.settings.h2_bottle_3 | img_url: '400x' }}" alt="{{ section.settings.h2_bottle_3.alt | default: shop.name | escape }}" loading="eager">
      {% endif %}
    </div>
  </div>
  {%- endif -%}

</section>

<style>
.fgp-hh {
  font-family: var(--fgp-font);
  width: 100%;
  overflow: hidden;
}

/* ── Shared inner ── */
.fgp-hh__inner {
  display: flex;
  align-items: center;
  min-height: 520px;
  max-width: 100%;
}

.fgp-hh__content {
  flex: 0 0 50%;
  padding: 64px 48px 64px 80px;
  display: flex;
  flex-direction: column;
  gap: 20px;
  position: relative;
  z-index: 1;
}

.fgp-hh__media {
  flex: 0 0 50%;
  position: relative;
  align-self: stretch;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

/* ── Hero 1 — Navy ── */
.fgp-hh--hero_1 { background: var(--fgp-navy); }

.fgp-hh--hero_1 .fgp-hh__eyebrow {
  font-size: 16px;
  font-weight: 300;
  color: rgba(255,255,255,0.8);
  letter-spacing: 1px;
  margin: 0;
}

.fgp-hh--hero_1 .fgp-hh__heading {
  font-size: 64px;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.05;
  margin: 0;
}

.fgp-hh__subtitle {
  font-size: 22px;
  font-weight: 400;
  color: rgba(255,255,255,0.85);
  margin: 0;
}

.fgp-hh__pills {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.fgp-hh__pill {
  border: 1.5px solid #99dbfc;
  color: #99dbfc;
  border-radius: 200px;
  padding: 6px 18px;
  font-size: 13px;
  font-weight: 500;
  white-space: nowrap;
}

.fgp-hh__ctas {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 4px;
}

.fgp-hh__cta {
  display: inline-block;
  font-family: var(--fgp-font);
  font-size: 16px;
  font-weight: 600;
  letter-spacing: 0.5px;
  border-radius: var(--radius-pill);
  padding: 14px 32px;
  text-decoration: none;
  transition: opacity 0.2s;
}
.fgp-hh__cta:hover { opacity: 0.88; }

.fgp-hh__cta--blue { background: var(--fgp-blue); color: var(--fgp-navy); }
.fgp-hh__cta--gold { background: var(--fgp-gold); color: var(--fgp-navy); }
.fgp-hh__cta--navy { background: var(--fgp-navy); color: #ffffff; }

/* Hero 1 media */
.fgp-hh__deco {
  position: absolute;
  top: 0;
  right: 0;
  height: 100%;
  width: auto;
  object-fit: contain;
  object-position: right top;
  pointer-events: none;
  opacity: 0.35;
}

.fgp-hh__bottle {
  position: relative;
  z-index: 1;
  max-height: 90%;
  width: auto;
  object-fit: contain;
  object-position: bottom center;
  align-self: flex-end;
}

.fgp-hh__badge {
  position: absolute;
  bottom: 24px;
  left: 16px;
  width: 120px;
  z-index: 2;
}

/* ── Hero 2 — Blue ── */
.fgp-hh--hero_2 { background: var(--fgp-blue); }

.fgp-hh--hero_2 .fgp-hh__heading--quiz {
  font-size: 52px;
  font-weight: 600;
  color: var(--fgp-navy);
  line-height: 1.15;
  margin: 0;
}

.fgp-hh__cycler {
  display: inline-block;
  position: relative;
  color: var(--fgp-navy);
}

.fgp-hh__cycle-word {
  display: none;
  font-style: italic;
}
.fgp-hh__cycle-word.is-active { display: inline; }

.fgp-hh__symptoms {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.fgp-hh__symptom {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 26px;
  font-weight: 600;
  color: #2e2a39;
  line-height: 1.2;
}

.fgp-hh__check { flex-shrink: 0; }

/* Hero 2 bottles */
.fgp-hh__media--bottles {
  position: relative;
}

.fgp-hh__b1,
.fgp-hh__b2,
.fgp-hh__b3 {
  position: absolute;
  bottom: 0;
  width: 200px;
  height: auto;
  object-fit: contain;
  filter: drop-shadow(0 8px 24px rgba(0,0,0,0.15));
}

.fgp-hh__b1 { left: 10%; z-index: 1; transform: rotate(-6deg); }
.fgp-hh__b2 { left: 50%; transform: translateX(-50%); z-index: 3; }
.fgp-hh__b3 { right: 10%; z-index: 2; transform: rotate(6deg); }

/* ── Mobile ── */
@media (max-width: 767px) {
  .fgp-hh__inner {
    flex-direction: column;
    min-height: unset;
  }

  .fgp-hh__content {
    flex: none;
    width: 100%;
    padding: 40px 20px 32px;
    gap: 16px;
    order: 2;
  }

  .fgp-hh__media {
    flex: none;
    width: 100%;
    min-height: 260px;
    order: 1;
  }

  .fgp-hh--hero_1 .fgp-hh__heading { font-size: 36px; }
  .fgp-hh__subtitle { font-size: 16px; }
  .fgp-hh__cta { font-size: 14px; padding: 12px 24px; }

  .fgp-hh--hero_2 .fgp-hh__heading--quiz { font-size: 28px; }
  .fgp-hh__symptom { font-size: 18px; }
}

/* ── Tablet ── */
@media (min-width: 768px) and (max-width: 1100px) {
  .fgp-hh__content { padding: 48px 32px 48px 48px; }
  .fgp-hh--hero_1 .fgp-hh__heading { font-size: 48px; }
  .fgp-hh--hero_2 .fgp-hh__heading--quiz { font-size: 40px; }
  .fgp-hh__symptom { font-size: 20px; }
}
</style>

<script>
(function () {
  var words = document.querySelectorAll('.fgp-hh__cycle-word');
  if (words.length < 2) return;
  var idx = 0;
  setInterval(function () {
    words[idx].classList.remove('is-active');
    idx = (idx + 1) % words.length;
    words[idx].classList.add('is-active');
  }, 2000);
})();
</script>

{% schema %}
{
  "name": "FGP Homepage Hero",
  "tag": "section",
  "class": "fgp-homepage-hero",
  "max_blocks": 12,
  "settings": [
    {
      "type": "select",
      "id": "variant",
      "label": "Hero variant",
      "options": [
        { "value": "hero_1", "label": "Hero 1 — Navy (product + pills)" },
        { "value": "hero_2", "label": "Hero 2 — Blue (symptom quiz)" }
      ],
      "default": "hero_1"
    },
    {
      "type": "header",
      "content": "Hero 1 — Navy"
    },
    { "type": "text", "id": "h1_eyebrow", "label": "Eyebrow", "default": "Plant-based Psychobiotic" },
    { "type": "textarea", "id": "h1_heading", "label": "Heading", "default": "Your mind & gut, finally made peace." },
    { "type": "text", "id": "h1_subtitle", "label": "Subtitle", "default": "Digestive Stress Psychobiotic" },
    { "type": "text", "id": "h1_pills", "label": "Benefit pills (comma-separated)", "default": "Psychobiotic, Postbiotics, Prebiotics, Probiotics, Digestive Enzymes" },
    { "type": "text", "id": "h1_cta1_label", "label": "CTA 1 label", "default": "Learn More" },
    { "type": "url", "id": "h1_cta1_url", "label": "CTA 1 URL" },
    { "type": "text", "id": "h1_cta2_label", "label": "CTA 2 label", "default": "Shop Now" },
    { "type": "url", "id": "h1_cta2_url", "label": "CTA 2 URL" },
    { "type": "image_picker", "id": "h1_product_image", "label": "Product image" },
    { "type": "image_picker", "id": "h1_badge_image", "label": "Trust badge image" },
    { "type": "image_picker", "id": "h1_decoration", "label": "Decoration illustration" },
    {
      "type": "header",
      "content": "Hero 2 — Blue (Symptom Quiz)"
    },
    { "type": "text", "id": "h2_heading_before", "label": "Heading (before animated word)", "default": "Is it a gut feeling or" },
    { "type": "text", "id": "h2_cta_label", "label": "CTA label", "default": "Take The 1 Minute Test!" },
    { "type": "url", "id": "h2_cta_url", "label": "CTA URL" },
    { "type": "image_picker", "id": "h2_bottle_1", "label": "Bottle image 1 (left)" },
    { "type": "image_picker", "id": "h2_bottle_2", "label": "Bottle image 2 (center)" },
    { "type": "image_picker", "id": "h2_bottle_3", "label": "Bottle image 3 (right)" }
  ],
  "blocks": [
    {
      "type": "symptom",
      "name": "Symptom (Hero 2)",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Symptom label",
          "default": "Stress"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FGP Homepage Hero",
      "settings": { "variant": "hero_1" },
      "blocks": [
        { "type": "symptom", "settings": { "label": "Stress" } },
        { "type": "symptom", "settings": { "label": "Anxiety" } },
        { "type": "symptom", "settings": { "label": "Poor Sleep" } },
        { "type": "symptom", "settings": { "label": "Bloating" } },
        { "type": "symptom", "settings": { "label": "Constipation" } },
        { "type": "symptom", "settings": { "label": "Low Energy" } }
      ]
    }
  ]
}
{% endschema %}
