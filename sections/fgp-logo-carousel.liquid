{% comment %}
  Feel Good Pharma — Logo Carousel / Trust Bar
  Infinite CSS marquee with partner/press logos.
  Blocks: each block = one logo image + alt text.
  Shopify OS 2.0 Section
{% endcomment %}

{% render 'fgp-global' %}

{%- assign logo_blocks = section.blocks -%}
{%- assign logo_count = logo_blocks | size -%}

{% if logo_count > 0 %}
<section class="fgp-logos" aria-label="{{ section.settings.section_label | default: 'As seen in' }}">

  {% if section.settings.heading != blank %}
    <p class="fgp-logos__heading">{{ section.settings.heading }}</p>
  {% endif %}

  <div class="fgp-logos__track-wrap" aria-hidden="true">
    <div class="fgp-logos__track">
      <!-- First set -->
      {% for block in logo_blocks %}
        <div class="fgp-logos__item" {{ block.shopify_attributes }}>
          {% if block.settings.logo != blank %}
            <img
              src="{{ block.settings.logo | img_url: '160x60', crop: 'center' }}"
              alt="{{ block.settings.logo_alt | default: 'Partner' }}"
              class="fgp-logos__img"
              loading="lazy"
              draggable="false"
            >
          {% endif %}
        </div>
      {% endfor %}
      <!-- Duplicate set for seamless loop -->
      {% for block in logo_blocks %}
        <div class="fgp-logos__item fgp-logos__item--dupe" aria-hidden="true">
          {% if block.settings.logo != blank %}
            <img
              src="{{ block.settings.logo | img_url: '160x60', crop: 'center' }}"
              alt=""
              class="fgp-logos__img"
              loading="lazy"
              draggable="false"
            >
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>

</section>
{% endif %}

<style>
.fgp-logos {
  --fgp-offwhite: #f8f8f8;
  --fgp-navy:     #234092;
  --fgp-font:     'Poppins', sans-serif;
  --scroll-speed: {{ section.settings.speed | default: 30 }}s;

  font-family: var(--fgp-font);
  background: var(--fgp-offwhite);
  padding: {{ section.settings.padding_top | default: 32 }}px 0 {{ section.settings.padding_bottom | default: 32 }}px;
}

.fgp-logos__heading {
  text-align: center;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--fgp-navy);
  opacity: 0.4;
  margin: 0 0 20px;
}

/* Clipping wrapper — hides overflow and fades edges */
.fgp-logos__track-wrap {
  overflow: hidden;
  position: relative;
  width: 100%;
  -webkit-mask-image: linear-gradient(
    to right,
    transparent 0%,
    black 8%,
    black 92%,
    transparent 100%
  );
  mask-image: linear-gradient(
    to right,
    transparent 0%,
    black 8%,
    black 92%,
    transparent 100%
  );
}

/* The scrolling track */
.fgp-logos__track {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 72px;
  width: max-content;
  animation: fgp-marquee var(--scroll-speed) linear infinite;
}

/* Pause on hover */
.fgp-logos__track-wrap:hover .fgp-logos__track {
  animation-play-state: paused;
}

.fgp-logos__item {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fgp-logos__img {
  height: 52px;
  width: auto;
  max-width: 160px;
  object-fit: contain;
  display: block;
  /* Greyscale by default, full colour on hover */
  filter: grayscale(100%) opacity(0.6);
  transition: filter 0.3s;
}

@media (max-width: 767px) {
  .fgp-logos__img {
    height: 36px;
    max-width: 110px;
  }
}

.fgp-logos__track-wrap:hover .fgp-logos__img {
  filter: grayscale(0%) opacity(1);
}

@keyframes fgp-marquee {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

/* Reduce motion */
@media (prefers-reduced-motion: reduce) {
  .fgp-logos__track { animation: none; }
}
</style>

{% schema %}
{
  "name": "FGP Logo Carousel",
  "tag": "section",
  "class": "fgp-logo-carousel-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Label above logos (optional)",
      "info": "Example: AS SEEN IN"
    },
    {
      "type": "text",
      "id": "section_label",
      "label": "Aria label",
      "default": "As seen in"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll speed (seconds per loop)",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (px)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (px)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "logo_alt",
          "label": "Alt text",
          "default": "Partner"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FGP Logo Carousel",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
