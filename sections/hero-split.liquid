{% comment %}
  Feel Good Pharma — Responsive Hero Section
  Desktop: Full-width blue header with nav + hero content area
  Mobile:  Rounded blue card + announcement bar + logo row
  Shopify OS 2.0 Section

  CHANGES vs previous version:
  - Mobile headline font-weight: 600 → 700 (bold, matches Figma)
  - Desktop badge repositioned: now floats to the RIGHT of product images (matches Figma)
  - CTA default label updated to "Take the Test!" (matches mobile Figma)
  - Desktop CTA schema default updated to match
{% endcomment %}

{% render 'fgp-global' %}

{%- assign fgp_hero_headline     = 'fgp.hero.headline'          | t -%}
{%- assign fgp_hero_cta          = 'fgp.hero.cta_label'         | t -%}
{%- assign fgp_hero_announcement = 'fgp.hero.announcement'      | t -%}
{%- assign fgp_products_alt      = 'fgp.shared.products_alt'    | t -%}
{%- assign fgp_badge_alt         = 'fgp.hero.badge_alt'         | t -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">



<!-- ===================== HERO SECTION ===================== -->
<section class="fgp-hero" aria-label="{{ 'fgp.aria.hero' | t }}">

  <!-- ---- DESKTOP HERO ---- -->
  <div class="fgp-hero__desktop">
    <div class="fgp-hero__desktop-inner">

      <!-- COLUMN 1: Headline + Product Image -->
      <div class="fgp-hero__desktop-col-left">
        <h1 class="fgp-hero__desktop-headline">
          {{ section.settings.headline_text | default: fgp_hero_headline }}
        </h1>

        <div class="fgp-hero__desktop-products">
          {% if section.settings.product_combined_image != blank %}
            <img class="fgp-hero__product-combined-desktop" src="{{ section.settings.product_combined_image | img_url: 'master' }}" alt="{{ section.settings.product_combined_alt | default: fgp_products_alt }}" loading="lazy">
          {% endif %}

          {% if section.settings.badge_image != blank %}
            <img class="fgp-hero__badge fgp-hero__badge--desktop" src="{{ section.settings.badge_image | img_url: '160x' }}" alt="{{ section.settings.badge_alt | default: fgp_badge_alt }}" loading="lazy">
          {% endif %}
        </div>
      </div>

      <!-- COLUMN 2: Underline/Question + Symptoms + CTA -->
      <div class="fgp-hero__desktop-col-right">
        <div class="fgp-hero__desktop-title-line">
          <span class="fgp-hero__desktop-underline"></span>
          <span class="fgp-hero__question-mark">?</span>
        </div>

        <ul class="fgp-hero__symptoms fgp-hero__symptoms--desktop">
          {% for i in (1..5) %}
            {% assign key = 'symptom_' | append: i %}
            {% assign val = section.settings[key] %}
            {% if val != blank %}
              <li>{{ val }}</li>
            {% elsif section.settings.symptom_1 == blank %}
              {% case i %}
                {% when 1 %}<li>{{ 'fgp.symptoms.gluten' | t }}</li>
                {% when 2 %}<li>{{ 'fgp.symptoms.lactose' | t }}</li>
                {% when 3 %}<li>{{ 'fgp.symptoms.constipation' | t }}</li>
                {% when 4 %}<li>{{ 'fgp.symptoms.ibs' | t }}</li>
                {% when 5 %}<li>{{ 'fgp.symptoms.low_defenses' | t }}</li>
              {% endcase %}
            {% endif %}
          {% endfor %}
        </ul>

        <a href="{{ section.settings.cta_url | default: '#' }}" class="fgp-hero__cta fgp-hero__cta--desktop">
          {{ section.settings.cta_label | default: fgp_hero_cta }}
        </a>
      </div>

    </div>

    <!-- Announcement Bar (desktop) -->
    <div class="fgp-hero__announcement fgp-hero__announcement--desktop">
      <span class="fgp-hero__stars" aria-label="{{ 'fgp.shared.stars_5' | t }}">★★★★★</span>
      <span class="fgp-hero__announcement-text">{{ section.settings.announcement_text | default: fgp_hero_announcement }}</span>
    </div>
  </div>

  <!-- ---- MOBILE HERO ---- -->
  <div class="fgp-hero__mobile">

    <div class="fgp-hero__card">

      <!-- TEXT LAYER: headline + symptoms + CTA -->
      <div class="fgp-hero__content-wrapper">
        <h1 class="fgp-hero__headline">
          {{ section.settings.headline_text | default: fgp_hero_headline }}
        </h1>
        <div class="fgp-hero__blank-line-wrap">
          <span class="fgp-hero__underline-line"></span>
          <span class="fgp-hero__question-mark">?</span>
        </div>
        <ul class="fgp-hero__symptoms">
          {% for i in (1..5) %}
            {% assign key = 'symptom_' | append: i %}
            {% assign val = section.settings[key] %}
            {% if val != blank %}
              <li>{{ val }}</li>
            {% else %}
              {% case i %}
                {% when 1 %}<li>{{ 'fgp.symptoms.gluten' | t }}</li>
                {% when 2 %}<li>{{ 'fgp.symptoms.lactose' | t }}</li>
                {% when 3 %}<li>{{ 'fgp.symptoms.constipation' | t }}</li>
                {% when 4 %}<li>{{ 'fgp.symptoms.ibs' | t }}</li>
                {% when 5 %}<li>{{ 'fgp.symptoms.low_defenses' | t }}</li>
              {% endcase %}
            {% endif %}
          {% endfor %}
        </ul>
        <a href="{{ section.settings.cta_url | default: '#' }}" class="fgp-hero__cta">
          {{ section.settings.cta_label | default: fgp_hero_cta }}
        </a>
      </div>

      <!-- IMAGE LAYER: absolutely pinned to bottom, behind nothing -->
      <div class="fgp-hero__products">
        <div class="fgp-hero__products-wrapper">
          {% if section.settings.product_combined_image != blank %}
            <img class="fgp-hero__product-combined" src="{{ section.settings.product_combined_image | img_url: 'master' }}" alt="{{ section.settings.product_combined_alt | default: fgp_products_alt }}" loading="lazy">
          {% endif %}
          {% if section.settings.badge_image != blank %}
            <img class="fgp-hero__badge fgp-hero__badge--mobile" src="{{ section.settings.badge_image | img_url: '120x' }}" alt="{{ section.settings.badge_alt | default: fgp_badge_alt }}" loading="lazy">
          {% endif %}
        </div>
      </div>

    </div>

    <!-- Announcement Bar (mobile) -->
    <div class="fgp-hero__announcement fgp-hero__announcement--mobile">
      <span class="fgp-hero__stars" aria-label="{{ 'fgp.shared.stars_5' | t }}">★★★★★</span>
      <span class="fgp-hero__announcement-text">{{ section.settings.announcement_text | default: fgp_hero_announcement }}</span>
    </div>

  </div>

</section>

<style>
/* ===============================================================
   DESIGN TOKENS
=============================================================== */
:root {
  --fgp-blue:     #45bfef;
  --fgp-purple:   #65438a;
  --fgp-navy:     #234092;
  --fgp-offwhite: #f8f8f8;
  --fgp-white:    #ffffff;
  --fgp-font:     'Poppins', sans-serif;
}

/* ===============================================================
   DESKTOP HERO - BASE STYLES (1101px - 1440px)
=============================================================== */
.fgp-hero {
  font-family: var(--fgp-font);
  background-color: var(--fgp-offwhite);
}

.fgp-hero__desktop {
  background: var(--fgp-blue);
}

.fgp-hero__desktop-inner {
  max-width: 1440px;
  margin: 0 auto;
  padding: 40px 80px 0 80px;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 2px;
  min-height: 75vh;
  height: 100%
}

/* Left Column: Headline + Products */
.fgp-hero__desktop-col-left {
  flex: 1 1 50%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: space-between;
  align-self: stretch;
}

.fgp-hero__desktop-headline {
  font-size: 56px;
  font-weight: 700;
  color: var(--fgp-offwhite);
  line-height: 1.15;
  margin: 0;
  white-space: nowrap;
}

.fgp-hero__desktop-products {
  position: relative;
  width: 100%;
  max-width: 500px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  margin: 0;
  padding: 0;
}

.fgp-hero__product-combined-desktop {
  width: 100%;
  max-width: 420px;
  height: auto;
  object-fit: contain;
  display: block;
  margin: 0;
  padding: 0;
}

.fgp-hero__badge--desktop {
  position: absolute;
  right: 20%;
  top: 0%;
  width: 100px;
  height: auto;
  object-fit: contain;
}

/* Right Column: Underline + Symptoms + CTA */
.fgp-hero__desktop-col-right {
  flex: 1 1 50%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding-top: 12px;
  padding-bottom: 48px;
}

.fgp-hero__desktop-title-line {
  display: flex;
  align-items: flex-end;
  gap: 8px;
  margin-bottom: 28px;
}

.fgp-hero__desktop-underline {
  display: block;
  flex: 1;
  height: 3px;
  background: rgba(248,248,248,0.75);
  border-radius: 2px;
  margin-bottom: 10px;
  min-width: 160px;
  max-width: 260px;
}

.fgp-hero__desktop-title-line .fgp-hero__question-mark {
  font-size: 56px;
  font-weight: 700;
  color: var(--fgp-offwhite);
  line-height: 1;
}

.fgp-hero__symptoms--desktop {
  list-style: none;
  padding: 0;
  text-align: left;
  margin: 0 0 40px 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.fgp-hero__symptoms.fgp-hero__symptoms--desktop li {
  font-family: 'Poppins', sans-serif;
  font-weight: 300;
  font-size: 26px;
  line-height: 1.25;
  color: var(--fgp-offwhite);
  text-align: left;
}

.fgp-hero__cta--desktop {
  font-size: 18px;
  font-weight: 700;
  padding: 18px 40px;
  border-radius: 100px;
  background: var(--fgp-white);
  color: var(--fgp-navy);
  text-decoration: none;
  letter-spacing: 0.5px;
  transition: opacity 0.2s;
  border: none;
}
.fgp-hero__cta--desktop:hover { opacity: 0.85; }

.fgp-hero__announcement {
  background: var(--fgp-purple);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
}

.fgp-hero__announcement--desktop {
  width: 100%;
  padding: 22px 40px;
}

.fgp-hero__announcement--mobile {
  margin: 0 24px;
  border-radius: 0 0 12px 12px;
  padding: 14px 20px;
  flex-direction: column;
  text-align: center;
}

.fgp-hero__stars {
  color: #fdb921;
  font-size: 20px;
  letter-spacing: 2px;
}

.fgp-hero__announcement-text {
  font-family: var(--fgp-font);
  font-size: 18px;
  font-weight: 600;
  color: var(--fgp-white);
  letter-spacing: 0.5px;
}

.fgp-hero__announcement--mobile .fgp-hero__stars {
  font-size: 16px;
}

.fgp-hero__announcement--mobile .fgp-hero__announcement-text {
  font-size: 15px;
}

/* ===============================================================
   MOBILE HERO - BASE STYLES (hidden by default)
=============================================================== */
.fgp-hero__mobile {
  display: none;
  background: var(--fgp-offwhite);
  padding-bottom: 16px;
}

/* Card: full-width, tall, relative container */
.fgp-hero__card {
  background: var(--fgp-blue);
  border-radius: 20px 20px 0 0;
  margin: 20px 16px 0;
  overflow: hidden;
  position: relative;
  min-height: 75vh;
  box-sizing: border-box;
}

/* TEXT LAYER: top of card, full width, normal flow */
.fgp-hero__content-wrapper {
  position: relative;
  z-index: 2;
  padding: 36px 24px 0 24px;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.fgp-hero__headline {
  font-size: 24px;
  font-weight: 700;
  color: var(--fgp-white);
  line-height: 1.2;
  margin: 0 0 6px 0;
  text-align: right;
  white-space: nowrap;
}

.fgp-hero__blank-line-wrap {
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  gap: 8px;
  margin-bottom: 16px;
  width: 100%;
}

.fgp-hero__underline-line {
  display: block;
  flex: 1;
  max-width: 200px;
  height: 2px;
  background: rgba(255,255,255,0.6);
  border-radius: 2px;
}

.fgp-hero__question-mark {
  font-size: 24px;
  font-weight: 700;
  color: var(--fgp-white);
  line-height: 1;
  flex-shrink: 0;
}

.fgp-hero__symptoms {
  list-style: none;
  padding: 0;
  margin: 0 0 20px 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
}

.fgp-hero__symptoms li {
  font-size: 17px;
  font-weight: 300;
  color: var(--fgp-white);
  line-height: 1.5;
  text-align: right;
}

/* CTA: right-aligned, above image layer */
.fgp-hero__cta {
  background: var(--fgp-white);
  color: var(--fgp-navy);
  font-family: var(--fgp-font);
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 0.5px;
  border-radius: 100px;
  padding: 12px 28px;
  text-decoration: none;
  transition: opacity 0.2s;
  display: inline-block;
  position: relative;
  z-index: 3;
}
.fgp-hero__cta:hover { opacity: 0.85; }

/* IMAGE LAYER: absolute, pinned to bottom-left */
.fgp-hero__products {
  position: absolute;
  left: -20px;
  bottom: 0;
  width: 75%;
  z-index: 1;
  pointer-events: none;
}

.fgp-hero__products-wrapper {
  position: relative;
}

.fgp-hero__product-combined {
  width: 100%;
  height: auto;
  object-fit: contain;
  display: block;
}

.fgp-hero__badge--mobile {
  position: absolute;
  bottom: 60px;
  right: -40px;
  width: 70px;
  height: auto;
  object-fit: contain;
  pointer-events: auto;
}

/* Announcement bar sits flush below card */
.fgp-hero__announcement--mobile {
  margin: 0 16px;
  border-radius: 0 0 16px 16px;
  padding: 14px 20px;
}

/* ===============================================================
   RESPONSIVE BREAKPOINTS
=============================================================== */

/* --- LARGE MONITORS (1441px+) --- */
@media (min-width: 1441px) {
  .fgp-hero__desktop-headline { font-size: 68px; }
  .fgp-hero__desktop-title-line .fgp-hero__question-mark { font-size: 68px; }
  .fgp-hero__desktop-underline { min-width: 200px; max-width: 320px; }
  .fgp-hero__symptoms.fgp-hero__symptoms--desktop li {
    font-size: 32px;
    line-height: 1.3;
  }
  .fgp-hero__cta--desktop { font-size: 20px; padding: 20px 48px; }
  .fgp-hero__badge--desktop { width: 120px; }
}

/* --- TABLET (768px - 1100px) --- */
@media (max-width: 1100px) {
  .fgp-hero__desktop-inner { padding: 40px 40px 0; min-height: 420px; gap: 60px; }
  .fgp-hero__desktop-headline { font-size: 44px; }
  .fgp-hero__desktop-title-line .fgp-hero__question-mark { font-size: 44px; }
  .fgp-hero__desktop-underline { min-width: 140px; max-width: 220px; }
  .fgp-hero__symptoms.fgp-hero__symptoms--desktop li { font-size: 22px; }
  .fgp-hero__cta--desktop { font-size: 16px; padding: 16px 32px; }
  .fgp-hero__desktop-products { max-width: 400px; }
  .fgp-hero__product-combined-desktop { max-width: 350px; }
  .fgp-hero__badge--desktop { width: 85px; }
  .fgp-hero__announcement--desktop { padding: 18px 40px; }
}

/* --- SMALL TABLET (768px - 900px) --- */
@media (max-width: 900px) and (min-width: 768px) {
  .fgp-hero__desktop-inner { padding: 40px 40px 0; min-height: 380px; gap: 40px; }
  .fgp-hero__desktop-headline { font-size: 34px; }
  .fgp-hero__desktop-title-line .fgp-hero__question-mark { font-size: 34px; }
  .fgp-hero__desktop-underline { min-width: 100px; max-width: 180px; }
  .fgp-hero__symptoms.fgp-hero__symptoms--desktop li { font-size: 18px; }
  .fgp-hero__cta--desktop { font-size: 14px; padding: 14px 28px; }
  .fgp-hero__desktop-products { max-width: 350px; }
  .fgp-hero__product-combined-desktop { max-width: 300px; }
  .fgp-hero__badge--desktop { width: 75px; }
  .fgp-hero__announcement--desktop { padding: 16px 40px; }
}

/* --- MOBILE SWITCH (767px and below) --- */
@media (max-width: 767px) {
  .fgp-hero__desktop { display: none; }
  .fgp-hero__mobile { display: block; }
}

/* --- LARGER MOBILE (600px - 767px) --- */
@media (min-width: 600px) and (max-width: 767px) {
  .fgp-hero__products { width: 60%; }
  .fgp-hero__headline { font-size: 28px; }
  .fgp-hero__symptoms li { font-size: 19px; }
  .fgp-hero__badge--mobile { width: 80px; right: -50px; }
}

/* --- SMALL MOBILE (below 375px) --- */
@media (max-width: 374px) {
  .fgp-hero__headline { font-size: 20px; white-space: normal; }
  .fgp-hero__question-mark { font-size: 20px; }
  .fgp-hero__symptoms li { font-size: 15px; }
  .fgp-hero__cta { font-size: 13px; padding: 10px 20px; }
  .fgp-hero__badge--mobile { width: 56px; right: -24px; }
}
</style>

{% schema %}
{
  "name": "FGP Hero",
  "tag": "section",
  "class": "fgp-hero-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Headline"
    },
    {
      "type": "text",
      "id": "headline_text",
      "label": "Headline",
      "default": "Is it a gut feeling or"
    },
    {
      "type": "header",
      "content": "Symptoms"
    },
    { "type": "text", "id": "symptom_1", "label": "Symptom 1", "default": "Gluten intolerance" },
    { "type": "text", "id": "symptom_2", "label": "Symptom 2", "default": "Lactose intolerance" },
    { "type": "text", "id": "symptom_3", "label": "Symptom 3", "default": "Constipation or Diarrhea" },
    { "type": "text", "id": "symptom_4", "label": "Symptom 4", "default": "Irritable Bowel Syndrome" },
    { "type": "text", "id": "symptom_5", "label": "Symptom 5", "default": "Low defenses" },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "Take the Test!"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Product Images"
    },
    {
      "type": "image_picker",
      "id": "product_combined_image",
      "label": "Product Image (bottles + badge)"
    },
    {
      "type": "text",
      "id": "product_combined_alt",
      "label": "Product Image Alt Text",
      "default": "Feel Good Pharma Products"
    },
    {
      "type": "image_picker",
      "id": "badge_image",
      "label": "Trust Badge"
    },
    {
      "type": "text",
      "id": "badge_alt",
      "label": "Badge Alt Text",
      "default": "Recommended by health specialists"
    },
    {
      "type": "header",
      "content": "Announcement Bar"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "+275,000 Happy Customers"
    }
  ],
  "presets": [
    {
      "name": "FGP Hero"
    }
  ]
}
{% endschema %}
