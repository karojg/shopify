{% comment %}
  Feel Good Pharma — Team / Office Grid Section
  Desktop: heading + grid of team member cards OR a mix of image cards
  Mobile:  2-col grid, stacks to 1-col
  Shopify OS 2.0 Section
{% endcomment %}

{% render 'fgp-global' %}

<section class="fgp-team" aria-label="Our team">

  <div class="fgp-team__header">
    {% if section.settings.eyebrow != blank %}
      <p class="fgp-team__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="fgp-team__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subtext != blank %}
      <p class="fgp-team__subtext">{{ section.settings.subtext }}</p>
    {% endif %}
  </div>

  <div class="fgp-team__grid">
    {% for block in section.blocks %}
      <div class="fgp-team__card" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <div class="fgp-team__img-wrap">
            <img
              class="fgp-team__img"
              src="{{ block.settings.image | img_url: 'master' }}"
              alt="{{ block.settings.name | default: block.settings.image_alt | default: 'Team member' }}"
              loading="lazy"
            >
          </div>
        {% else %}
          <div class="fgp-team__img-wrap fgp-team__img-placeholder"></div>
        {% endif %}

        {% if block.settings.name != blank or block.settings.role != blank %}
          <div class="fgp-team__info">
            {% if block.settings.name != blank %}
              <p class="fgp-team__name">{{ block.settings.name }}</p>
            {% endif %}
            {% if block.settings.role != blank %}
              <p class="fgp-team__role">{{ block.settings.role }}</p>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>

</section>

<style>
.fgp-team {
  --fgp-navy:     #234092;
  --fgp-blue:     #45bfef;
  --fgp-offwhite: #f8f8f8;
  --fgp-white:    #ffffff;
  --fgp-font:     'Poppins', sans-serif;

  font-family: var(--fgp-font);
  background: var(--fgp-offwhite);
  padding: 56px 24px 64px;
}

.fgp-team__header {
  text-align: center;
  margin-bottom: 40px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.fgp-team__eyebrow {
  font-size: 12px;
  font-weight: 700;
  color: var(--fgp-blue);
  letter-spacing: 2px;
  text-transform: uppercase;
  margin: 0;
}

.fgp-team__heading {
  font-size: 28px;
  font-weight: 700;
  color: var(--fgp-navy);
  margin: 0;
  line-height: 1.3;
}

.fgp-team__subtext {
  font-size: 15px;
  color: var(--fgp-navy);
  opacity: 0.7;
  margin: 0 auto;
  max-width: 560px;
  line-height: 1.6;
}

/* Grid */
.fgp-team__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 24px;
  max-width: 1100px;
  margin: 0 auto;
}

/* Card */
.fgp-team__card {
  display: flex;
  flex-direction: column;
  gap: 0;
  border-radius: 16px;
  overflow: hidden;
  background: var(--fgp-white);
  box-shadow: 0 4px 20px rgba(0,0,0,0.07);
}

.fgp-team__img-wrap {
  overflow: hidden;
  line-height: 0;
}

.fgp-team__img {
  width: 100%;
  height: 280px;
  object-fit: cover;
  object-position: center top;
  display: block;
  transition: transform 0.3s;
}

.fgp-team__card:hover .fgp-team__img {
  transform: scale(1.04);
}

.fgp-team__img-placeholder {
  height: 280px;
  background: #dce8f5;
}

.fgp-team__info {
  padding: 16px 20px 20px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.fgp-team__name {
  font-size: 16px;
  font-weight: 700;
  color: var(--fgp-navy);
  margin: 0;
}

.fgp-team__role {
  font-size: 13px;
  font-weight: 400;
  color: var(--fgp-navy);
  opacity: 0.6;
  margin: 0;
}

/* Mobile */
@media (max-width: 767px) {
  .fgp-team { padding: 40px 20px 48px; }
  .fgp-team__heading { font-size: 22px; }
  .fgp-team__grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  .fgp-team__img { height: 200px; }
  .fgp-team__img-placeholder { height: 200px; }
  .fgp-team__name { font-size: 14px; }
}
</style>

{% schema %}
{
  "name": "FGP Team Grid",
  "tag": "section",
  "class": "fgp-team-grid",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "OUR TEAM"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The people behind Feel Good Pharma"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext (optional)"
    }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Team Member",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Alt Text",
          "default": "Team member"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Name Lastname"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role / Title",
          "default": "Role"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FGP Team Grid",
      "blocks": [
        {
          "type": "member",
          "settings": {
            "name": "Dr. Katherine Jiménez",
            "role": "Founder & Pharmacist"
          }
        },
        { "type": "member" },
        { "type": "member" },
        { "type": "member" }
      ]
    }
  ]
}
{% endschema %}
