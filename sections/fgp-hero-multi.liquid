{% render 'fgp-global' %}

{% assign symptom_words = '' %}
{% for block in section.blocks %}
  {% if block.type == 'symptom' %}
    {% unless forloop.first %}{% assign symptom_words = symptom_words | append: '|' %}{% endunless %}
    {% assign symptom_words = symptom_words | append: block.settings.label %}
  {% endif %}
{% endfor %}

<section class="fgp-hv2" aria-label="Hero banner">
  <div class="fgp-hv2__inner">

    <!-- Heading row: spans full width -->
    <div class="fgp-hv2__top">
      <h1 class="fgp-hv2__heading">
        <span class="fgp-hv2__heading-text">{{ section.settings.heading_before | default: 'Is it a gut feeling or' }}</span>
        <span class="fgp-hv2__blank-row">
          <span class="fgp-hv2__blank">
            <span class="fgp-hv2__cycle" data-words="{{ symptom_words }}">
              {%- for block in section.blocks -%}
                {%- if block.type == 'symptom' and forloop.first -%}{{ block.settings.label }}{%- endif -%}
              {%- endfor -%}
            </span>
          </span>
          <span class="fgp-hv2__q">?</span>
        </span>
      </h1>
    </div>

    {% assign bottle_count = 0 %}
    {% if section.settings.bottle_1 != blank %}{% assign bottle_count = bottle_count | plus: 1 %}{% endif %}
    {% if section.settings.bottle_2 != blank %}{% assign bottle_count = bottle_count | plus: 1 %}{% endif %}
    {% if section.settings.bottle_3 != blank %}{% assign bottle_count = bottle_count | plus: 1 %}{% endif %}

    <!-- Body: on desktop = row (media left, content right)
               on mobile  = column (content first, media second — via DOM order) -->
    <div class="fgp-hv2__body">

      <!-- Symptoms + CTA — first in DOM = first on mobile, right column on desktop -->
      <div class="fgp-hv2__content">
        {% if section.blocks.size > 0 %}
          <ul class="fgp-hv2__symptoms">
            {% for block in section.blocks %}
              {% if block.type == 'symptom' %}
                <li class="fgp-hv2__symptom" {{ block.shopify_attributes }}>{{ block.settings.label }}</li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}

        <div class="fgp-hv2__foot">
          {% if section.settings.badge_image != blank %}
            <img
              class="fgp-hv2__badge fgp-hv2__badge--mb"
              src="{{ section.settings.badge_image | img_url: '160x' }}"
              alt="Recommended by Health Specialists"
              loading="lazy"
              width="56" height="56">
          {% endif %}
          {% if section.settings.cta_label != blank %}
            <a href="{{ section.settings.cta_url | default: '#quiz' }}" class="fgp-hv2__cta">
              {{ section.settings.cta_label }}
            </a>
          {% endif %}
        </div>
      </div>

      <!-- Bottles — second in DOM = bottom on mobile, left column on desktop -->
      <div class="fgp-hv2__media">
        {% if section.settings.badge_image != blank %}
          <img
            class="fgp-hv2__badge fgp-hv2__badge--dk"
            src="{{ section.settings.badge_image | img_url: '200x' }}"
            alt="Recommended by Health Specialists"
            loading="lazy"
            width="88" height="88">
        {% endif %}
        <div class="fgp-hv2__bottles" data-count="{{ bottle_count }}">
          {% if section.settings.bottle_1 != blank %}
            <img class="fgp-hv2__bottle" src="{{ section.settings.bottle_1 | img_url: '600x' }}" alt="" loading="eager">
          {% endif %}
          {% if section.settings.bottle_2 != blank %}
            <img class="fgp-hv2__bottle{% if bottle_count == 3 %} fgp-hv2__bottle--center{% endif %}" src="{{ section.settings.bottle_2 | img_url: '600x' }}" alt="" loading="eager">
          {% endif %}
          {% if section.settings.bottle_3 != blank %}
            <img class="fgp-hv2__bottle" src="{{ section.settings.bottle_3 | img_url: '600x' }}" alt="" loading="eager">
          {% endif %}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
/* ═══════════════════════════════════════════
   FGP Hero Multi — clean rewrite from Figma spec
   Mobile  (≤768px): stacked, heading top-center, symptoms right, bottles bottom
   Desktop (>768px): heading centered top, bottles left 55%, content right 45%
   ═══════════════════════════════════════════ */

/* ── BASE (shared all sizes) ── */
.fgp-hv2 {
  font-family: var(--fgp-font, 'Poppins', sans-serif);
  background: linear-gradient(180deg, var(--fgp-picton-blue) 0%, #2a9fd4 60%, #1878b8 100%);
  width: 100%;
  overflow: hidden;
  position: relative;
}
/* Decorative blobs */
.fgp-hv2::before,
.fgp-hv2::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}
.fgp-hv2::before {
  width: 500px; height: 500px;
  background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 70%);
  top: -120px; left: -100px;
}
.fgp-hv2::after {
  width: 400px; height: 400px;
  background: radial-gradient(circle, rgba(35,64,146,0.12) 0%, transparent 70%);
  bottom: -80px; right: 10%;
}
.fgp-hv2__inner {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 960px;
  margin: 0 auto;
}

/* Heading */
.fgp-hv2__heading {
  margin: 0;
  color: #fff;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}
.fgp-hv2__heading-text { white-space: nowrap; }
.fgp-hv2__blank-row {
  display: inline-flex;
  align-items: baseline;
  gap: 0 6px;
}
.fgp-hv2__q { white-space: nowrap; }

/* Fixed-width blank so cycling words never shift layout */
.fgp-hv2__blank {
  position: relative;
  display: inline-block;
  /* wide enough for the longest word — set per breakpoint */
  width: 220px;
  overflow: hidden;
}
.fgp-hv2__blank::after {
  content: '';
  position: absolute;
  bottom: 2px; left: 0; right: 0;
  border-bottom: 2px solid rgba(255,255,255,0.7);
}
.fgp-hv2__cycle {
  display: block;
  color: #fff;
  font-size: inherit;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  padding: 2px 6px 6px;
  transition: opacity 0.25s ease, transform 0.25s ease;
}
.fgp-hv2__cycle.is-fading {
  opacity: 0;
  transform: translateY(-12px);
}
.fgp-hv2__cycle.is-entering {
  opacity: 0;
  transform: translateY(12px);
}

/* Body */
.fgp-hv2__body { display: flex; flex: 1; width: 100%; min-width: 0; }

/* Symptoms */
.fgp-hv2__symptoms { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; }
.fgp-hv2__symptom  { color: #fff; line-height: 1.4; }

/* CTA */
.fgp-hv2__cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-family: inherit;
  font-weight: 700;
  background: #fff;
  color: #234092;
  border-radius: 200px;
  text-decoration: none;
  white-space: nowrap;
  transition: opacity 0.2s, transform 0.15s;
}
.fgp-hv2__cta:hover { opacity: 0.88; transform: translateY(-1px); }

/* Bottles */
.fgp-hv2__bottles { display: flex; flex-direction: row; align-items: flex-end; }
.fgp-hv2__bottle  { object-fit: contain; }


/* ══════════════════════════════════════
   MOBILE — ≤ 768px
   Layout: heading | symptoms+CTA | bottles
══════════════════════════════════════ */
@media (max-width: 639px) {

  /* Heading: compact single block, flows left, matches Figma mobile spec */
  .fgp-hv2__top {
    padding: 16px 20px 0;
    padding-bottom: 2px;
  }
  .fgp-hv2__heading {
    font-size: clamp(16px, 4.4vw, 22px);
    font-weight: 700;
    line-height: 1.25;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    row-gap: 2px;
    column-gap: 6px;
  }
  .fgp-hv2__heading-text { display: inline; }
  /* Flows right after the heading text — reads as one natural sentence
     instead of leaving a gap by pinning to the far right edge */
  .fgp-hv2__blank-row {
    display: inline-flex;
    align-items: baseline;
    gap: 0 4px;
    white-space: nowrap;
  }
  .fgp-hv2__blank { width: auto; max-width: none; vertical-align: baseline; }
  .fgp-hv2__cycle {
    visibility: visible;
    font-size: 1em;
    font-weight: 400;
  }

  /* Body: column — content on top, bottles on bottom */
  .fgp-hv2__body { flex-direction: column; }

  /* Content: symptoms right-aligned, compact */
  .fgp-hv2__content {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    padding: 2px 20px 0;
    gap: 2px;
  }
  .fgp-hv2__symptoms { gap: 2px; }
  .fgp-hv2__symptom  {
    font-size: clamp(11px, 2.4vw, 14px);
    font-weight: 400;
    line-height: 1.3;
  }

  /* Footer row: badge left, CTA right — matches Figma spec */
  .fgp-hv2__foot {
    padding-top: 8px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .fgp-hv2__badge--dk { display: none; }
  .fgp-hv2__badge--mb { display: block; width: 36px; height: 36px; }
  .fgp-hv2__cta {
    font-size: 12px;
    padding: 9px 20px;
    font-weight: 700;
  }

  /* Media: bottles at bottom, top portion visible */
  .fgp-hv2__media {
    width: 100%;
    height: 220px;
    margin-top: 10px;
    overflow: hidden;
    position: relative;
    flex-shrink: 0;
  }
  .fgp-hv2__bottles {
    width: 100%;
    height: 100%;
    align-items: flex-start;
    justify-content: center;
  }
  .fgp-hv2__bottle {
    height: 300px;
    width: auto;
    flex-shrink: 0;
  }
  .fgp-hv2__bottles[data-count="1"] .fgp-hv2__bottle { flex: 0 0 130px; }
  .fgp-hv2__bottles[data-count="2"] .fgp-hv2__bottle { flex: 0 0 115px; }
  .fgp-hv2__bottles[data-count="2"] .fgp-hv2__bottle + .fgp-hv2__bottle { margin-left: -80px; }
  .fgp-hv2__bottles[data-count="3"] .fgp-hv2__bottle { flex: 0 0 105px; }
  .fgp-hv2__bottles[data-count="3"] .fgp-hv2__bottle + .fgp-hv2__bottle { margin-left: -56px; }
  .fgp-hv2__bottle--center { z-index: 1; }
}


/* ══════════════════════════════════════
   DESKTOP — > 768px
   Layout: [heading full width]
            [bottles left 55% | content right 45%]
══════════════════════════════════════ */
@media (min-width: 640px) {

  /* Section clips bottle overflow at bottom */
  .fgp-hv2 { overflow: hidden; }

  /* Both heading and body share the same max-width so the whole hero's
     proportions freeze together past ~1536px instead of the two rows
     drifting to different effective widths on very large screens. */
  .fgp-hv2__inner { max-width: 1536px; }

  .fgp-hv2__top {
    max-width: 1536px;
    width: 100%;
    margin: 0 auto;
    padding: clamp(16px, 2vw, 28px) 40px clamp(8px, 1.2vw, 20px);
    display: flex;
    justify-content: center;
    box-sizing: border-box;
  }
  .fgp-hv2__heading {
    font-size: clamp(22px, 2.6vw, 40px);
    font-weight: 700;
    flex-wrap: nowrap;
    gap: 0 clamp(6px, 0.8vw, 12px);
    line-height: 1.1;
    max-width: 100%;
  }
  .fgp-hv2__blank-row { gap: 0 clamp(4px, 0.6vw, 9px); align-items: baseline; min-width: 0; }
  .fgp-hv2__blank { width: auto; min-width: 0; overflow: hidden; }
  .fgp-hv2__cycle {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 1em;
    font-weight: 400;
    min-width: 120px;
    text-align: center;
    padding: 5px;
  }

  /* Body: row — same horizontal inset as the heading so bottles/content
     line up with the heading's left/right edges instead of the wider
     unpadded .fgp-hv2__inner box */
  .fgp-hv2__body {
    flex: 1;
    flex-direction: row;
    align-items: stretch;
    padding: 0 40px;
    box-sizing: border-box;
  }

  /* ── Left: bottles ── */
  .fgp-hv2__media {
    order: -1;
    flex: 1 1 55%;
    min-width: 0;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    padding-left: 0;
    overflow: visible;
  }

  .fgp-hv2__badge--dk { display: none; }
  .fgp-hv2__badge--mb { display: none; }

  /* Bottles: bottom-aligned, clipped 15% at bottom by .fgp-hv2 overflow:hidden */
  .fgp-hv2__bottles {
    align-items: flex-end;
    justify-content: flex-end;
    width: 100%;
    flex: 1;
    margin-bottom: -15%;
  }
  .fgp-hv2__bottle {
    width: auto;
    height: 100%;
    max-height: clamp(280px, 32vw, 480px);
    flex-shrink: 0;
  }

  .fgp-hv2__bottles[data-count="1"] .fgp-hv2__bottle { max-width: clamp(160px, 30vw, 340px); }
  .fgp-hv2__bottles[data-count="2"] .fgp-hv2__bottle { max-width: clamp(160px, 30vw, 340px); }
  .fgp-hv2__bottles[data-count="2"] .fgp-hv2__bottle + .fgp-hv2__bottle { margin-left: clamp(-90px, -14vw, -150px); }
  .fgp-hv2__bottles[data-count="3"] .fgp-hv2__bottle { max-width: clamp(110px, 19vw, 210px); }
  .fgp-hv2__bottles[data-count="3"] .fgp-hv2__bottle + .fgp-hv2__bottle { margin-left: clamp(-30px, -5vw, -48px); }
  .fgp-hv2__bottle--center {
    max-width: clamp(120px, 22vw, 240px) !important;
    transform: scale(1.08);
    transform-origin: bottom center;
    z-index: 1;
  }

  /* ── Right: symptoms + CTA ── */
  .fgp-hv2__content {
    flex: 1 1 45%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    text-align: left;
    padding: clamp(20px, 2.5vw, 38px) 20px clamp(40px, 6vw, 92px) clamp(16px, 2vw, 31px);
    gap: clamp(16px, 2vw, 31px);
  }
  .fgp-hv2__symptoms { gap: clamp(2px, 0.4vw, 6px); }
  .fgp-hv2__symptom  {
    font-size: clamp(14px, 1.8vw, 28px);
    font-weight: 400;
    white-space: normal;
    word-break: keep-all;
    line-height: 1.4;
  }
  .fgp-hv2__foot { padding-top: 0; justify-content: flex-start; }
  .fgp-hv2__cta {
    font-size: clamp(12px, 1.3vw, 20px);
    padding: clamp(10px, 1.2vw, 18px) clamp(20px, 2.5vw, 38px);
    letter-spacing: 0.3px;
    width: fit-content;
    white-space: nowrap;
  }
}
</style>

<script>
(function () {
  var target = document.querySelector('.fgp-hv2__cycle');
  var heading = document.querySelector('.fgp-hv2__heading');
  if (!target || !heading) return;
  var raw   = target.getAttribute('data-words') || '';
  var words = raw.split('|').map(function (w) { return w.trim(); }).filter(Boolean);
  if (!words.length) return;

  // Shrink the word's font-size just enough to fit on one line within
  // whatever horizontal room the heading has left, instead of wrapping
  // or clipping. Runs after each swap and on resize.
  function fitWord() {
    target.style.fontSize = '';
    var wordWidth = target.scrollWidth; // natural width at 100% size
    var otherWidth = heading.scrollWidth - wordWidth; // rest of the heading (text, "?", gaps)
    var available = heading.clientWidth - otherWidth;
    if (available <= 0 || wordWidth <= 0) return;
    var ratio = available / wordWidth;
    if (ratio < 1) {
      target.style.fontSize = (Math.max(ratio, 0.4) * 100).toFixed(1) + '%';
    }
  }

  fitWord();
  window.addEventListener('resize', fitWord);

  if (words.length < 2) return;
  var idx = 0;
  setInterval(function () {
    target.classList.add('is-fading');
    setTimeout(function () {
      idx = (idx + 1) % words.length;
      target.classList.add('is-entering');
      target.classList.remove('is-fading');
      target.textContent = words[idx];
      fitWord();
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          target.classList.remove('is-entering');
        });
      });
    }, 260);
  }, 2600);
})();
</script>

{% schema %}
{
  "name": "FGP Hero — Multi Product",
  "tag": "section",
  "class": "fgp-hero-multi",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading_before",
      "label": "Heading text (before blank)",
      "default": "Is it a gut feeling or"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA button label",
      "default": "Take The 1 Minute Test!"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA button URL"
    },
    {
      "type": "image_picker",
      "id": "badge_image",
      "label": "Trust badge image (top-left on desktop, bottom-left on mobile)"
    },
    {
      "type": "image_picker",
      "id": "bottle_1",
      "label": "Bottle image — left"
    },
    {
      "type": "image_picker",
      "id": "bottle_2",
      "label": "Bottle image — center (featured, slightly larger)"
    },
    {
      "type": "image_picker",
      "id": "bottle_3",
      "label": "Bottle image — right"
    }
  ],
  "blocks": [
    {
      "type": "symptom",
      "name": "Symptom",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Symptom label",
          "default": "Stress"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FGP Hero — Multi Product",
      "blocks": [
        { "type": "symptom", "settings": { "label": "Stress" } },
        { "type": "symptom", "settings": { "label": "Gluten intolerance" } },
        { "type": "symptom", "settings": { "label": "Lactose intolerance" } },
        { "type": "symptom", "settings": { "label": "Constipation or Diarrhea" } },
        { "type": "symptom", "settings": { "label": "Irritable Bowel Syndrome" } },
        { "type": "symptom", "settings": { "label": "Low defenses" } }
      ]
    }
  ]
}
{% endschema %}
