{% comment %}
  Feel Good Pharma — Sub-footer / Brand Banner
  Gold background: tagline + hashtag + social links (IG + FB)
  Shopify OS 2.0 Section
{% endcomment %}

{% render 'fgp-global' %}

<section class="fgp-subfooter" aria-label="Feel Good Pharma brand">

  <div class="fgp-subfooter__inner">

    <!-- LEFT: tagline + hashtag -->
    <div class="fgp-subfooter__text">
      {% if section.settings.tagline != blank %}
        <p class="fgp-subfooter__tagline">{{ section.settings.tagline }}</p>
      {% endif %}
      {% if section.settings.hashtag != blank %}
        <p class="fgp-subfooter__hashtag">{{ section.settings.hashtag }}</p>
      {% endif %}
    </div>

    <!-- RIGHT: social links -->
    <div class="fgp-subfooter__social">

      {% if section.settings.ig_handle != blank %}
        <a
          href="https://instagram.com/{{ section.settings.ig_handle | remove: '@' }}"
          class="fgp-subfooter__social-link"
          target="_blank"
          rel="noopener"
          aria-label="Follow us on Instagram"
        >
          <svg class="fgp-subfooter__social-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
          </svg>
          <span class="fgp-subfooter__social-handle">{{ section.settings.ig_handle | remove: '@' | upcase }}</span>
        </a>
      {% endif %}

      {% if section.settings.fb_url != blank %}
        <a
          href="{{ section.settings.fb_url }}"
          class="fgp-subfooter__social-link"
          target="_blank"
          rel="noopener"
          aria-label="Follow us on Facebook"
        >
          <svg class="fgp-subfooter__social-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
          </svg>
          <span class="fgp-subfooter__social-handle">{{ section.settings.fb_label | default: 'FEELGOODPHARMA' }}</span>
        </a>
      {% endif %}

    </div>

  </div>

</section>

<style>
.fgp-subfooter {
  --fgp-navy:   #234092;
  --fgp-gold:   #fdb921;
  --fgp-white:  #ffffff;
  --fgp-font:   'Poppins', sans-serif;

  font-family: var(--fgp-font);
  background: var(--fgp-gold);
  padding: 40px 48px;
}

.fgp-subfooter__inner {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
}

/* Left: text */
.fgp-subfooter__text {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.fgp-subfooter__tagline {
  font-size: 16px;
  font-weight: 400;
  font-style: normal;
  color: var(--fgp-navy);
  margin: 0;
  line-height: 1.5;
  max-width: 400px;
}

.fgp-subfooter__hashtag {
  font-size: 22px;
  font-weight: 800;
  color: var(--fgp-navy);
  margin: 0;
  line-height: 1.2;
}

/* Right: social links stacked */
.fgp-subfooter__social {
  display: flex;
  flex-direction: column;
  gap: 14px;
  flex-shrink: 0;
}

.fgp-subfooter__social-link {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  color: var(--fgp-navy);
  transition: opacity 0.2s;
}
.fgp-subfooter__social-link:hover { opacity: 0.7; }

.fgp-subfooter__social-icon {
  width: 24px;
  height: 24px;
  flex-shrink: 0;
}

.fgp-subfooter__social-handle {
  font-size: 14px;
  font-weight: 700;
  color: var(--fgp-navy);
  letter-spacing: 0.5px;
}

/* Mobile */
@media (max-width: 767px) {
  .fgp-subfooter { padding-top: 36px; padding-bottom: 36px; }

  .fgp-subfooter__inner {
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .fgp-subfooter__tagline { font-size: 15px; }
  .fgp-subfooter__hashtag { font-size: 20px; }
  .fgp-subfooter__social-handle { font-size: 13px; }
}

/* Tablet */
@media (min-width: 768px) and (max-width: 1100px) {
  .fgp-subfooter { padding-top: 40px; padding-bottom: 40px; }
  .fgp-subfooter__tagline { font-size: 15px; }
  .fgp-subfooter__hashtag { font-size: 20px; }
}
</style>

{% schema %}
{
  "name": "FGP Sub-footer",
  "tag": "section",
  "class": "fgp-subfooter-section",
  "settings": [
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Feel Good Pharma takes care of your microbiota and that of your family."
    },
    {
      "type": "text",
      "id": "hashtag",
      "label": "Hashtag",
      "default": "#FeelGoodWithin"
    },
    {
      "type": "header",
      "content": "Instagram"
    },
    {
      "type": "text",
      "id": "ig_handle",
      "label": "Instagram handle",
      "info": "Enter with or without @. Example: feel.goodpharma",
      "default": "feel.goodpharma"
    },
    {
      "type": "header",
      "content": "Facebook"
    },
    {
      "type": "url",
      "id": "fb_url",
      "label": "Facebook page URL"
    },
    {
      "type": "text",
      "id": "fb_label",
      "label": "Facebook handle label",
      "default": "FEELGOODPHARMA"
    }
  ],
  "presets": [
    {
      "name": "FGP Sub-footer",
      "settings": {
        "tagline": "Feel Good Pharma takes care of your microbiota and that of your family.",
        "hashtag": "#FeelGoodWithin",
        "ig_handle": "feel.goodpharma"
      }
    }
  ]
}
{% endschema %}
