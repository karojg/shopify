{% render 'fgp-global' %}

<section class="fgp-bb" aria-label="Benefits banner">

  <div class="fgp-bb__left">
    <div class="fgp-bb__left-content">
      {% if section.settings.eyebrow != blank %}
        <p class="fgp-bb__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="fgp-bb__heading">{{ section.settings.heading }}</h2>
      {% if section.settings.subtext != blank %}
        <p class="fgp-bb__subtext">{{ section.settings.subtext }}</p>
      {% endif %}
    </div>
    {% if section.settings.decoration != blank %}
      <img
        class="fgp-bb__decoration"
        src="{{ section.settings.decoration | img_url: '500x' }}"
        alt=""
        aria-hidden="true"
        loading="lazy"
      >
    {% endif %}
  </div>

  <div class="fgp-bb__middle">
    {% if section.blocks.size > 0 %}
      <ul class="fgp-bb__list">
        {% for block in section.blocks %}
          <li class="fgp-bb__item" {{ block.shopify_attributes }}>
            <span class="fgp-bb__icon-wrap" aria-hidden="true">
              {% if block.settings.icon != blank %}
                <img
                  class="fgp-bb__icon-img"
                  src="{{ block.settings.icon | img_url: '48x' }}"
                  alt=""
                  loading="lazy"
                >
              {% else %}
                <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
                  <circle cx="11" cy="11" r="10" stroke="white" stroke-width="1.5"/>
                  <path d="M6.5 11.5L9.5 14.5L15.5 8" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% endif %}
            </span>
            <span class="fgp-bb__label">{{ block.settings.label }}</span>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>

  <div class="fgp-bb__image-panel">
    {% if section.settings.product_image != blank %}
      <img
        class="fgp-bb__product-image"
        src="{{ section.settings.product_image | img_url: '600x' }}"
        alt="{{ section.settings.heading }}"
        loading="lazy"
      >
    {% endif %}
  </div>

</section>

<style>
.fgp-bb {
  font-family: var(--fgp-font);
  display: flex;
  width: 100%;
  min-height: 340px;
  overflow: visible;
}

/* ── Left panel — navy ── */
.fgp-bb__left {
  flex: 0 0 40%;
  background: var(--fgp-navy);
  position: relative;
  display: flex;
  align-items: center;
  overflow: hidden;
  padding: 48px 40px;
}

.fgp-bb__left-content {
  position: relative;
  z-index: 1;
  max-width: 380px;
}

.fgp-bb__decoration {
  position: absolute;
  right: -20px;
  top: 50%;
  transform: translateY(-50%);
  height: 90%;
  width: auto;
  object-fit: contain;
  opacity: 0.25;
  pointer-events: none;
}

.fgp-bb__eyebrow {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--fgp-blue);
  margin: 0 0 12px;
}

.fgp-bb__heading {
  font-size: 28px;
  font-weight: 700;
  color: var(--fgp-white);
  margin: 0 0 16px;
  line-height: 1.25;
}

.fgp-bb__subtext {
  font-size: 14px;
  color: rgba(255,255,255,0.75);
  margin: 0;
  line-height: 1.65;
}

/* ── Middle panel — light blue ── */
.fgp-bb__middle {
  flex: 1;
  background: var(--fgp-blue);
  display: flex;
  align-items: center;
  padding: 48px 40px;
}

.fgp-bb__list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 20px;
  width: 100%;
}

.fgp-bb__item {
  display: flex;
  align-items: center;
  gap: 14px;
}

.fgp-bb__icon-wrap {
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 1.5px solid rgba(255,255,255,0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.fgp-bb__icon-img {
  width: 24px;
  height: 24px;
  object-fit: contain;
  filter: brightness(0) invert(1);
}

.fgp-bb__label {
  font-size: 16px;
  font-weight: 700;
  color: var(--fgp-white);
  line-height: 1.3;
}

/* ── Right panel — light blue + bottle ── */
.fgp-bb__image-panel {
  flex: 0 0 26%;
  background: var(--fgp-blue);
  position: relative;
  overflow: visible;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.fgp-bb__product-image {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  height: 140%;
  width: auto;
  max-width: none;
  object-fit: contain;
  object-position: bottom center;
  display: block;
}

/* ── Mobile ── */
@media (max-width: 767px) {
  .fgp-bb {
    flex-direction: column;
    min-height: unset;
  }

  .fgp-bb__left {
    flex: none;
    padding: 40px 20px;
  }

  .fgp-bb__decoration { display: none; }

  .fgp-bb__heading { font-size: 22px; }

  .fgp-bb__middle {
    flex: none;
    padding: 32px 20px;
  }

  .fgp-bb__image-panel {
    flex: none;
    height: 220px;
  }

  .fgp-bb__product-image {
    height: 100%;
    width: auto;
    max-width: 200px;
  }
}

/* ── Tablet ── */
@media (min-width: 768px) and (max-width: 1100px) {
  .fgp-bb__left { flex: 0 0 38%; padding: 40px 28px; }
  .fgp-bb__heading { font-size: 24px; }
  .fgp-bb__middle { padding: 40px 28px; }
  .fgp-bb__image-panel { flex: 0 0 24%; }
}
</style>

{% schema %}
{
  "name": "FGP Benefits Banner",
  "tag": "section",
  "class": "fgp-benefits-banner",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Your journey to wellness, stress, mental health, and adaptability"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext (optional)"
    },
    {
      "type": "image_picker",
      "id": "decoration",
      "label": "Left panel decoration image (optional)",
      "info": "Subtle illustration shown on the right side of the navy panel"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image (right panel)"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon (optional — uses checkmark if blank)"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Benefit Label",
          "default": "Reduces Stress"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FGP Benefits Banner",
      "blocks": [
        { "type": "benefit", "settings": { "label": "Improves sleep" } },
        { "type": "benefit", "settings": { "label": "Reduce Stress" } },
        { "type": "benefit", "settings": { "label": "Supports Gut Health" } },
        { "type": "benefit", "settings": { "label": "Adaptogen and Psychobiotic" } },
        { "type": "benefit", "settings": { "label": "Supports IBS Patients" } }
      ]
    }
  ]
}
{% endschema %}
