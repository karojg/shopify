{% comment %}
  Feel Good Pharma — Product FAQ Section
  Desktop: heading (left) + accordion list (right) side by side, or full-width stack
  Mobile:  full-width stacked accordion
  Shopify OS 2.0 Section
{% endcomment %}

{% render 'fgp-global' %}

<section class="fgp-faq" aria-label="Frequently asked questions">

  <div class="fgp-faq__inner {% if section.settings.layout == 'split' %}fgp-faq__inner--split{% endif %}">

    <div class="fgp-faq__header">
      {% if section.settings.eyebrow != blank %}
        <p class="fgp-faq__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="fgp-faq__heading">{{ section.settings.heading | default: 'Frequently Asked Questions' }}</h2>
      {% if section.settings.subtext != blank %}
        <p class="fgp-faq__subtext">{{ section.settings.subtext }}</p>
      {% endif %}
    </div>

    <div class="fgp-faq__list">
      {% for block in section.blocks %}
        <div class="fgp-faq__item" {{ block.shopify_attributes }}>
          <button
            class="fgp-faq__question"
            aria-expanded="false"
            aria-controls="fgp-faq-answer-{{ block.id }}"
          >
            <span>{{ block.settings.question }}</span>
            <span class="fgp-faq__icon" aria-hidden="true">+</span>
          </button>
          <div
            class="fgp-faq__answer"
            id="fgp-faq-answer-{{ block.id }}"
            hidden
          >
            <div class="fgp-faq__answer-inner">
              {{ block.settings.answer }}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

  </div>

</section>

<style>
.fgp-faq {
  font-family: var(--fgp-font);
  background: var(--fgp-offwhite);
  padding: 56px 24px 64px;
}

/* Inner wrapper — default: stacked */
.fgp-faq__inner {
  max-width: 800px;
  margin: 0 auto;
}

/* Split layout: header left, list right */
.fgp-faq__inner--split {
  max-width: 1100px;
  display: grid;
  grid-template-columns: 1fr 1.6fr;
  gap: 64px;
  align-items: flex-start;
}

/* Header */
.fgp-faq__header {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 40px;
}

.fgp-faq__inner--split .fgp-faq__header {
  margin-bottom: 0;
  position: sticky;
  top: 32px;
}

.fgp-faq__eyebrow {
  font-size: 12px;
  font-weight: 700;
  color: var(--fgp-blue);
  letter-spacing: 2px;
  text-transform: uppercase;
  margin: 0;
}

.fgp-faq__heading {
  font-size: 28px;
  font-weight: 700;
  color: var(--fgp-purple);
  margin: 0;
  line-height: 1.3;
}

.fgp-faq__subtext {
  font-size: 14px;
  color: var(--fgp-navy);
  opacity: 0.7;
  margin: 0;
  line-height: 1.6;
}

/* List */
.fgp-faq__list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

/* Item */
.fgp-faq__item {
  border-bottom: 1px solid rgba(35, 64, 146, 0.15);
}

.fgp-faq__item:first-child {
  border-top: 1px solid rgba(35, 64, 146, 0.15);
}

/* Question button */
.fgp-faq__question {
  width: 100%;
  background: none;
  border: none;
  padding: 20px 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  cursor: pointer;
  font-family: var(--fgp-font);
  font-size: 16px;
  font-weight: 600;
  color: var(--fgp-navy);
  text-align: left;
  transition: color 0.2s;
}

.fgp-faq__question:hover {
  color: var(--fgp-blue);
}

.fgp-faq__question[aria-expanded="true"] {
  color: var(--fgp-blue);
}

.fgp-faq__icon {
  font-size: 22px;
  font-weight: 300;
  flex-shrink: 0;
  transition: transform 0.25s;
  color: var(--fgp-blue);
  line-height: 1;
}

.fgp-faq__question[aria-expanded="true"] .fgp-faq__icon {
  transform: rotate(45deg);
}

/* Answer */
.fgp-faq__answer {
  overflow: hidden;
}

.fgp-faq__answer[hidden] {
  display: none;
}

.fgp-faq__answer-inner {
  padding: 0 0 20px;
  font-size: 14px;
  line-height: 1.7;
  color: var(--fgp-navy);
  opacity: 0.8;
}

.fgp-faq__answer-inner p { margin: 0 0 8px; }
.fgp-faq__answer-inner p:last-child { margin-bottom: 0; }

/* Mobile */
@media (max-width: 767px) {
  .fgp-faq { padding: 40px 20px 48px; }
  .fgp-faq__inner--split {
    grid-template-columns: 1fr;
    gap: 32px;
  }
  .fgp-faq__inner--split .fgp-faq__header {
    position: static;
  }
  .fgp-faq__heading { font-size: 22px; }
  .fgp-faq__question { font-size: 15px; }
}

/* Tablet */
@media (min-width: 768px) and (max-width: 1100px) {
  .fgp-faq__inner--split { gap: 40px; }
}
</style>

<script>
(function() {
  document.querySelectorAll('.fgp-faq__question').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var expanded = this.getAttribute('aria-expanded') === 'true';
      var answerId = this.getAttribute('aria-controls');
      var answer = document.getElementById(answerId);

      this.setAttribute('aria-expanded', !expanded);
      if (expanded) {
        answer.setAttribute('hidden', '');
      } else {
        answer.removeAttribute('hidden');
      }
    });
  });
})();
</script>

{% schema %}
{
  "name": "FGP Product FAQ",
  "tag": "section",
  "class": "fgp-product-faq",
  "max_blocks": 12,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "stacked", "label": "Stacked (heading above accordion)" },
        { "value": "split", "label": "Split (heading left, accordion right)" }
      ],
      "default": "stacked"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "GOT QUESTIONS?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext (optional)"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How do I take this product?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Take 2 capsules 3 times a day with meals for best results.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FGP Product FAQ",
      "settings": {
        "layout": "stacked"
      },
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "How do I take SYNBIOTIC+?",
            "answer": "<p>Take 2 capsules 3 times a day with meals. For best results, take consistently every day.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Does it need refrigeration?",
            "answer": "<p>No refrigeration needed. Store in a cool, dry place away from direct sunlight.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "When will I start feeling results?",
            "answer": "<p>Most customers notice improvements within 2–4 weeks of consistent use, though results may vary.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Is it safe for long-term use?",
            "answer": "<p>Yes. SYNBIOTIC+ is formulated with safe, natural ingredients designed for daily, long-term use.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
