{% comment %}
  Feel Good Pharma — Loved by Customers Reviews Section
  Desktop: heading + grid of customer review cards
  Mobile:  vertical stack
  Shopify OS 2.0 Section
{% endcomment %}

{% render 'fgp-global' %}

<section class="fgp-revs" aria-label="{{ 'fgp.aria.customer_reviews' | t }}">

  <div class="fgp-revs__header">
    {% if section.settings.eyebrow != blank %}
      <p class="fgp-revs__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="fgp-revs__heading">{{ section.settings.heading }}</h2>
    {% endif %}
  </div>

  <div class="fgp-revs__grid">
    {% for block in section.blocks %}
      <div class="fgp-revs__card" {{ block.shopify_attributes }}>

        <div class="fgp-revs__card-top">
          {% assign stars = block.settings.stars | default: 5 %}
          <div class="fgp-revs__stars" aria-label="{{ stars }} out of 5 stars">
            {% for i in (1..5) %}
              {% if i <= stars %}
                <span class="fgp-revs__star fgp-revs__star--filled">★</span>
              {% else %}
                <span class="fgp-revs__star">☆</span>
              {% endif %}
            {% endfor %}
          </div>

        </div>

        {% if block.settings.review != blank %}
          <p class="fgp-revs__review">{{ block.settings.review }}</p>
        {% endif %}

        <div class="fgp-revs__customer">
          {% if block.settings.photo != blank %}
            <img
              class="fgp-revs__avatar"
              src="{{ block.settings.photo | img_url: '80x80', crop: 'center' }}"
              alt="{{ block.settings.name | default: 'Customer' }}"
              loading="lazy"
            >
          {% else %}
            <div class="fgp-revs__avatar fgp-revs__avatar--placeholder">
              {{ block.settings.name | default: 'C' | slice: 0 }}
            </div>
          {% endif %}
          <div class="fgp-revs__customer-info">
            <p class="fgp-revs__name">{{ block.settings.name | default: 'Customer' }}</p>
            {% if block.settings.location != blank %}
              <p class="fgp-revs__location">{{ block.settings.location }}</p>
            {% endif %}
          </div>
        </div>

      </div>
    {% endfor %}
  </div>

</section>

<style>
.fgp-revs {
  font-family: var(--fgp-font);
  background: var(--fgp-offwhite);
  padding: 56px 24px 64px;
}

/* Header */
.fgp-revs__header {
  text-align: center;
  margin-bottom: 40px;
}

.fgp-revs__eyebrow {
  font-size: 12px;
  font-weight: 700;
  color: var(--fgp-blue);
  letter-spacing: 2px;
  text-transform: uppercase;
  margin: 0 0 8px;
}

.fgp-revs__heading {
  font-size: 28px;
  font-weight: 700;
  color: var(--fgp-purple);
  margin: 0;
  line-height: 1.3;
}

/* Grid */
.fgp-revs__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  max-width: 1200px;
  margin: 0 auto;
}

/* Card */
.fgp-revs__card {
  background: var(--fgp-white);
  border-radius: 16px;
  padding: 24px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.07);
  display: flex;
  flex-direction: column;
  gap: 14px;
}

/* Top: stars + verified */
.fgp-revs__card-top {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.fgp-revs__stars {
  display: flex;
  gap: 2px;
}

.fgp-revs__star {
  font-size: 16px;
  color: #ddd;
  line-height: 1;
}

.fgp-revs__star--filled {
  color: var(--fgp-gold);
}

.fgp-revs__verified {
  font-size: 11px;
  font-weight: 600;
  color: var(--fgp-green);
  letter-spacing: 0.5px;
}

/* Review text */
.fgp-revs__review {
  font-size: 14px;
  font-weight: 400;
  color: var(--fgp-navy);
  line-height: 1.65;
  margin: 0;
  flex: 1;
}

/* Customer row */
.fgp-revs__customer {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: auto;
  padding-top: 12px;
  border-top: 1px solid #eee;
}

.fgp-revs__avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  object-fit: cover;
  object-position: center top;
  flex-shrink: 0;
}

.fgp-revs__avatar--placeholder {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--fgp-blue);
  color: var(--fgp-white);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  font-weight: 700;
  flex-shrink: 0;
}

.fgp-revs__customer-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.fgp-revs__name {
  font-size: 14px;
  font-weight: 700;
  color: var(--fgp-navy);
  margin: 0;
}

.fgp-revs__location {
  font-size: 12px;
  color: var(--fgp-navy);
  opacity: 0.55;
  margin: 0;
}

/* Tablet */
@media (min-width: 768px) and (max-width: 1100px) {
  .fgp-revs { padding-top: 48px; padding-bottom: 56px; }
  .fgp-revs__grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
}

/* Desktop */
@media (min-width: 1101px) {
  .fgp-revs { padding-top: 64px; padding-bottom: 72px; }
  .fgp-revs__grid { gap: 28px; }
}

/* Mobile — carousel */
@media (max-width: 767px) {
  .fgp-revs {
    padding: 40px 0 48px;
  }

  .fgp-revs__header {
    padding: 0 20px;
  }

  .fgp-revs__heading { font-size: 22px; }

  .fgp-revs__grid {
    display: flex;
    flex-direction: row;
    grid-template-columns: unset;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-left: 20px;
    -webkit-overflow-scrolling: touch;
    padding: 8px 20px 16px 20px;
    margin: 0;
    max-width: none;
    scrollbar-width: none;
  }

  .fgp-revs__grid::-webkit-scrollbar {
    display: none;
  }

  .fgp-revs__card {
    flex: 0 0 82%;
    scroll-snap-align: start;
  }

  .fgp-revs__card:last-child {
    margin-right: 20px;
  }
}
</style>

{% schema %}
{
  "name": "FGP Customer Reviews",
  "tag": "section",
  "class": "fgp-customer-reviews",
  "max_blocks": 9,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WHAT OUR CUSTOMERS SAY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by Customers"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "label": "Star Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show 'Verified Purchase' badge",
          "default": true
        },
        {
          "type": "textarea",
          "id": "review",
          "label": "Review Text",
          "default": "I've been using this product for 3 months and I feel incredible. My digestion has improved tremendously and I have more energy than ever!"
        },
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Customer Photo (optional)"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer Name",
          "default": "Maria G."
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location (optional)",
          "default": "San José, Costa Rica"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FGP Customer Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
