{% comment %}
  Feel Good Pharma — "Say Goodbye To" Symptoms Section
  Desktop: heading centered + 5 icons in a horizontal row
  Mobile:  heading + 5 icons stacked vertically
  Shopify OS 2.0 Section
{% endcomment %}

{% render 'fgp-global' %}

<section class="fgp-bye" aria-label="Say goodbye to symptoms">

  <h2 class="fgp-bye__heading">{{ section.settings.heading | default: 'With <strong>SYNBIOTIC+</strong>, say goodbye to:' }}</h2>

  <div class="fgp-bye__grid">
    {% for i in (1..5) %}
      {% assign icon_key  = 'icon_' | append: i %}
      {% assign label_key = 'label_' | append: i %}
      {% assign icon  = section.settings[icon_key] %}
      {% assign label = section.settings[label_key] %}
      {% if icon != blank or label != blank %}
        <div class="fgp-bye__item">
          {% if icon != blank %}
            <img
              class="fgp-bye__icon"
              src="{{ icon | img_url: '100x' }}"
              alt="{{ label }}"
              loading="lazy"
            >
          {% else %}
            <div class="fgp-bye__icon fgp-bye__icon--placeholder"></div>
          {% endif %}
          {% if label != blank %}
            <span class="fgp-bye__label">{{ label }}</span>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>

</section>

<style>
.fgp-bye {
  --fgp-navy:     #234092;
  --fgp-purple:   #65438a;
  --fgp-offwhite: #f8f8f8;
  --fgp-font:     'Poppins', sans-serif;

  font-family: var(--fgp-font);
  background: var(--fgp-offwhite);
  padding: 56px 24px 64px;
  text-align: center;
}

/* Heading */
.fgp-bye__heading {
  font-size: 28px;
  font-weight: 400;
  color: var(--fgp-navy);
  margin: 0 auto 48px;
  line-height: 1.3;
  max-width: 700px;
}

.fgp-bye__heading strong {
  font-weight: 800;
}

/* Desktop: horizontal row */
.fgp-bye__grid {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: flex-start;
  gap: 40px;
  flex-wrap: wrap;
  max-width: 1100px;
  margin: 0 auto;
}

.fgp-bye__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  flex: 0 1 160px;
}

.fgp-bye__icon {
  width: 90px;
  height: 90px;
  object-fit: contain;
  border-radius: 50%;
  display: block;
}

.fgp-bye__icon--placeholder {
  width: 90px;
  height: 90px;
  border-radius: 50%;
  border: 2px solid var(--fgp-purple);
  background: transparent;
}

.fgp-bye__label {
  font-size: 15px;
  font-weight: 500;
  color: var(--fgp-navy);
  line-height: 1.3;
  text-align: center;
}

/* Mobile: vertical stack */
@media (max-width: 767px) {
  .fgp-bye {
    padding: 40px 24px 48px;
  }

  .fgp-bye__heading {
    font-size: 22px;
    margin-bottom: 36px;
  }

  .fgp-bye__grid {
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }

  .fgp-bye__item {
    flex: none;
    width: 100%;
    max-width: 200px;
  }

  .fgp-bye__icon {
    width: 80px;
    height: 80px;
  }

  .fgp-bye__label {
    font-size: 14px;
  }
}

/* Tablet */
@media (min-width: 768px) and (max-width: 1100px) {
  .fgp-bye__heading { font-size: 24px; }
  .fgp-bye__grid { gap: 28px; }
  .fgp-bye__item { flex: 0 1 130px; }
  .fgp-bye__icon { width: 76px; height: 76px; }
}
</style>

