{% comment %}
  Feel Good Pharma — "Say Goodbye To" Symptoms Section
  Desktop: heading centered + 5 icons in a horizontal row
  Mobile:  heading + 5 icons stacked vertically
  Shopify OS 2.0 Section
{% endcomment %}

{% render 'fgp-global' %}

<section class="fgp-bye" aria-label="Say goodbye to symptoms">

  <h2 class="fgp-bye__heading">
    {% if section.settings.heading != blank %}
      {{ section.settings.heading }}
    {% else %}
      With <strong>SYNBIOTIC+,</strong><br>say goodbye to:
    {% endif %}
  </h2>

  <div class="fgp-bye__grid">
    {% for i in (1..5) %}
      {% assign icon_key  = 'icon_' | append: i %}
      {% assign label_key = 'label_' | append: i %}
      {% assign icon  = section.settings[icon_key] %}
      {% assign label = section.settings[label_key] %}
      {% if icon != blank or label != blank %}
        <div class="fgp-bye__item">
          {% if icon != blank %}
            <img
              class="fgp-bye__icon"
              src="{{ icon | img_url: '100x' }}"
              alt="{{ label }}"
              loading="lazy"
            >
          {% else %}
            <div class="fgp-bye__icon fgp-bye__icon--placeholder"></div>
          {% endif %}
          {% if label != blank %}
            <span class="fgp-bye__label">{{ label }}</span>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>

</section>

<style>
.fgp-bye {
  --fgp-navy:     #234092;
  --fgp-purple:   #65438a;
  --fgp-offwhite: #f8f8f8;
  --fgp-white:    #ffffff;
  --fgp-font:     'Poppins', sans-serif;

  font-family: var(--fgp-font);
  background: var(--fgp-offwhite);
  padding: 56px 24px 64px;
  text-align: center;
}

/* Heading */
.fgp-bye__heading {
  font-size: 28px;
  font-weight: 600;
  color: var(--fgp-purple);
  margin: 0 auto 48px;
  line-height: 1.3;
  max-width: 700px;
}

.fgp-bye__heading strong {
  font-weight: 700;
}

/* Desktop: horizontal row */
.fgp-bye__grid {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: flex-start;
  gap: 40px;
  flex-wrap: wrap;
  max-width: 1100px;
  margin: 0 auto;
}

.fgp-bye__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  flex: 0 1 160px;
}

.fgp-bye__icon {
  width: 90px;
  height: 90px;
  object-fit: contain;
  border-radius: 50%;
  display: block;
}

.fgp-bye__icon--placeholder {
  width: 90px;
  height: 90px;
  border-radius: 50%;
  border: 2px solid var(--fgp-purple);
  background: transparent;
}

.fgp-bye__label {
  font-size: 15px;
  font-weight: 500;
  color: var(--fgp-purple);
  line-height: 1.3;
  text-align: center;
}

/* Mobile: 2-col rows (icon left, label right) inside white card */
@media (max-width: 767px) {
  .fgp-bye {
    padding: 40px 16px 48px;
  }

  .fgp-bye__heading {
    font-size: 22px;
    margin-bottom: 28px;
  }

  .fgp-bye__grid {
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    background: var(--fgp-white);
    border-radius: 16px;
    padding: 8px 20px;
    box-shadow: 0 2px 16px rgba(0,0,0,0.06);
    max-width: 480px;
    margin: 0 auto;
  }

  .fgp-bye__item {
    flex-direction: row;
    align-items: center;
    gap: 16px;
    flex: none;
    width: 100%;
    max-width: 100%;
    padding: 16px 0;
    border-bottom: 1px solid rgba(101,67,138,0.1);
    text-align: left;
  }

  .fgp-bye__item:last-child {
    border-bottom: none;
  }

  .fgp-bye__icon {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
  }

  .fgp-bye__label {
    font-size: 16px;
    font-weight: 600;
    text-align: left;
  }
}

/* Tablet (768px–1100px) */
@media (min-width: 768px) and (max-width: 1100px) {
  .fgp-bye { padding: 48px 32px 56px; }
  .fgp-bye__heading { font-size: 24px; }
  .fgp-bye__grid { gap: 28px; }
  .fgp-bye__item { flex: 0 1 140px; }
  .fgp-bye__icon { width: 84px; height: 84px; }
  .fgp-bye__label { font-size: 14px; }
}

/* Desktop (1101px+) */
@media (min-width: 1101px) {
  .fgp-bye { padding: 64px 48px 72px; }
  .fgp-bye__heading { font-size: 32px; }
  .fgp-bye__grid { max-width: 1300px; gap: 48px; }
  .fgp-bye__item { flex: 0 1 180px; }
  .fgp-bye__icon { width: 100px; height: 100px; }
  .fgp-bye__label { font-size: 16px; }
}
</style>

